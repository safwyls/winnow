{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/library/**",
              "components/navigation/**",
              "ui_kits/desktop-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Plus Jakarta Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Plus Jakarta Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|style|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|fill)$/]",
        "message": "<Badge> variant must be one of 'outline' | 'fill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|active|disabled|icon|tooltip|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, active, disabled, icon, tooltip, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|quiet|link|secondary|ctl|aside)$/]",
        "message": "<Button> variant must be one of 'primary' | 'quiet' | 'link' | 'secondary' | 'ctl' | 'aside'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm|xs)$/]",
        "message": "<Button> size must be one of 'md' | 'sm' | 'xs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|label|count|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, label, count, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|children|key|ref|className|style|children)$/]",
        "message": "<CountPill> doesn't accept that prop. Declared props: style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CutChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|kind|kindLabel|tooltip|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<CutChip> doesn't accept that prop. Declared props: label, kind, kindLabel, tooltip, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CutChip'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:user|inherited|list)$/]",
        "message": "<CutChip> kind must be one of 'user' | 'inherited' | 'list'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DensitySlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|label|onChange|key|ref|className|style|children)$/]",
        "message": "<DensitySlider> doesn't accept that prop. Declared props: value, min, max, label, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='DockCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|onDismiss|width|style|children|key|ref|className|style|children)$/]",
        "message": "<DockCard> doesn't accept that prop. Declared props: title, meta, onDismiss, width, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|action|measure|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: message, action, measure, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|reason|cover|gradient|monthsIdle|store|unread|unreadTooltip|primaryLabel|setAsideNote|setAsideDate|onPrimary|onNotInterested|onNotNow|onUndo|style|key|ref|className|style|children)$/]",
        "message": "<FeedCard> doesn't accept that prop. Declared props: title, reason, cover, gradient, monthsIdle, store, unread, unreadTooltip, primaryLabel, setAsideNote, setAsideDate, onPrimary, onNotInterested, onNotNow, onUndo, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GameTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|cover|gradient|monthsIdle|dimming|playtime|idle|lastPlayed|stat|store|releaseYear|bucketLabel|unread|unreadTooltip|selected|primaryLabel|primaryHint|width|onPrimary|onAddToList|onOpenDetails|style|key|ref|className|style|children)$/]",
        "message": "<GameTile> doesn't accept that prop. Declared props: title, cover, gradient, monthsIdle, dimming, playtime, idle, lastPlayed, stat, store, releaseYear, bucketLabel, unread, unreadTooltip, selected, primaryLabel, primaryHint, width, onPrimary, onAddToList, onOpenDetails, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GapRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:marks|markTooltip|style|key|ref|className|style|children)$/]",
        "message": "<GapRail> doesn't accept that prop. Declared props: marks, markTooltip, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LibraryRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|store|playtime|idle|unread|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<LibraryRow> doesn't accept that prop. Declared props: title, store, playtime, idle, unread, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RailRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|kind|state|pip|dim|tooltip|onClick|style|key|ref|className|style|children)$/]",
        "message": "<RailRow> doesn't accept that prop. Declared props: label, count, kind, state, pip, dim, tooltip, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RailRow'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:bucket|list)$/]",
        "message": "<RailRow> kind must be one of 'bucket' | 'list'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RailRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|selected|rule)$/]",
        "message": "<RailRow> state must be one of 'default' | 'selected' | 'rule'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<RatingDots> doesn't accept that prop. Declared props: value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|count|blurb|pad|style|children|key|ref|className|style|children)$/]",
        "message": "<SectionPanel> doesn't accept that prop. Declared props: title, count, blurb, pad, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|options|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedToggle> doesn't accept that prop. Declared props: value, options, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SortMenu'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SortMenu> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPip'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|style|key|ref|className|style|children)$/]",
        "message": "<StatusPip> doesn't accept that prop. Declared props: state, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:waiting|running|problem)$/]",
        "message": "<StatusPip> state must be one of 'waiting' | 'running' | 'problem'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|on|width|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: value, placeholder, on, width, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='on'] > Literal[value!=/^(?:ground|surface)$/]",
        "message": "<TextField> on must be one of 'ground' | 'surface'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|markSrc|layout|maximised|style|key|ref|className|style|children)$/]",
        "message": "<TitleBar> doesn't accept that prop. Declared props: title, markSrc, layout, maximised, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBar'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:flush|floating)$/]",
        "message": "<TitleBar> layout must be one of 'flush' | 'floating'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnreadDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tooltip|style|key|ref|className|style|children)$/]",
        "message": "<UnreadDot> doesn't accept that prop. Declared props: size, tooltip, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnreadDot'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:tile|row|pip)$/]",
        "message": "<UnreadDot> size must be one of 'tile' | 'row' | 'pip'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
