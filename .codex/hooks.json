{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/backlog-guard.cjs\"",
            "commandWindows": "powershell -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) .codex/hooks/backlog-guard.cjs)\"",
            "statusMessage": "Checking the Backlog guard"
          }
        ]
      }
    ]
  }
}
