<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!-- Arrives transitively from Hoard.App -> Hoard.Auth.WebView -> the WebView2
         package, whose targets reference the unused WPF wrapper. Cosmetic: an
         MSBuild warning, not a C# one, so TreatWarningsAsErrors never promoted
         it. Silenced so a real warning stays visible. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- FakeTimeProvider, for SnapshotSchedulerService: the tick schedule is
         driven by advancing a clock, so a scheduler test costs microseconds
         instead of the intervals it is asserting about. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- View-model tests for the merge confirm queue. Hoard.App is referenced
         for its ViewModels only — no Avalonia application, dispatcher or
         rendering is started by any test. -->
    <ProjectReference Include="..\..\src\Hoard.App\Hoard.App.csproj" />
    <ProjectReference Include="..\..\src\Hoard.Core\Hoard.Core.csproj" />
    <ProjectReference Include="..\..\src\Hoard.Data\Hoard.Data.csproj" />
    <ProjectReference Include="..\..\src\Hoard.Enrich.Igdb\Hoard.Enrich.Igdb.csproj" />
    <ProjectReference Include="..\..\src\Hoard.Enrich.Steam\Hoard.Enrich.Steam.csproj" />
    <ProjectReference Include="..\..\src\Hoard.Enrich.SteamWeb\Hoard.Enrich.SteamWeb.csproj" />
    <ProjectReference Include="..\..\src\Hoard.Enrich.Updates\Hoard.Enrich.Updates.csproj" />
    <ProjectReference Include="..\..\src\Hoard.Ingest.Epic\Hoard.Ingest.Epic.csproj" />
    <ProjectReference Include="..\..\src\Hoard.Ingest.Gog\Hoard.Ingest.Gog.csproj" />
    <ProjectReference Include="..\..\src\Hoard.Ingest.Steam\Hoard.Ingest.Steam.csproj" />
    <ProjectReference Include="..\..\src\Hoard.Monitor\Hoard.Monitor.csproj" />
    <ProjectReference Include="..\..\src\Hoard.Resolve\Hoard.Resolve.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sanitized real Steam files (tests/fixtures/steam/README.md) — the reader tests parse these. -->
    <Content Include="..\fixtures\steam\**" LinkBase="fixtures\steam" CopyToOutputDirectory="PreserveNewest" />
    <!-- Verbatim store-frontend responses (tests/fixtures/steam-store/README.md) — the contract test pins these. -->
    <Content Include="..\fixtures\steam-store\**" LinkBase="fixtures\steam-store" CopyToOutputDirectory="PreserveNewest" />
    <!-- Verbatim update-signal responses (tests/fixtures/update-signals/README.md) — the contract test pins these. -->
    <Content Include="..\fixtures\update-signals\**" LinkBase="fixtures\update-signals" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sanitized GetOwnedGames capture (tests/fixtures/steam-web/README.md) — the contract test pins this. -->
    <Content Include="..\fixtures\steam-web\**" LinkBase="fixtures\steam-web" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sanitized real Epic launcher files (tests/fixtures/epic/README.md) — the reader tests parse these. -->
    <Content Include="..\fixtures\epic\**" LinkBase="fixtures\epic" CopyToOutputDirectory="PreserveNewest" />
    <!-- Canned Epic OAuth / library API responses (tests/fixtures/epic-oauth/README.md). Two of
         these are verbatim live captures; the rest follow shapes verified from source and from
         the live GraphQL schema. No test in this project opens a socket. -->
    <Content Include="..\fixtures\epic-oauth\**" LinkBase="fixtures\epic-oauth" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sanitized real GOG Galaxy files (tests/fixtures/gog/README.md) — the reader tests parse these. -->
    <Content Include="..\fixtures\gog\**" LinkBase="fixtures\gog" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
