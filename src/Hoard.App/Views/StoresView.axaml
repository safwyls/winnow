<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hoard.App.ViewModels"
             x:Class="Hoard.App.Views.StoresView"
             x:DataType="vm:StoresViewModel">

    <!--
        The Stores panel — M4.6's UI half.

        Three cards, one per source Hoard ingests, each saying what it can and
        cannot know about the user's library. That honesty is the screen. The
        Epic sign-in button is one row inside one of the cards, and it is
        deliberately not the thing the layout leads with.

        ══ Flare does not appear on this screen, in any state ══
        Not on a failed sign-in, not on "not signed in", not on the button.
        Flare marks unread updates and the bucket that counts them, and the
        badge means something for exactly as long as nothing else wears that
        colour (§2, §5.2). What the states use instead:

          Volt   a source giving Hoard everything it can
          Amber  something the user set up that has stopped working
          TextDim an optional connection nobody has made — a choice, not a fault
          Line   structure

        Danger is absent too. Signing out is reversible and costs no games, so
        dressing it as destructive would be a lie about what the button does;
        §12.3 keeps Danger for the one irreversible act in the app.
    -->

    <UserControl.Styles>

        <!-- ══ Source card ══════════════════════════════════════════════════
             Same construction as the merge queue's candidate card, for the same
             reason: the border thickness never changes between states, so
             nothing on this screen reflows when a status does. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- ══ Status pill ══════════════════════════════════════════════════
             A word, not a dot. §12.1's rule: the rail already has exactly one
             coloured mark and a second one costs the first its meaning, so
             state here is carried by the label and the colour only reinforces
             it. A reader who cannot resolve the tint reads the same fact (§8).
        -->
        <Style Selector="Border.pill">
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="Border.pill.live">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="Border.pill.live TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="Border.pill.attention">
            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
        </Style>
        <Style Selector="Border.pill.attention TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
        </Style>

        <!-- Paragraph body. 12/18 rather than the 13/18 default: three cards of
             prose is a lot of type for a screen whose neighbour is a wall of
             cover art, and TextDim keeps it as part of the room. -->
        <Style Selector="TextBlock.para">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <!-- The one paragraph per card that is a finding rather than context. -->
        <Style Selector="TextBlock.para.lead">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <!-- ══ Actions ══════════════════════════════════════════════════════
             The focus ring is a BRUSH SWAP on PART_ContentPresenter, never a
             thickness change (§10.7). Thickening a border on focus reflows the
             row it sits in, and a button that shuffles sideways as you tab onto
             it is worse than no ring at all. It is set on the presenter rather
             than on the Button because Fluent's own state styles write that
             presenter directly and a TemplateBinding loses to them on hover. -->
        <Style Selector="Button.act">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Primary: the app's one primary-action treatment, the same fill the
             Play button and "Same game" wear. -->
        <Style Selector="Button.act.primary">
            <Setter Property="Background" Value="{StaticResource Volt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <Style Selector="Button.act.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VoltHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VoltHover}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <Style Selector="Button.act.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VoltPress}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VoltPress}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <!-- On a Volt fill the ring cannot be Volt, so it is VoltInk — the
             button's own text colour, which reads as the control being armed
             rather than as a new colour arriving (§10.7). -->
        <Style Selector="Button.act.primary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource VoltInk}"/>
        </Style>

        <!-- Quiet: sign out, cancel, try again. Not a cancel and not
             destructive — the other half of a choice, reading quieter only
             because it is the one fewer people want. -->
        <Style Selector="Button.act.quiet">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Button.act.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextDim}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Button.act.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Button.act.quiet:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>

        <!-- ══ Inset fields ═════════════════════════════════════════════════
             A note the card is making about itself: an unfilled state, a
             warning, a command to run. Well is the app's inset tone (§9). -->
        <Style Selector="Border.note">
            <Setter Property="Background" Value="{StaticResource Well}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <!-- A failed attempt, and a lapsed session. Amber on the edge only —
             the text stays legible ink rather than becoming a coloured
             paragraph. -->
        <Style Selector="Border.note.attention">
            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
        </Style>
        <!-- A flow the user is in the middle of. -->
        <Style Selector="Border.note.working">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>

        <!-- The console command. Selectable because copying it is the entire
             point, and therefore a Tab stop — one of the few §10.6 says is
             worth stopping on. Focused text gets a raised field, not a ring:
             a 2px outline round a line of monospace is a box, not an
             indicator. -->
        <Style Selector="SelectableTextBlock.cmd">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="{StaticResource DataSize}"/>
            <Setter Property="FontFeatures" Value="tnum"/>
            <Setter Property="Foreground" Value="{StaticResource Azure}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="SelectableTextBlock.cmd:focus">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="{StaticResource Ground}">

        <!-- ══ Header ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Padding="24,20,24,18"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="7">
                <TextBlock Classes="display-l" Text="{Binding Title}"/>
                <TextBlock Classes="body"
                           MaxWidth="640"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           Foreground="{StaticResource TextDim}"
                           Text="{Binding IntroMessage}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <!-- 720 rather than the full pane: these cards are paragraphs, and
                 a paragraph run to 1000px beside a wall of cover art is not
                 read, it is skimmed past. Left-aligned so the column starts
                 where the header does. -->
            <StackPanel Margin="24,20,24,28"
                        MaxWidth="720"
                        HorizontalAlignment="Left"
                        Spacing="16">

                <!-- ══════════════════════════════════════════════════════════
                     STEAM
                     Local files always; the Web API key is the difference
                     between "the games this PC has touched" and "the games you
                     own". Stated as what its absence costs, because a user
                     without a key is not misconfigured — they are looking at a
                     smaller library than they have, and nothing else in the app
                     can tell them that.
                     ══════════════════════════════════════════════════════════ -->
                <Border Classes="card">
                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        Spacing="10" VerticalAlignment="Center">
                                <TextBlock Classes="display-l" FontSize="18" Text="Steam"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="data" FontSize="12"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding SteamCountText}"
                                           IsVisible="{Binding ShowSteamCount}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="TITLES"
                                           IsVisible="{Binding ShowSteamCount}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" Classes="pill"
                                    Classes.live="{Binding SteamStatusIsLive}">
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="{Binding SteamStatusLabel}"/>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="LOCAL FILES"/>
                            <TextBlock Classes="para" Text="{Binding SteamLocalMessage}"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="STEAM WEB API"/>
                            <TextBlock Classes="para lead" Text="{Binding SteamAddsMessage}"/>
                        </StackPanel>

                        <Border Classes="note" IsVisible="{Binding ShowSteamKeyHint}">
                            <TextBlock Classes="para" Text="{Binding SteamKeyHintMessage}"/>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     EPIC — and the sign-in.
                     The order is deliberate: what Hoard already has, then the
                     gap and what it costs the user in the vocabulary they
                     already read on the rail, then the button. A button offered
                     before its reason is a feature looking for a user.
                     ══════════════════════════════════════════════════════════ -->
                <Border Classes="card">
                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        Spacing="10" VerticalAlignment="Center">
                                <TextBlock Classes="display-l" FontSize="18" Text="Epic"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="data" FontSize="12"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding EpicCountText}"
                                           IsVisible="{Binding ShowEpicCount}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="TITLES"
                                           IsVisible="{Binding ShowEpicCount}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" Classes="pill"
                                    Classes.live="{Binding EpicStatusIsLive}"
                                    Classes.attention="{Binding EpicStatusNeedsAttention}">
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="{Binding EpicStatusLabel}"/>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="LOCAL FILES"/>
                            <TextBlock Classes="para" Text="{Binding EpicLocalMessage}"/>
                        </StackPanel>

                        <!-- The finding this whole panel exists to make
                             possible: a fact about the user's library that the
                             library cannot state about itself. -->
                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="WHAT'S MISSING"/>
                            <TextBlock Classes="para lead" Text="{Binding EpicGapMessage}"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Line}"/>

                        <!-- ── Signed in ──────────────────────────────────── -->
                        <StackPanel Spacing="10" IsVisible="{Binding EpicIsSignedIn}">
                            <StackPanel Spacing="5">
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="CONNECTED AS"
                                           IsVisible="{Binding ShowEpicAccountLine}"/>
                                <!-- The display name, and nothing else about the
                                     account. Never the account id, never
                                     anything out of the token. -->
                                <TextBlock Classes="body-l"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding EpicAccountLine}"
                                           IsVisible="{Binding ShowEpicAccountLine}"/>
                                <TextBlock Classes="para lead"
                                           Text="{Binding EpicAnonymousMessage}"
                                           IsVisible="{Binding ShowEpicAnonymousLine}"/>
                            </StackPanel>

                            <Border Classes="note attention"
                                    IsVisible="{Binding EpicSessionNotPersisted}">
                                <TextBlock Classes="para"
                                           Text="{Binding EpicSessionNotPersistedMessage}"/>
                            </Border>

                            <TextBlock Classes="para" Text="{Binding EpicSignOutMessage}"/>

                            <Button Classes="act quiet"
                                    Content="Sign out"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SignOutOfEpicCommand}"/>
                        </StackPanel>

                        <!-- ── Signing in ─────────────────────────────────────
                             Progress without motion. The design system has no
                             reduced-motion answer for an indeterminate bar
                             (§8 only names the hover ramp), so this says where
                             to look and what has not happened yet, and offers
                             the way out. The window Epic's page is in is itself
                             the strongest evidence anything is happening. ──── -->
                        <StackPanel Spacing="10" IsVisible="{Binding EpicIsSigningIn}">
                            <Border Classes="note working">
                                <TextBlock Classes="para lead" Text="{Binding EpicSigningInMessage}"/>
                            </Border>
                            <Button Classes="act quiet"
                                    Content="Cancel"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SignInToEpicCancelCommand}"/>
                        </StackPanel>

                        <!-- ── Signed out, or a session that lapsed ────────── -->
                        <StackPanel Spacing="10" IsVisible="{Binding EpicCanSignIn}">

                            <!-- A session that expired while the app was closed.
                                 Named as an event rather than as an absence:
                                 "not connected" would read as Hoard having
                                 forgotten them. -->
                            <Border Classes="note attention" IsVisible="{Binding EpicIsLapsed}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                               Foreground="{StaticResource Amber}"
                                               Text="{Binding EpicAccountLine}"
                                               IsVisible="{Binding ShowEpicAccountLine}"/>
                                    <TextBlock Classes="para lead" Text="{Binding EpicLapsedMessage}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="5">
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="WHAT SIGNING IN ADDS"/>
                                <TextBlock Classes="para" Text="{Binding EpicSignInAddsMessage}"/>
                            </StackPanel>

                            <Button Classes="act primary"
                                    HorizontalAlignment="Left"
                                    Content="{Binding EpicSignInButtonText}"
                                    Command="{Binding SignInToEpicCommand}"/>

                            <!-- Says the consent step exists and roughly what it
                                 will say. It is NOT a second consent gate: the
                                 real notice is shown by the prompt before
                                 anything navigates, and a confirmation here
                                 would add no protection while training the user
                                 to click through the one that matters
                                 (docs/spikes/embedded-auth.md §8). -->
                            <TextBlock Classes="para" Text="{Binding EpicConsentPromiseMessage}"/>

                            <!-- The console peer, offered as a standing choice
                                 rather than only after a failure. epic-oauth.md
                                 §1's amendment is explicit that the posture
                                 objection survives the technical answer to it —
                                 the password is typed into a window Hoard
                                 opened, so the protection went from structural
                                 to promised. This is how someone declines that
                                 and keeps the feature, and a route nobody is
                                 told about is not a route. -->
                            <StackPanel Spacing="6">
                                <TextBlock Classes="para" Text="{Binding EpicConsoleAlternativeMessage}"/>
                                <Border Classes="note">
                                    <SelectableTextBlock Classes="cmd"
                                                         Text="{Binding ConsoleSignInCommandText}"/>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                        <!-- ── A failed attempt ──────────────────────────────
                             Ordinary UI, never a dialog and never a crash.
                             The sentence is EpicSignInService's own and each one
                             says what to DO — the remedies here really are
                             different from one another.

                             Outside the three state panels on purpose. Nested in
                             the signed-out branch it was invisible in every other
                             state, which is the shape of bug where the failure
                             that most needs reporting is the one nobody sees: a
                             sign-in that fails against a session already in
                             place. Its own IsVisible is the whole condition. -->
                        <Border Classes="note attention" IsVisible="{Binding ShowEpicProblem}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Foreground="{StaticResource Amber}"
                                           Text="LAST ATTEMPT"/>
                                <TextBlock Classes="para lead" Text="{Binding EpicProblemMessage}"/>

                                <!-- Shown only for the two failures the console
                                     route actually answers: no prompt could run
                                     here, and Epic changed its page. A rejected
                                     code wants another try; an unreachable Epic
                                     wants the same network either way. -->
                                <SelectableTextBlock Classes="cmd"
                                                     IsVisible="{Binding ShowConsoleRoute}"
                                                     Text="{Binding ConsoleSignInCommandText}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     GOG — and no button, on purpose.
                     A greyed "Sign in" here would say Hoard is missing a
                     feature. It is not: the authenticated endpoint was measured
                     and carries nothing the local database does not already
                     have (ROADMAP.md §4). So the finding is stated in words,
                     which is also the only form of it a user can act on.
                     ══════════════════════════════════════════════════════════ -->
                <Border Classes="card">
                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        Spacing="10" VerticalAlignment="Center">
                                <TextBlock Classes="display-l" FontSize="18" Text="GOG"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="data" FontSize="12"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding GogCountText}"
                                           IsVisible="{Binding ShowGogCount}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="TITLES"
                                           IsVisible="{Binding ShowGogCount}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Volt, because this source really is giving Hoard
                                 everything it has. The pill is not a connection
                                 state; it is whether the source is complete. -->
                            <Border Grid.Column="1" Classes="pill live">
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="{Binding GogStatusLabel}"/>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="GALAXY'S DATABASE"/>
                            <TextBlock Classes="para" Text="{Binding GogLocalMessage}"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="NOTHING TO SIGN INTO"/>
                            <TextBlock Classes="para lead" Text="{Binding GogNoSignInMessage}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
