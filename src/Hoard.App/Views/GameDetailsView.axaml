<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hoard.App.ViewModels"
             xmlns:views="using:Hoard.App.Views"
             x:Class="Hoard.App.Views.GameDetailsView"
             x:DataType="vm:GameDetailsViewModel"
             Focusable="True">

    <!--
        The game detail modal. design-system.md §5.3 caps the hover overlay at
        four facts because "the tile is a decision surface, not a detail view" —
        this is the detail view that cap presupposes, and §10 is its spec.

        Four bands, in the order a person asks the questions:
          1  WHAT IS THIS      art, title, year, publisher, store, bucket, state
          2  MY HISTORY        playtime, and the gap rail
          3  GET ME IN         Play / Install, store page, patch notes, folder
          4  THE REST          summary, update list, on-disk and appid facts

        Everything on this screen is a fact we hold. Year, publisher and summary
        arrive with IGDB enrichment behind a library the user is already
        browsing (§7), so each row is bound and simply absent until its fact
        exists. No "Unknown", no grey placeholder line: a stand-in that becomes
        real data an hour later teaches the user to distrust the whole panel.

        Facts the SCHEMA has but this data source never fills — acquired_at,
        license_type, price, edition, platform, achievements — are absent from
        the markup entirely rather than bound and hidden. A row that can never
        appear is dead weight impersonating a feature.

        No flyout anywhere in this panel, deliberately. The global FocusAdorner
        does not render inside a popup (an adorner needs an adorner layer, and a
        popup is its own root — see MainWindow's CheckBox.pref template), so a
        menu here would need its focus ring hand-drawn. Three links do not need
        hiding behind one.
    -->

    <UserControl.Styles>

        <!-- The modal's own scrollbar is an interior control, not one at the
             window edge, so it opts out of the resize-border inset (§9). -->
        <Style Selector="ScrollViewer.inner /template/ ScrollBar">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- ══ Focus, drawn rather than adorned ═══════════════════════════════
             §8 asks for visible keyboard focus everywhere. The global
             FocusAdorner in tokens.axaml could not deliver it here — measured on
             the running window, it put a few stray pixels at the corners of the
             close button and nothing on the rest — so this panel draws its own,
             the same way MainWindow's CheckBox.pref does for the same class of
             reason.

             The ring is a BRUSH swap on a border whose THICKNESS never changes.
             Thickening a border on focus reflows the row it is in, and a set of
             buttons that shuffle sideways as you tab through them is worse than
             no ring at all. It is set on PART_ContentPresenter rather than on
             the Button, because Fluent's own state styles write that presenter
             directly and a TemplateBinding would lose to them on hover. -->

        <!-- Close affordance and patch-notes rows: quiet until touched. The 1px
             border is transparent at rest, so it costs nothing but reserves the
             space the focus ring will need. -->
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.quiet /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.quiet:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>

        <!-- Azure is the palette's boring one and does the boring work (§2):
             every outbound link in the panel, and nothing else. -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.link:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.link :is(TextBlock)">
            <Setter Property="Foreground" Value="{StaticResource Azure}"/>
        </Style>

        <!-- The one filled control on the screen. Volt marks the active thing,
             and starting the game is the most active thing there is (§2). -->
        <Style Selector="Button.launch">
            <Setter Property="Background" Value="{StaticResource Volt}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <!-- 2px of border at all times, Volt on Volt so it is invisible at
                 rest. It exists purely so the focus state has somewhere to land
                 without changing the button's size. -->
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.launch /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="Button.launch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VoltHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VoltHover}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <Style Selector="Button.launch:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VoltPress}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VoltPress}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <!-- The one place the focus ring is not Volt, because it cannot be:
             Volt on a Volt fill is nothing. It is the button's own ink instead —
             the same dark green-teal the label is set in — which reads as the
             control being armed rather than as a different colour arriving. -->
        <Style Selector="Button.launch:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource VoltInk}"/>
        </Style>

        <!-- Copyable text. The I-beam makes the affordance visible before the
             drag; selection itself needs no focus, but Ctrl+C does — and every
             focusable line is also a Tab stop.

             SelectableTextBlock arrives focusable from its own control theme, so
             the four lines worth stopping on (title, summary, appid, install
             path) keep it and everything else opts OUT with Focusable="False".
             Measured before it was written: with all of them focusable it took
             five Tab presses to reach the Play button, past a publisher name and
             a release year nobody tabs to a modal to copy.

             Focused text gets a raised field rather than a ring. §8 wants the
             focus visible, and a 2px outline around a five-line paragraph is a
             box, not an indicator. Keyboard focus only — a tint that appeared
             mid-drag would fight the selection it is meant to support. -->
        <Style Selector="SelectableTextBlock.copyable">
            <Setter Property="Cursor" Value="Ibeam"/>
        </Style>
        <Style Selector="SelectableTextBlock.copyable:focus-visible">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>

        <!-- Update rows. The Flare dot is the §5.2 unread signal, so it appears
             on the rows that really did land after the last session and on no
             others; older rows keep the column's width with a hairline tick so
             the two lists stay aligned. -->
        <Style Selector="Border.updaterow:pointerover">
            <Setter Property="Background" Value="#141D3437"/>
        </Style>

    </UserControl.Styles>

    <Panel>

        <!-- Scrim. Clicking it dismisses — §8's Escape is the keyboard half of
             the same promise: nothing here traps the user. Well at 84%, the
             same unlit tone as the title bar (§9). -->
        <Border Name="Scrim" Background="#D6050D0E" PointerPressed="OnScrimPressed"/>

        <!-- Tab cycles inside the card. A modal that leaks focus into the
             library behind it is a modal in appearance only (§8). -->
        <Border Name="Card"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusTile}"
                BoxShadow="0 18 48 0 #A6000000"
                MinWidth="700" MaxWidth="860" MaxHeight="720"
                Margin="40"
                KeyboardNavigation.TabNavigation="Cycle"
                HorizontalAlignment="Center" VerticalAlignment="Center">

            <!--
                Two columns, and the split is what the columns are ABOUT rather
                than where the art happened to fit.

                LEFT is the object: its art, the id Steam calls it, and where it
                lives on disk. RIGHT is your relationship with it: what you have
                played, the gap, the way back in, then what it says about itself
                and what changed while you were gone.

                The left column carrying the appid and the path is also what
                fixes a real layout fault. With everything in one right-hand
                stack, a game with no last-played date left ~130px of nothing
                beside a 300px cover — the panel read as broken rather than as
                sparse. Two short facts under the art fill exactly that, and
                they belong there on the merits.
            -->
            <Grid ColumnDefinitions="200,*" ColumnSpacing="26" Margin="26,24,26,0">


                <!-- ══ Right: your relationship with it ═════════════════════ -->
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto">

                    <StackPanel Grid.Row="0" Spacing="16">

                        <!-- ── Band 1: what is this ───────────────────────── -->
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <SelectableTextBlock Grid.Column="0"
                                           Classes="display-l copyable"
                                           Focusable="True"
                                           FontSize="26"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap"
                                           LineHeight="30"
                                           Margin="0,0,12,0"/>
                                <Button Grid.Column="1" Classes="quiet"
                                        Name="CloseButton"
                                        VerticalAlignment="Top"
                                        Click="OnClosePressed"
                                        ToolTip.Tip="Close (Esc)">
                                    <TextBlock Classes="body-l"
                                               Foreground="{StaticResource TextDim}"
                                               Text="&#x00D7;"/>
                                </Button>
                            </Grid>

                            <!-- Year and publisher. Bricolage names the game;
                                 Plex Mono states the number; Jakarta sets the
                                 other name. The three faces touching is what
                                 says which of the three each one is (§3). -->
                            <StackPanel Orientation="Horizontal"
                                        IsVisible="{Binding HasIdentityLine}">
                                <SelectableTextBlock Classes="data copyable"
                                           Focusable="False"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding IdentityYearText}"/>
                                <SelectableTextBlock Classes="body copyable"
                                           Focusable="False"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDim}"
                                           IsVisible="{Binding HasPublisher}"
                                           Text="{Binding Publisher}"/>
                            </StackPanel>

                            <!-- A provisional title is an appid wearing a
                                 title's clothes. Saying so is the difference
                                 between "still loading" and "broken". -->
                            <TextBlock Classes="body" FontSize="12"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDim}"
                                       IsVisible="{Binding TitleIsProvisional}"
                                       Text="{Binding ProvisionalNote}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="3" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StoreBadge}"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="9" LetterSpacing="0.54"
                                           Foreground="{StaticResource TextDim}"/>
                            </Border>
                            <Border Background="{StaticResource SurfaceRaised}"
                                    CornerRadius="3" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Classes="body" FontSize="11"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding BucketLabel}"/>
                            </Border>
                            <Border Background="{StaticResource SurfaceRaised}"
                                    CornerRadius="3" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Classes="body" FontSize="11"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding InstallText}"/>
                            </Border>
                        </StackPanel>

                        <!-- ── Band 2: my history ─────────────────────────── -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="26">

                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Top">
                                <TextBlock Classes="data"
                                           FontSize="30" LineHeight="34"
                                           Text="{Binding PlaytimeText}"/>
                                <TextBlock Classes="label" FontSize="10" Text="PLAYED"/>
                            </StackPanel>

                            <!-- The gap: last session → now, with what shipped
                                 in between. §10's signature. -->
                            <StackPanel Grid.Column="1" Spacing="7"
                                        IsVisible="{Binding HasGap}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label"
                                               FontSize="10" Text="SINCE YOU PLAYED"/>
                                    <TextBlock Grid.Column="1" Classes="data"
                                               FontSize="14"
                                               Foreground="{StaticResource Text}"
                                               Text="{Binding IdleText}"/>
                                </Grid>

                                <views:GapRail Marks="{Binding RailMarks}"
                                               StartBrush="{StaticResource Volt}"
                                               EndBrush="{StaticResource Line}"
                                               MarkBrush="{StaticResource Flare}"
                                               MarkRingBrush="{StaticResource Surface}"/>

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="data-s"
                                               Text="{Binding LastPlayedText}"/>
                                    <TextBlock Grid.Column="2" Classes="data-s"
                                               Text="today"/>
                                </Grid>

                                <TextBlock Classes="body" FontSize="12"
                                           LineHeight="17"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding GapCaption}"/>

                                <!-- §1's longitudinal record, at the resolution
                                     the data supports: a sentence, not a chart
                                     through one point. -->
                                <TextBlock Classes="body" FontSize="12"
                                           LineHeight="17"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDim}"
                                           IsVisible="{Binding HasRecordLine}"
                                           Text="{Binding RecordLine}"/>
                            </StackPanel>

                            <!-- No date, no rail. Two different absences, and
                                 the copy keeps them apart. -->
                            <StackPanel Grid.Column="1" Spacing="7"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding LacksGap}">
                                <TextBlock Classes="body" FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding NoGapText}"/>
                                <TextBlock Classes="body" FontSize="12"
                                           LineHeight="17"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDim}"
                                           IsVisible="{Binding HasRecordLine}"
                                           Text="{Binding RecordLine}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ── Band 3: get me in ──────────────────────────── -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- steam://run when it is on disk, steam://install
                                 when it is not. The button is named for what it
                                 does, so it cannot promise the wrong thing. -->
                            <Button Classes="launch"
                                    Name="LaunchButton"
                                    IsVisible="{Binding HasPrimaryAction}"
                                    Content="{Binding PrimaryAction.Label}"
                                    ToolTip.Tip="{Binding PrimaryAction.Tooltip}"
                                    Click="OnPrimaryActionPressed"/>

                            <ItemsControl ItemsSource="{Binding Links}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:GameLink">
                                        <Button Classes="link"
                                                Click="OnLinkPressed"
                                                ToolTip.Tip="{Binding Tooltip}">
                                            <TextBlock Classes="body" FontSize="12"
                                                       Text="{Binding Label}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Local folder, not a file: URI — GameLink refuses
                                 that scheme on purpose and the launcher takes a
                                 DirectoryInfo directly. -->
                            <Button Classes="link"
                                    IsVisible="{Binding HasOpenableFolder}"
                                    Click="OnOpenFolderPressed"
                                    ToolTip.Tip="{Binding InstallPath}">
                                <TextBlock Classes="body" FontSize="12" Text="Open folder"/>
                            </Button>
                        </StackPanel>

                    </StackPanel>

                    <!-- The seam between deciding and reading. It spans the
                         right column only: the left column keeps going. -->
                    <Border Grid.Row="1" Height="1" Margin="0,22,0,0"
                            Background="{StaticResource Line}"/>

                <!-- ══ Band 4: the rest ═════════════════════════════════════ -->
                <!-- The band's own breathing room is the CONTENT's margin, not
                     the ScrollViewer's padding. Padding here is not counted in
                     the viewer's desired height, so the card sized itself ~40px
                     short and clipped its last row mid-line — with no scrollbar,
                     because as far as the viewer was concerned everything
                     fitted. A margin on the scrolled content is measured. -->
                <ScrollViewer Grid.Row="2"
                              Classes="inner"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="22" Margin="0,18,0,24">

                        <StackPanel Spacing="7">
                            <TextBlock Classes="label" Text="ABOUT"/>
                            <SelectableTextBlock Classes="body copyable"
                                       Focusable="True"
                                       Foreground="{StaticResource TextDim}"
                                       LineHeight="20"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasSummary}"
                                       Text="{Binding Summary}"/>
                            <!-- §7: an empty screen is a direction, not a mood. -->
                            <TextBlock Classes="body"
                                       Foreground="{StaticResource TextDim}"
                                       LineHeight="20"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding ShowEmptyBody}"
                                       Text="{Binding EmptyBodyText}"/>
                        </StackPanel>

                        <!-- §5.2: the badge exists so the user can go read what
                             changed. Announcements carry a page; build pushes
                             do not, and offering a dead link would be worse
                             than offering none. -->
                        <StackPanel Spacing="4" IsVisible="{Binding HasUpdates}">
                            <TextBlock Classes="label" Text="{Binding UpdatesLabel}"/>
                            <ItemsControl ItemsSource="{Binding Updates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:UpdateEventViewModel">
                                        <Border Classes="updaterow"
                                                BorderBrush="{StaticResource Line}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,9">
                                            <Grid ColumnDefinitions="16,*,Auto,Auto" ColumnSpacing="10">
                                                <!-- Flare: unread-update marker
                                                     only, here as everywhere. -->
                                                <Border Grid.Column="0"
                                                        Width="7" Height="7" CornerRadius="4"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource Flare}"
                                                        BoxShadow="0 0 8 0 #B3FF4D93"
                                                        IsVisible="{Binding IsSinceYouPlayed}"
                                                        ToolTip.Tip="Landed after your last session"/>
                                                <SelectableTextBlock Grid.Column="1" Classes="body copyable"
                                                           Focusable="False"
                                                           Text="{Binding Headline}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Classes="data-s"
                                                           Text="{Binding DateText}"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="3"
                                                        Classes="quiet"
                                                        IsVisible="{Binding HasLink}"
                                                        Click="OnUpdateLinkPressed"
                                                        ToolTip.Tip="{Binding Link.Tooltip}">
                                                    <TextBlock Classes="body" FontSize="12"
                                                               Foreground="{StaticResource Azure}"
                                                               Text="Patch notes"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                </Grid>

                <!-- ══ Left: the object ═════════════════════════════════════
                     Declared AFTER the right column although it renders to the
                     left of it. Avalonia's tab navigation walks the tree, not
                     the TabIndex of a non-focusable container — measured, not
                     assumed — so with the left column first, two Tab presses
                     into a modal landed on an appid and an install path while
                     the Play button was six stops away. Grid.Column places it;
                     the declaration order is the keyboard's order.

                     Its own bottom margin, not the grid's: the right column's
                     breathing room lives on the scrolled content, and a margin
                     on the shared grid would double up over there. Without it
                     the appid's descenders clip on any game whose left column
                     is the taller of the two. -->
                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="18"
                            Margin="0,0,0,24">

                    <Border Height="300"
                            CornerRadius="{StaticResource RadiusTile}"
                            ClipToBounds="True"
                            BorderThickness="1" BorderBrush="#992B4A4C">
                        <Panel>
                            <!-- Placeholder is the fallback, never a hole (§7). -->
                            <Border Background="{Binding PlaceholderBrush}"
                                    IsVisible="{Binding ShowPlaceholder}">
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold" FontSize="22" LineHeight="24"
                                           TextWrapping="Wrap" Foreground="White"
                                           VerticalAlignment="Bottom" Margin="16"/>
                            </Border>
                            <!-- Full saturation: the ramp is a scanning aid for
                                 the grid, and the user has already scanned. -->
                            <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                        </Panel>
                    </Border>

                    <!-- What Steam calls it. Selectable because an appid is a
                         thing people paste into a search box. -->
                    <StackPanel Spacing="3" IsVisible="{Binding HasSteamAppId}">
                        <TextBlock Classes="label" FontSize="10" Text="STEAM APPID"/>
                        <SelectableTextBlock Classes="data copyable"
                                   Focusable="True"
                                   HorizontalAlignment="Left"
                                   Text="{Binding SteamAppId}"/>
                    </StackPanel>

                    <!-- Only when there is a path to give. "Not installed" is
                         already a chip at the top, and §7 does not want a fact
                         stated twice on one screen. -->
                    <StackPanel Spacing="3" IsVisible="{Binding HasInstallPath}">
                        <TextBlock Classes="label" FontSize="10" Text="ON DISK"/>
                        <SelectableTextBlock Classes="data-s copyable"
                                   Focusable="True"
                                   Text="{Binding InstallPath}"
                                   LineHeight="15"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>
    </Panel>

</UserControl>
