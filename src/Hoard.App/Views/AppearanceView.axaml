<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hoard.App.ViewModels"
             x:Class="Hoard.App.Views.AppearanceView"
             x:DataType="vm:AppearanceViewModel">

    <!--
        SETTINGS › APPEARANCE. Two decisions: which theme, and how much of
        the desktop the window admits.

        The theme cards are the screen. Each one draws the window at 1/8 scale
        out of its own palette — the caption and rail as one chrome bracket, one
        lit row, the seam, a wall of capsules, one unread dot — rather than a
        strip of colour chips. A chip row says what the hues are; the miniature
        says what they DO, and since these four themes differ by value structure
        and material rather than by hue, a chip row would say almost nothing at
        all. Four of them side by side also state the invariant without a
        sentence: the Flare dot changes colour and never changes job, and there
        is exactly one of it per theme.

        Nothing here animates. §12.5's rule is that motion lives in a style so
        §8's reduced-motion setting can take it away, and a settings screen that
        cross-fades while you compare four palettes is a settings screen you
        cannot compare four palettes on.
    -->

    <UserControl.Styles>

        <!-- ══ A theme card ═══════════════════════════════════════════════
             A real Button, so it is one Tab stop, fires on Space, and reports
             itself to automation as the control it is. Selection is a Volt edge
             at a thickness that never changes (§10.7) — a card that thickens on
             pick would reflow the row of four beside it. -->
        <Style Selector="Button.themecard">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.themecard /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style Selector="Button.themecard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="Button.themecard.picked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="Button.themecard:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>

        <!-- The miniature. Fixed geometry so four of them line up exactly:
             a 2:3 wall of capsules is the app's own atom (§4) and the mock
             reads wrong the moment the proportions drift. -->
        <Style Selector="Border.mini">
            <Setter Property="Height" Value="96"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <!-- ══ The transparency slider ════════════════════════════════════
             The command bar's DENSITY slider is the reference and this one keeps
             its grammar — neutral track, neutral thumb, the travelled side in
             TextDim and the rest in Line — because a slider that meant something
             different on the settings screen would be a second convention to
             learn. It is drawn a step larger, and that is the only difference:
             density is a knob you nudge while scanning, this is a setting you
             sit and tune. The thumb stays NEUTRAL rather than Volt (§2: Volt is
             selection, and a value in force is not a selection).
        -->
        <Style Selector="Slider.opacity">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="Slider.opacity /template/ Track#PART_Track RepeatButton#PART_DecreaseButton /template/ Border">
            <Setter Property="Background" Value="{StaticResource TextDim}"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <Style Selector="Slider.opacity /template/ Track#PART_Track RepeatButton#PART_IncreaseButton /template/ Border">
            <Setter Property="Background" Value="{StaticResource Line}"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <Style Selector="Slider.opacity /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource TextDim}"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
        <Style Selector="Slider.opacity:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource Text}"/>
        </Style>

        <!-- §8's focus ring, drawn by the frame rather than adorned on the
             thumb. The global FocusAdorner puts a rounded box round the whole
             control, which on a 340px track is a box and not an indicator; and
             a Thumb's own template ignores BorderBrush, so a ring set there
             renders nothing. `:focus-within` on the frame is the one place that
             both shows up and does not move anything: the border thickness
             never changes, only its brush (§10.7). -->
        <Style Selector="Border.sliderframe">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="-8,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.sliderframe:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>

        <!-- The worst-case ratio, once it is under AA. Amber and not Danger:
             §2 gives Amber "attention" and Danger the one destructive act, and
             a setting the user chose with the number in front of them is
             neither an error nor something to be undone for them. -->
        <Style Selector="TextBlock.ratio.under">
            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="{StaticResource WallGround}">

        <!-- ══ Header ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Padding="24,20,24,18"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="7">
                <TextBlock Classes="display-l" Text="{Binding Title}"/>
                <TextBlock Classes="body"
                           MaxWidth="640"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           Foreground="{StaticResource TextDim}"
                           Text="{Binding IntroMessage}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,28" MaxWidth="920"
                        HorizontalAlignment="Left" Spacing="14">

                <TextBlock Classes="label" FontSize="10" LetterSpacing="1.4" Text="THEME"/>

                <ItemsControl ItemsSource="{Binding Themes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ThemeChoiceViewModel">
                            <Button Classes="themecard"
                                    Classes.picked="{Binding IsSelected}"
                                    Margin="0,0,12,12"
                                    Command="{Binding $parent[ItemsControl].((vm:AppearanceViewModel)DataContext).SelectThemeCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Reason}">
                                <StackPanel Spacing="0">

                                    <!-- ══ The window, at 1/8 ══════════════
                                         Caption and rail as ONE continuous
                                         chrome bracket (§9), with the art
                                         recessed inside it. Every piece is one
                                         of this theme's own brushes, so the card
                                         keeps showing its palette while the app
                                         is wearing another.

                                         The two things that separate these four
                                         themes are both visible here and neither
                                         is a hue: how far the wall drops below
                                         the chrome, and how loud the seam
                                         between them is. -->
                                    <Border Classes="mini" CornerRadius="4,4,0,0"
                                            Background="{Binding Ground}">
                                        <Grid RowDefinitions="12,*">

                                            <!-- The caption takes the rail's
                                                 colour, so the chrome reads as
                                                 one block down the side and
                                                 across the top rather than two
                                                 tones meeting at a corner. -->
                                            <Border Grid.Row="0" Background="{Binding Surface}"/>

                                            <Grid Grid.Row="1" ColumnDefinitions="46,*">

                                                <!-- Rail: four rows, one lit,
                                                     and the lit one carries the
                                                     2px Volt edge. Its right
                                                     edge is the chrome/art seam
                                                     (§11.1), drawn at the
                                                     theme's own Line — which is
                                                     Nightshift's whole structure
                                                     and Tungsten's quietest
                                                     detail. -->
                                                <Border Grid.Column="0" Background="{Binding Surface}"
                                                        BorderBrush="{Binding Line}"
                                                        BorderThickness="0,0,1,0">
                                                    <StackPanel Margin="0,6" Spacing="6">
                                                        <Border Background="{Binding SurfaceRaised}" Height="12">
                                                            <Grid ColumnDefinitions="2,5,*,6">
                                                                <Border Grid.Column="0" Background="{Binding Volt}"/>
                                                                <Border Grid.Column="2" Height="4" CornerRadius="2"
                                                                        Background="{Binding Text}"/>
                                                            </Grid>
                                                        </Border>
                                                        <!-- The one rail row with a
                                                             pip beside its count:
                                                             Patched since, which is
                                                             what Flare counts (6). -->
                                                        <Grid ColumnDefinitions="2,5,5,3,*,6" Height="8">
                                                            <Ellipse Grid.Column="2" Width="4" Height="4"
                                                                     Fill="{Binding Flare}"
                                                                     VerticalAlignment="Center"/>
                                                            <Border Grid.Column="4" Height="4" CornerRadius="2"
                                                                    Background="{Binding TextDim}" Opacity="0.7"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="2,5,*,6" Height="8">
                                                            <Border Grid.Column="2" Height="4" CornerRadius="2"
                                                                    Background="{Binding TextDim}" Opacity="0.5"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="2,5,*,6" Height="8">
                                                            <Border Grid.Column="2" Height="4" CornerRadius="2"
                                                                    Background="{Binding TextDim}" Opacity="0.3"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- The wall. 2:3 capsules, the
                                                     app's own atom (§4), and the
                                                     SAME seven on all four cards
                                                     — real cover art does not
                                                     change when the room does, so
                                                     four miniatures that differ
                                                     only in their chrome are this
                                                     palette system's whole claim
                                                     made visually.

                                                     Two of them carry §5.1's
                                                     dormancy floor: bright tiles
                                                     are alive, ghosted ones are
                                                     what you forgot you owned.
                                                     The row runs off the right
                                                     edge because a wall does. -->
                                                <Border Grid.Column="1" Background="{Binding Ground}"
                                                        Padding="8,9,0,0" ClipToBounds="True">
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Top">
                                                        <Panel Width="46" Height="69">
                                                            <Border CornerRadius="3"
                                                                    Background="{x:Static vm:ThemeChoiceViewModel.Art1}"/>
                                                            <!-- The one Flare in the picture, and the
                                                                 one thing on the card that IS the
                                                                 theme's own colour. -->
                                                            <Ellipse Width="6" Height="6"
                                                                     Fill="{Binding Flare}"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Top"
                                                                     Margin="0,3,3,0"/>
                                                        </Panel>
                                                        <Border Width="46" Height="69" CornerRadius="3"
                                                                Background="{x:Static vm:ThemeChoiceViewModel.Art2}"/>
                                                        <Border Width="46" Height="69" CornerRadius="3"
                                                                Background="{x:Static vm:ThemeChoiceViewModel.ArtDormant1}"/>
                                                        <Border Width="46" Height="69" CornerRadius="3"
                                                                Background="{x:Static vm:ThemeChoiceViewModel.Art3}"/>
                                                        <Border Width="46" Height="69" CornerRadius="3"
                                                                Background="{x:Static vm:ThemeChoiceViewModel.Art4}"/>
                                                        <Border Width="46" Height="69" CornerRadius="3"
                                                                Background="{x:Static vm:ThemeChoiceViewModel.ArtDormant2}"/>
                                                        <Border Width="46" Height="69" CornerRadius="3"
                                                                Background="{x:Static vm:ThemeChoiceViewModel.Art5}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="16,12,16,14" Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Classes="display-l" FontSize="17"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center"/>
                                            <!-- Says which one you are on in a
                                                 word as well as in an edge (§8):
                                                 the Volt border is never the
                                                 only thing carrying it. -->
                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding IsSelected}"
                                                    Background="{StaticResource Volt}"
                                                    CornerRadius="9" Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="label" FontSize="9" LetterSpacing="1"
                                                           Foreground="{StaticResource VoltInk}"
                                                           Text="IN USE"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Classes="para"
                                                   Text="{Binding Reason}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ══ TRANSPARENCY ═══════════════════════════════════════ -->
                <TextBlock Classes="label" FontSize="10" LetterSpacing="1.4"
                           Margin="0,10,0,0" Text="TRANSPARENCY"/>

                <Border Classes="card" MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="body-l"
                                       Text="Let the desktop through"
                                       VerticalAlignment="Center"/>
                            <!-- Every number in Plex Mono, tabular (§3), so the
                                 reading does not jitter sideways as it is
                                 dragged past 9 → 10 → 100. -->
                            <TextBlock Grid.Column="1" Classes="data"
                                       Text="{Binding TransparencyReading}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Classes="sliderframe">
                            <StackPanel Width="{Binding SliderWidth}" Spacing="0">

                                <!-- ══ The AA mark ═══════════════════════════
                                     Where the worst case — a wall of white
                                     behind the window — takes the rail's labels
                                     under 4.5:1. It is a mark and not a stop:
                                     the range past it is a choice the user is
                                     allowed to make, and the readout below says
                                     what it costs in numbers rather than in
                                     adjectives. Its position is per theme,
                                     because the answer is.

                                     Both pieces take the same margin off the
                                     view model, computed from the track's own
                                     geometry, so the tick sits exactly over the
                                     value it names. -->
                                <Panel Height="14" HorizontalAlignment="Stretch">
                                    <TextBlock Classes="data-s"
                                               Text="AA"
                                               Padding="4,0,0,0"
                                               Foreground="{StaticResource TextFaint}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Margin="{Binding AaMarkMargin}"/>
                                </Panel>
                                <Panel Height="6" HorizontalAlignment="Stretch">
                                    <Border Width="1" Height="6"
                                            Background="{StaticResource TextFaint}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Margin="{Binding AaMarkMargin}"/>
                                </Panel>

                                <Slider Name="TransparencySlider"
                                        Classes="opacity"
                                        Minimum="0" Maximum="100"
                                        SmallChange="1" LargeChange="10"
                                        Value="{Binding Transparency, Mode=TwoWay}"
                                        ToolTip.Tip="How much of the desktop the rail, title bar, filter panel and command bar let through"/>

                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                                    <!-- Zero is a position, so it is named. -->
                                    <TextBlock Grid.Column="0" Classes="label" FontSize="9"
                                               Foreground="{StaticResource TextFaint}"
                                               Text="SOLID"/>
                                    <TextBlock Grid.Column="2" Classes="label" FontSize="9"
                                               Foreground="{StaticResource TextFaint}"
                                               Text="MOST DESKTOP"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══ What it costs, live ═══════════════════════════
                             §8's floor is a claim about the running window, so
                             the screen measures the window rather than quoting a
                             number somebody took once. Two backdrops, because
                             one of them would be a lie in either direction: the
                             Mica composite is what the user's desktop actually
                             does and it only ever improves, and white is the
                             brightest a wallpaper can be and is the one that
                             falls. Neither nags — the second number turns Amber
                             (§2: attention, not error) and says which line it
                             crossed. -->
                        <StackPanel Spacing="6" Margin="0,4,0,0">
                            <TextBlock Classes="label" FontSize="9" LetterSpacing="1.2"
                                       Text="LABELS ON THE CHROME"/>

                            <Grid ColumnDefinitions="Auto,10,*" IsVisible="{Binding !IsSolid}">
                                <TextBlock Grid.Column="0" Classes="data"
                                           Text="{Binding ContrastOnDarkWallpaper}"/>
                                <TextBlock Grid.Column="2" Classes="body" FontSize="12"
                                           Foreground="{StaticResource TextDim}"
                                           VerticalAlignment="Center"
                                           Text="{Binding DarkWallpaperNote}"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,10,*" IsVisible="{Binding !IsSolid}">
                                <TextBlock Grid.Column="0" Classes="data ratio"
                                           Classes.under="{Binding UnderAa}"
                                           Text="{Binding ContrastOnWhiteWallpaper}"/>
                                <TextBlock Grid.Column="2" Classes="body" FontSize="12"
                                           Foreground="{StaticResource TextDim}"
                                           VerticalAlignment="Center"
                                           Text="{Binding WhiteWallpaperNote}"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,10,*" IsVisible="{Binding IsSolid}">
                                <TextBlock Grid.Column="0" Classes="data"
                                           Text="{Binding ContrastOnWhiteWallpaper}"/>
                                <TextBlock Grid.Column="2" Classes="body" FontSize="12"
                                           Foreground="{StaticResource TextDim}"
                                           VerticalAlignment="Center"
                                           Text="on the chrome, solid"/>
                            </Grid>

                            <TextBlock Classes="para" Text="{Binding ContrastNote}"/>
                        </StackPanel>

                        <!-- The honest case. A setting that is up and doing
                             nothing is worse than a setting at zero, so the
                             screen says which one this is. Amber because §2
                             gives Amber "attention", and this is not an error:
                             the user has not done anything wrong by sitting on
                             a machine that will not composite. -->
                        <Border IsVisible="{Binding TransparencyUnavailable}"
                                Background="{StaticResource Ground}"
                                BorderBrush="{StaticResource Amber}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusControl}"
                                Padding="14,12">
                            <TextBlock Classes="body" FontSize="12" LineHeight="18"
                                       TextWrapping="Wrap"
                                       Text="Not available here. Windows 10, a remote session and some virtual display drivers all refuse the backdrop."/>
                        </Border>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,2"/>

                        <TextBlock Classes="para"
                                   Text="{Binding TransparencyStatus}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
