<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hoard.App.ViewModels"
             x:Class="Hoard.App.Views.GameTileView"
             x:DataType="vm:GameTileViewModel"
             ClipToBounds="False">

    <!--
        The cover tile. Art is the two-layer dormancy cross-fade settled in
        docs/spikes/avalonia-dormancy-rendering.md: the floor variant sits
        under the vivid layer, whose Opacity = (S − 0.22) / 0.78 rises to 1.0
        under the pointer over 140ms. M0 layers are procedural gradient
        Borders (title baked into each layer so it fades with its art); when
        real covers land each layer becomes an Image over a decoded bitmap
        and the fade logic is untouched.
    -->

    <UserControl.Styles>
        <Style Selector="Border#Lift">
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- Hover lift + the one permitted drop shadow (§4). -->
        <Style Selector="Border#Lift:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #8C000000"/>
        </Style>
        <!-- Resting scrim opacity has to come from a style, not a local value:
             a local value outranks a style setter in Avalonia's precedence, so
             Opacity="0" on the element would pin the overlay shut forever. -->
        <Style Selector="Border#Scrim">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border#Lift:pointerover Border#Scrim">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- M0 only: the placeholder title is painted into each art layer so it
             fades with its art. The scrim carries the real §5.3 title, so the
             baked one steps aside on hover instead of ghosting through. When
             real covers land the art layers carry no text and this is inert. -->
        <Style Selector="TextBlock.art-title">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#Lift:pointerover TextBlock.art-title">
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <Style Selector="Button.play">
            <Setter Property="Background" Value="{StaticResource Volt}"/>
            <Setter Property="Foreground" Value="#0C2A24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#6FEDCE"/>
            <Setter Property="Foreground" Value="#0C2A24"/>
        </Style>
        <Style Selector="Button.play:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3BD1AC"/>
            <Setter Property="Foreground" Value="#0C2A24"/>
        </Style>
    </UserControl.Styles>

    <Border Name="Lift" CornerRadius="{StaticResource RadiusTile}" ClipToBounds="False"
            Background="Transparent">
        <Panel>

            <!-- Rounded clip for the art stack. -->
            <Border CornerRadius="{StaticResource RadiusTile}" ClipToBounds="True"
                    BorderThickness="1" BorderBrush="#993D3168">
                <Panel>

                    <!-- Layer 1: dormancy floor (sat 0.22 / bright 0.60). -->
                    <Border Background="{Binding FloorBrush}">
                        <TextBlock Classes="art-title" Text="{Binding Title}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="Bold" FontSize="19" LineHeight="20"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding FloorTitleBrush}"
                                   VerticalAlignment="Bottom" Margin="14"/>
                    </Border>

                    <!-- Layer 2: vivid art; opacity carries the dormancy ramp,
                         hover animates it to 1.0 in 140ms. -->
                    <Border Background="{Binding VividBrush}" Opacity="{Binding DisplayAlpha}">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Border.Transitions>
                        <TextBlock Classes="art-title" Text="{Binding Title}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="Bold" FontSize="19" LineHeight="20"
                                   TextWrapping="Wrap"
                                   Foreground="White"
                                   VerticalAlignment="Bottom" Margin="14"/>
                    </Border>

                    <!-- Gloss sweep, per mock's .art::after. -->
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="70%,100%">
                                <GradientStop Offset="0" Color="#29FFFFFF"/>
                                <GradientStop Offset="0.42" Color="#00FFFFFF"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Hover overlay: ≤ 4 facts — the tile is a decision surface. -->
                    <Border Name="Scrim" VerticalAlignment="Bottom" Padding="10,24,10,10"
                            Background="{StaticResource TileScrim}">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Border.Transitions>
                        <StackPanel Spacing="8">
                            <!-- §5.3: title in Body L, then playtime + idle,
                                 store badge, one primary action. Four facts. -->
                            <TextBlock Classes="body-l"
                                       Text="{Binding Title}"
                                       TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       LineHeight="18"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="data-s"
                                           Text="{Binding StatText}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="3" Padding="5,1">
                                    <TextBlock Text="{Binding StoreBadge}"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="9" LetterSpacing="0.54"
                                               Foreground="{StaticResource TextDim}"/>
                                </Border>
                            </Grid>
                            <!-- No-op for M0: launching arrives with sessions (M2). -->
                            <Button Classes="play" Content="Play"/>
                        </StackPanel>
                    </Border>

                </Panel>
            </Border>

            <!-- Keyboard/pointer selection ring: 2px Volt, offset outward. -->
            <Border BorderBrush="{StaticResource Volt}" BorderThickness="2"
                    CornerRadius="8" Margin="-3" IsHitTestVisible="False"
                    IsVisible="{Binding IsSelected}"/>

            <!-- Unread-update badge (§5.2): 10px Flare dot, 2px Ground ring,
                 soft glow. Flare appears here and on the rail pip — nowhere else. -->
            <Border Width="14" Height="14" CornerRadius="7"
                    Background="{StaticResource Flare}"
                    BorderBrush="{StaticResource Ground}" BorderThickness="2"
                    BoxShadow="0 0 10 0 #D9FF5C8A"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    IsVisible="{Binding HasUnread}"/>

        </Panel>
    </Border>

</UserControl>
