<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hoard.App.ViewModels"
        xmlns:views="using:Hoard.App.Views"
        xmlns:lists="using:Hoard.App.ViewModels.Lists"
        x:Class="Hoard.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Hoard"
        Width="1280" Height="820"
        MinWidth="880" MinHeight="560"
        Background="{StaticResource Ground}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <!--
        M0 library shell — design-system.md §4 layout, §6 components, and the
        mock's rail / command bar / cover wall. The cover grid is
        views:CoverWall, the project's own virtualizing uniform panel — the swap
        docs/spikes/avalonia-dormancy-rendering.md planned for after 12.0,
        brought forward because ItemsRepeater's UniformGridLayout could not hold
        §4's flush-row geometry (CoverWall's remarks carry the measurements).

        The client area is extended over the decorations and the caption is
        drawn here (§9): a light Windows title bar over a dark library put the
        brightest band in the window above the art. Behaviour the system used
        to provide is now ours — drag, double-click to maximise, hover/pressed
        states, Aero Snap, and the maximised overhang — and lives in
        MainWindow.axaml.cs.
    -->

    <Window.Styles>

        <!-- ══ Window chrome (§9) ═══════════════════════════════════════════
             Caption buttons at the Windows metric (46 wide) so muscle memory
             lands on them, but flat and unlit until touched. Close reddens,
             which is the one caption convention worth keeping: it is the only
             button here whose mistake cannot be undone. -->
        <Style Selector="Button.wincontrol">
            <Setter Property="Width" Value="{StaticResource WindowButtonWidth}"/>
            <Setter Property="Height" Value="{StaticResource TitleBarHeight}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.wincontrol /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.10"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.wincontrol:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.wincontrol:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#254042"/>
        </Style>
        <Style Selector="Button.wincontrol Path">
            <Setter Property="Stroke" Value="{StaticResource TextDim}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.wincontrol:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Button.wincontrol.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
        </Style>
        <Style Selector="Button.wincontrol.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B33A35"/>
        </Style>
        <Style Selector="Button.wincontrol.close:pointerover Path">
            <Setter Property="Stroke" Value="#FFF2EF"/>
        </Style>

        <!-- Fluent's scrollbar keeps its rest/expanded behaviour and its
             colours come from tokens.axaml; only the stepper arrows go, since
             a 606-tile wall is scrolled by wheel and thumb and the arrows are
             two more things drawing attention away from the art. -->
        <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- ══ The scrollbar the resize border was eating ═══════════════════
             The client area is extended over the decorations (§9), so Windows
             still hit-tests the outer ~8px of the window as HTRIGHT / HTBOTTOM
             / HTBOTTOMRIGHT and answers those pixels with a resize cursor
             BEFORE the client area ever sees the pointer. A 12px scrollbar
             flush to the edge therefore left 2–4 usable pixels: the user could
             see the thumb, and could not reach it.

             The fix is an inset, not a wider control. Widening the thumb would
             have changed nothing — the border wins at the OS level, above
             Avalonia's hit testing entirely — and hooking WM_NCHITTEST to
             answer HTCLIENT along that strip would have bought the scrollbar
             back by taking away edge-resize down the whole right side of the
             window, which is a worse trade than 10px of ground.

             So every scrollbar at the window edge steps 10px in (§9's
             ScrollBarEdgeInset: the 8px Windows resize frame plus slack). The
             resting 4px hairline the design asks for is untouched — this moves
             where the control sits, not what it looks like — and Fluent's own
             swell-to-12-on-hover now actually fires, because the pointer can
             reach the track to trigger it.

             Global rather than per-view: a ScrollBar inside a ListBox lives two
             templates deep, which no single selector can reach. Interior
             scrollbars — the rail's, the detail modal's — opt back out with
             ScrollViewer.inner below. -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Margin" Value="{StaticResource ScrollBarEdgeInset}"/>
        </Style>
        <Style Selector="ScrollViewer.inner /template/ ScrollBar">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- ══ Rail bucket (§6) ══════════════════════════════════════════════
             Hover and selection both fill SurfaceRaised; selection adds the
             2px Volt left edge. Zero-count rows dim to 40% — never hide, so
             the rail never reflows. -->
        <Style Selector="Button.bucket">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.bucket /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.bucket:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.bucket:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.bucket.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <!-- A bucket in force while a LIST is open. Same fill, because it is
             cutting the grid; no Volt edge, because the Volt edge means "this is
             where you are" and where you are is the list. See
             LibraryViewModel.MarkRailSelection. -->
        <Style Selector="Button.bucket.rule /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>

        <!-- ══ Rail list row ═══════════════════════════════════════════════
             Same fill, hover and 2px Volt selection edge as a bucket, because a
             list is another way of cutting the same library and the rail should
             not need two grammars for that. One difference, and it is the point:
             the NAME is body type, not the buckets' Display S caps. Bucket names
             are the application's own vocabulary and are shouted; a list name is
             the user's own sentence and is not. -->
        <Style Selector="Button.listrow">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.listrow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.listrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.listrow.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>

        <!-- ══ Command bar ═════════════════════════════════════════════════ -->
        <Style Selector="TextBox.search">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
            <Setter Property="SelectionBrush" Value="#4D4DE8C2"/>
            <Setter Property="CaretBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.search /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>

        <!-- Segmented grid/list toggle. Volt marks the active segment. -->
        <Style Selector="Button.seg">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.seg /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1F1D3437"/>
        </Style>
        <Style Selector="Button.seg.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.seg Rectangle">
            <Setter Property="Fill" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="Button.seg.on Rectangle">
            <Setter Property="Fill" Value="{StaticResource Volt}"/>
        </Style>

        <!-- Inert chrome controls (sort / store filter stubs), mock's .ctl. -->
        <Style Selector="Button.ctl">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ctl /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ctl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <!-- A toggle in a row of menus: the open panel keeps its button lit, so
             the control and the column it opened are legibly one thing. -->
        <Style Selector="Button.ctl.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.ctl.on TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Button.ctl.on Path">
            <Setter Property="Fill" Value="{StaticResource Volt}"/>
        </Style>

        <!-- Sort menu (§4's `sort ▾`). Flyout content lives in its own popup
             root, which styles itself from this window — so these selectors
             reach it. -->
        <Style Selector="FlyoutPresenter.sortmenu">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MaxWidth" Value="320"/>
        </Style>
        <Style Selector="Button.sortitem">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.sortitem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.sortitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4D0F1C1E"/>
        </Style>

        <!-- ══ Display preferences popover (§8) ════════════════════════════
             Same presenter treatment as the sort menu, with room for a line of
             prose. The checkbox is templated rather than restyled: Fluent's own
             reads a dozen resource keys for its box, its stroke and its glyph in
             six states, and overriding all of them to land on this palette is
             more surface than drawing 16px and a tick. The template keeps the
             control a real CheckBox, so it toggles on Space, reports its state
             to automation, and takes the global 2px Volt focus adorner. -->
        <Style Selector="FlyoutPresenter.prefs">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MaxWidth" Value="360"/>
        </Style>
        <Style Selector="CheckBox.pref">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="16,10,*" Background="Transparent">
                        <!-- §8's 2px Volt focus ring at a 2px offset, drawn in
                             the template rather than left to the global
                             FocusAdorner: an adorner needs an adorner layer, and
                             a flyout is its own popup root — the ring went to
                             the window's layer and never appeared over the
                             popup. Negative margin so the ring sits outside the
                             16px box without widening the column. -->
                        <Border Grid.Column="0" Name="Ring"
                                Width="22" Height="22" Margin="-3,0,0,0"
                                CornerRadius="5"
                                BorderBrush="{StaticResource Volt}"
                                BorderThickness="2"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                        <Panel Grid.Column="0" VerticalAlignment="Center">
                            <Border Name="Box" Width="16" Height="16"
                                    CornerRadius="3"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1"/>
                            <Path Name="Tick"
                                  Data="M 0,3.4 L 2.9,6.3 L 8.2,1"
                                  Stroke="{StaticResource VoltInk}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Width="9" Height="8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Panel>
                        <ContentPresenter Grid.Column="2"
                                          Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"
                                          FontFamily="{StaticResource BodyFont}"
                                          FontSize="{StaticResource BodySize}"
                                          Foreground="{StaticResource Text}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.pref /template/ Path#Tick">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="CheckBox.pref /template/ Border#Ring">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="CheckBox.pref:focus-visible /template/ Border#Ring">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="CheckBox.pref:pointerover /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="CheckBox.pref:checked /template/ Border#Box">
            <Setter Property="Background" Value="{StaticResource Volt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="CheckBox.pref:checked /template/ Path#Tick">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- ══ List view (§6) ══════════════════════════════════════════════
             "Same data, no art dependency… 44px rows, Surface ground, Line
             rules, Volt selection edge." Sortable headers write the same sort
             state the command-bar menu does. -->
        <Style Selector="Button.colhead">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.colhead /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.colhead:pointerover TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style Selector="ListBox.rows">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#801D3437"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>

        <!-- Density slider — chrome only, so it stays quiet next to the art. -->
        <Style Selector="Slider.density">
            <Setter Property="Width" Value="104"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="Slider.density /template/ Track#PART_Track RepeatButton#PART_DecreaseButton /template/ Border">
            <Setter Property="Background" Value="{StaticResource TextDim}"/>
            <Setter Property="Height" Value="2"/>
        </Style>
        <Style Selector="Slider.density /template/ Track#PART_Track RepeatButton#PART_IncreaseButton /template/ Border">
            <Setter Property="Background" Value="{StaticResource Line}"/>
            <Setter Property="Height" Value="2"/>
        </Style>
        <Style Selector="Slider.density /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource TextDim}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
        </Style>
        <Style Selector="Slider.density:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource Text}"/>
        </Style>

    </Window.Styles>

    <!-- OffScreenMargin is the maximised overhang: Windows sizes a maximised
         window past the work area by the resize border, and with the client
         area extended that overhang is ours to absorb. Without this the title
         bar and the first column of tiles are clipped the moment the window
         is maximised. -->
    <Panel Margin="{Binding $parent[Window].OffScreenMargin}">
    <Grid RowDefinitions="36,*">

        <!-- ══ TITLE BAR ═══════════════════════════════════════════════════
             Well, one step DARKER than Ground: the window opens on an unlit
             lip and the art is the first thing with light in it. The whole
             strip is the drag handle; the buttons stop the drag because
             Button marks the pointer press handled. -->
        <Border Grid.Row="0"
                Name="TitleBar"
                Background="{StaticResource Well}"
                PointerPressed="OnTitleBarPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- The mark is the app's own atom: two 2:3 capsules, one
                     behind the other. A hoard is a stack of these. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Spacing="9" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Canvas Width="16" Height="15" VerticalAlignment="Center">
                        <Border Canvas.Left="0" Canvas.Top="3"
                                Width="7" Height="11" CornerRadius="2"
                                Background="{StaticResource Line}"/>
                        <Border Canvas.Left="6" Canvas.Top="1"
                                Width="9" Height="13" CornerRadius="2"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource TextDim}"
                                BorderThickness="1"/>
                    </Canvas>
                    <TextBlock Classes="display-s"
                               FontSize="11"
                               LetterSpacing="1.5"
                               Foreground="{StaticResource TextDim}"
                               Text="HOARD"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Classes="wincontrol"
                            Click="OnMinimisePressed"
                            ToolTip.Tip="Minimise">
                        <Path Data="M 0,5.5 L 10,5.5"/>
                    </Button>
                    <Button Name="MaximiseButton"
                            Classes="wincontrol"
                            Click="OnMaximisePressed"
                            ToolTip.Tip="Maximise">
                        <Panel Width="11" Height="11">
                            <Path Name="MaximiseGlyph"
                                  Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"/>
                            <Path Name="RestoreGlyph"
                                  IsVisible="False"
                                  Data="M 2.5,2.5 L 2.5,0.5 L 10.5,0.5 L 10.5,8.5 L 8.5,8.5 M 0.5,2.5 L 8.5,2.5 L 8.5,10.5 L 0.5,10.5 Z"/>
                        </Panel>
                    </Button>
                    <Button Classes="wincontrol close"
                            Click="OnClosePressed"
                            ToolTip.Tip="Close">
                        <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5"/>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

    <!-- 220 rail · the library · the filter panel when it is open. The panel is
         a COLUMN, not an overlay, and it is on the RIGHT: the Filters toggle
         and Clear filters both live in the command bar's right cluster, and a
         panel on the far left put every control a full window away from the
         thing it operates.

         What that costs is the adjacency the panel used to have with the rail —
         they were one Surface with an internal rule, and the claim "the rail
         owns the bucket axis, the panel owns every other one" was made by them
         touching. That claim now gets made where it was always strongest: the
         cut bar, where the bucket is the first chip and drops like any other
         rule. See §11.1.

         The element order below is reading order — rail, library, panel — so
         §8's Tab walk goes left to right across the window and never doubles
         back. The panel's Grid.Column says where it sits; its position in this
         file says when it is reached. -->
    <Grid Grid.Row="1" ColumnDefinitions="220,*,Auto">

        <!-- ══ RAIL (220px) ════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,1,0">
            <!-- Interior: the rail's own right edge is a divider, not the
                 window's, so this scrollbar keeps its flush position. -->
            <ScrollViewer Classes="inner" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,20">

                    <!-- ── All games ─────────────────────────────────────────
                         The rail's first row and the app's launch state, which
                         until now had no name: clearing a bucket filter meant
                         clicking the row you were already on, which nothing
                         says and nobody finds.

                         This REPLACES the "606 TITLES" header that used to sit
                         here. That header and this row are the same number, and
                         §7 does not want it stated twice two rows apart — so the
                         one that also does something keeps it. The count moves
                         from Data 22 to the bucket rows' Data 11 on purpose: a
                         rail row that looks like a bucket behaves like a bucket,
                         and a 22px number would have read as a heading rather
                         than as a thing to click. The library size is still
                         legible at a glance from the top of the rail, and the
                         search box's placeholder still spells it out.

                         Same treatment as a bucket, from the same Button.bucket
                         style: hover fill, SurfaceRaised selection, the 2px Volt
                         edge bound to the row's own state (name scopes inside a
                         DataTemplate are why the buckets do it that way — this
                         row is not in a template, but it matches them so the two
                         cannot drift). -->
                    <Button Classes="bucket"
                            Classes.selected="{Binding Library.AllGames.IsSelected}"
                            Command="{Binding SelectBucketCommand}"
                            CommandParameter="{Binding Library.AllGames}"
                            ToolTip.Tip="Every title you own">
                        <Grid ColumnDefinitions="2,16,*,Auto,16">
                            <Border Grid.Column="0"
                                    Background="{StaticResource Volt}"
                                    IsVisible="{Binding Library.AllGames.IsSelected}"/>
                            <TextBlock Grid.Column="2"
                                       Classes="display-s"
                                       Text="{Binding Library.AllGames.RailLabel}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3"
                                       Classes="data"
                                       FontSize="11"
                                       Foreground="{StaticResource TextDim}"
                                       Text="{Binding Library.AllGames.CountText}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- The whole library, then the ways of cutting it. The rule
                         is the grouping: everything below it is a subset of the
                         row above it. -->
                    <Border Margin="16,10,16,10"
                            Height="1"
                            Background="{StaticResource Line}"/>

                    <ItemsControl ItemsSource="{Binding Library.Buckets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:BucketViewModel">
                                <Button Classes="bucket"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.rule="{Binding IsRule}"
                                        Opacity="{Binding RowOpacity}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectBucketCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="2,16,Auto,*,Auto,16">
                                        <!-- 2px Volt selection edge (§6). Driven
                                             from the row's own state, not from a
                                             `.selected Border#Edge` selector:
                                             names inside a DataTemplate live in
                                             their own scope, so such a selector
                                             silently matches nothing and the
                                             edge never appears. -->
                                        <Border Grid.Column="0"
                                                Background="{StaticResource Volt}"
                                                IsVisible="{Binding IsSelected}"/>
                                        <!-- The same edge in chrome grey: this
                                             bucket is a rule the open list
                                             carries, not the row you are on. -->
                                        <Border Grid.Column="0"
                                                Background="{StaticResource TextDim}"
                                                IsVisible="{Binding IsRule}"/>
                                        <!-- Flare pip: unread-carrying bucket ONLY. -->
                                        <Border Grid.Column="2"
                                                Width="7" Height="7" CornerRadius="4"
                                                Margin="0,0,8,0"
                                                Background="{StaticResource Flare}"
                                                BoxShadow="0 0 8 0 #B3FF4D93"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding ShowsFlarePip}"/>
                                        <TextBlock Grid.Column="3"
                                                   Classes="display-s"
                                                   Text="{Binding RailLabel}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4"
                                                   Classes="data"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextDim}"
                                                   Text="{Binding CountText}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── REVIEW ────────────────────────────────────────
                         The merge confirm queue (§6). Labelled with the
                         question it asks rather than with "merge": the user
                         reasons about games, not about records. The row is
                         permanent so the rail never reflows, but the COUNT
                         appears only when something is pending — a standing
                         zero here would be noise. -->
                    <Border Margin="16,22,16,8"
                            Padding="0,14,0,0"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0">
                        <TextBlock Classes="label"
                                   FontSize="10"
                                   LetterSpacing="1.4"
                                   Text="REVIEW"/>
                    </Border>
                    <Button Classes="bucket"
                            Classes.selected="{Binding IsMergeQueueVisible}"
                            Opacity="{Binding MergeQueue.RowOpacity}"
                            Command="{Binding ToggleMergeQueueCommand}"
                            ToolTip.Tip="Pairs that might be the same game">
                        <Grid ColumnDefinitions="2,16,*,Auto,16">
                            <Border Grid.Column="0"
                                    Background="{StaticResource Volt}"
                                    IsVisible="{Binding IsMergeQueueVisible}"/>
                            <TextBlock Grid.Column="2"
                                       Classes="display-s"
                                       Text="SAME GAME?"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3"
                                       Classes="data"
                                       FontSize="11"
                                       Foreground="{StaticResource TextDim}"
                                       Text="{Binding MergeQueue.PendingCountText}"
                                       IsVisible="{Binding MergeQueue.HasPending}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- ══ LISTS / LIVE LISTS ═══════════════════════════════
                         Two sections, and the heading is the whole of how the
                         two kinds are told apart. A list holds the games you put
                         in it; a live list holds the rules and finds them again
                         every time the library changes — which matters enough
                         that it has to be legible before the row is clicked.

                         Not a coloured dot beside the count, which was the
                         obvious move and the wrong one: the rail already has
                         exactly one dot, the Flare pip on "Patched since", and a
                         dot's meaning survives precisely as long as there is
                         only one of them (§5.2). A heading says it in words,
                         scales to any number of lists, and is legible to a
                         reader who cannot resolve a 7px mark at all (§8). -->
                    <Border Margin="16,22,16,8"
                            Padding="0,14,0,0"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0"
                            IsVisible="{Binding Library.Lists.ShowListsHeader}">
                        <TextBlock Classes="label"
                                   FontSize="10"
                                   LetterSpacing="1.4"
                                   Text="LISTS"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Library.Lists.Lists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="lists:GameListViewModel">
                                <Button Classes="listrow"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectListCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Name}">
                                    <Grid ColumnDefinitions="2,16,*,8,Auto,16">
                                        <Border Grid.Column="0"
                                                Background="{StaticResource Volt}"
                                                IsVisible="{Binding IsSelected}"/>
                                        <TextBlock Grid.Column="2"
                                                   Classes="body"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4"
                                                   Classes="data"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextDim}"
                                                   Text="{Binding CountText}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The empty state is a direction, not a mood (§7): both
                         routes in, in the order they are discoverable. -->
                    <TextBlock Margin="18,4,16,0"
                               Classes="body"
                               FontSize="12"
                               LineHeight="17"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextDim}"
                               IsVisible="{Binding Library.Lists.HasNoLists}"
                               Text="{Binding Library.Lists.EmptyMessageText}"/>

                    <Border Margin="16,20,16,8"
                            Padding="0,14,0,0"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0"
                            IsVisible="{Binding Library.Lists.HasLiveLists}">
                        <TextBlock Classes="label"
                                   FontSize="10"
                                   LetterSpacing="1.4"
                                   Text="LIVE LISTS"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Library.Lists.LiveLists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="lists:GameListViewModel">
                                <Button Classes="listrow"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectListCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding KindNote}">
                                    <Grid ColumnDefinitions="2,16,*,8,Auto,16">
                                        <Border Grid.Column="0"
                                                Background="{StaticResource Volt}"
                                                IsVisible="{Binding IsSelected}"/>
                                        <TextBlock Grid.Column="2"
                                                   Classes="body"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4"
                                                   Classes="data"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextDim}"
                                                   Text="{Binding CountText}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ MAIN ════════════════════════════════════════════════════════
             Two screens share the pane: the library, and the merge confirm
             queue the rail's REVIEW row opens. The command bar (search,
             density) belongs to the library, so the queue replaces the whole
             pane rather than sitting under controls that do not apply to it. -->
        <Panel Grid.Column="1">

        <Grid RowDefinitions="48,Auto,*" IsVisible="{Binding IsLibraryVisible}">

            <!-- ── Command bar ──────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1">
                  <!-- Search takes the slack; everything else is Auto. A Grid
                       satisfies its Auto columns before its star one, so the box is
                       the only thing that gives way when the filter panel takes 276px
                       out of the row — and the Filters toggle, the one control that
                       must never be unreachable because it is the way back, sits in
                       the Auto group on the right beside the sort it pairs with. -->
                  <Grid ColumnDefinitions="*,Auto" Margin="20,0" VerticalAlignment="Center">
                    <Grid Grid.Column="0" ColumnDefinitions="*,Auto" Margin="0,0,12,0">
                    <TextBox Name="SearchBox"
                             Grid.Column="0"
                             Classes="search"
                             MinWidth="130"
                             MaxWidth="360"
                             HorizontalAlignment="Stretch"
                             Text="{Binding Library.SearchText, Mode=TwoWay}"
                             Watermark="{Binding Library.SearchPlaceholder}"/>

                    <!-- Grid / list segmented toggle. -->

                      <!-- search · layout · density · display. One stack rather than
                           a column each: none of them competes for width, and the
                           transient selection controls can join the end without
                           moving the fixed ones. -->
                      <StackPanel Grid.Column="1" Orientation="Horizontal"
                                  Spacing="10" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Border
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}"
                            Background="{StaticResource Surface}"
                            ClipToBounds="True" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="seg"
                                    Classes.on="{Binding Library.IsGridView}"
                                    Command="{Binding Library.ShowGridViewCommand}"
                                    ToolTip.Tip="Grid">
                                <UniformGrid Rows="2" Columns="2" Width="13" Height="13">
                                    <Rectangle Width="5" Height="5" Margin="0,0,1,1"/>
                                    <Rectangle Width="5" Height="5" Margin="1,0,0,1"/>
                                    <Rectangle Width="5" Height="5" Margin="0,1,1,0"/>
                                    <Rectangle Width="5" Height="5" Margin="1,1,0,0"/>
                                </UniformGrid>
                            </Button>
                            <Button Classes="seg"
                                    Classes.on="{Binding !Library.IsGridView}"
                                    Command="{Binding Library.ShowListViewCommand}"
                                    ToolTip.Tip="List">
                                <StackPanel Width="13" Height="13" Spacing="3"
                                            VerticalAlignment="Center">
                                    <Rectangle Height="2" Width="13"/>
                                    <Rectangle Height="2" Width="13"/>
                                    <Rectangle Height="2" Width="13"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="label" FontSize="10" Text="DENSITY"
                               VerticalAlignment="Center"/>
                    <Slider Name="DensitySlider"
                            Classes="density"
                            Minimum="108" Maximum="200"
                            Value="{Binding Library.TileWidth, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Tile size"/>

                    <!-- The rule is the seam between two kinds of control.
                         Everything left of it is per-session (§4 remembers the
                         view mode, the order and the density for as long as the
                         process lives); everything right of it is written to
                         disk and true on the next launch. -->
                    <Border Width="1" Height="18" Margin="2,0"
                            Background="{StaticResource Line}"
                            VerticalAlignment="Center"/>

                    <!-- ── Display preferences (§8) ────────────────────────
                         §8's "settings toggle to disable the dormancy ramp
                         entirely" lives behind this rather than beside the
                         density slider, because it is not the same kind of
                         thing: density is a knob for the next five minutes,
                         this is a preference that persists. It also needs a
                         sentence of explanation, and there is nowhere in a row
                         of icons to put one. -->
                    <Button Name="DisplayButton" Classes="ctl"
                            ToolTip.Tip="Display preferences">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="body" FontSize="12"
                                       Foreground="{StaticResource TextDim}"
                                       Text="Display"/>
                            <Path Data="M 0,0 L 8,0 L 4,5 Z"
                                  Fill="{StaticResource TextDim}"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight"
                                    FlyoutPresenterClasses="prefs"
                                    Opened="OnDisplayFlyoutOpened">
                                <StackPanel Width="264" Spacing="8">
                                    <CheckBox Name="DimCoversToggle"
                                              Classes="pref"
                                              Content="Dim dormant covers"
                                              IsChecked="{Binding Display.DimDormantCovers, Mode=TwoWay}"/>
                                    <TextBlock Classes="body" FontSize="12"
                                               Margin="26,0,0,0"
                                               LineHeight="17"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextDim}"
                                               Text="Covers fade the longer a game sits unplayed. Off shows every cover at full colour — the unread dots and the rail counts carry the same signal."/>

                                    <Border Height="1" Margin="0,4"
                                            Background="{StaticResource Line}"/>

                                    <CheckBox Name="NonGameToggle"
                                              Classes="pref"
                                              Content="Show non-game entries"
                                              IsChecked="{Binding Display.ShowNonGameEntries, Mode=TwoWay}"/>
                                    <TextBlock Classes="body" FontSize="12"
                                               Margin="26,0,0,0"
                                               LineHeight="17"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextDim}"
                                               Text="Steam also carries tools, dedicated servers and soundtracks. They're hidden by default. Anything Steam hasn't told us the type of stays visible either way."/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Multi-select readout: §6 asks the list for multi-select,
                         so the count says what is picked. -->
                    <TextBlock Classes="data" FontSize="11"
                               Foreground="{StaticResource Volt}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Library.HasMultiSelection}"
                               Text="{Binding Library.SelectedCountText}"/>

                    <!-- §6's "bulk list assignment", and the grid's route in
                         too: one control, reading whichever selection is in
                         force — one tile in the grid, any number of rows in the
                         list. It names the number once there is more than one,
                         so the button and the thing it will do never disagree. -->
                    <Button Classes="ctl"
                            IsVisible="{Binding Library.HasSelection}"
                            Command="{Binding Library.BeginAddToListCommand}"
                            ToolTip.Tip="Put the selected titles in a list">
                        <TextBlock Classes="body" FontSize="12"
                                   Foreground="{StaticResource Volt}"
                                   Text="{Binding Library.AddToListLabel}"/>
                    </Button>
                      </StackPanel>
                    </Grid>

                    <!-- sort · filters. Filters is last because it is the rightmost
                         thing on the bar and the panel it opens is now the rightmost
                         thing in the window. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                Spacing="10" VerticalAlignment="Center">
                    <!-- Sort. The button face is the order in force; the menu
                         is the same state the list-view column headers write. -->
                    <Button Name="SortButton"
                            Classes="ctl" ToolTip.Tip="Sort order">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="body" FontSize="12"
                                       Foreground="{StaticResource TextDim}"
                                       Text="{Binding Library.SortLabel}"/>
                            <Path Data="M 0,0 L 8,0 L 4,5 Z"
                                  Fill="{StaticResource TextDim}"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft"
                                    FlyoutPresenterClasses="sortmenu">
                                <ItemsControl ItemsSource="{Binding Library.SortOptions}"
                                              MinWidth="176">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:SortOptionViewModel">
                                            <Button Classes="sortitem" Click="OnSortItemClick">
                                                <Grid ColumnDefinitions="14,*">
                                                    <!-- Volt marks the active order —
                                                         selection, which is exactly
                                                         what Volt is for (§2). -->
                                                    <Border Grid.Column="0"
                                                            Width="6" Height="6" CornerRadius="3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource Volt}"
                                                            IsVisible="{Binding IsSelected}"/>
                                                    <TextBlock Grid.Column="1" Classes="body"
                                                               Text="{Binding Label}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- ── Filters ──────────────────────────────────────────
                         The panel opens BESIDE THE RAIL rather than over the
                         grid: the counts next to each option are only worth
                         having if you can watch them move as you tick things,
                         which means the panel and the result have to be on
                         screen together. The badge is how many rules are in
                         force, so a closed panel is never a silent one. -->
                    <Button Name="FiltersButton"
                            Classes="ctl"
                            Classes.on="{Binding Library.Filters.IsOpen}"
                            Command="{Binding Library.Filters.ToggleCommand}"
                            ToolTip.Tip="Filter by genre, tag, store and more">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <!-- A funnel, drawn rather than lettered: it is the
                                 one control here that has a universally read
                                 glyph, and the row is already three words wide. -->
                            <Path Data="M 0,0 L 11,0 L 6.7,5 L 6.7,10 L 4.3,8.4 L 4.3,5 Z"
                                  Fill="{StaticResource TextDim}"
                                  VerticalAlignment="Center"/>
                            <TextBlock Classes="body" FontSize="12"
                                       Foreground="{StaticResource TextDim}"
                                       Text="Filters"/>
                            <Border Padding="5,0"
                                    MinWidth="17"
                                    Height="16"
                                    CornerRadius="8"
                                    Background="{StaticResource Volt}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Library.Filters.HasSelection}">
                                <TextBlock Classes="data-s"
                                           Foreground="{StaticResource VoltInk}"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding Library.Filters.ActiveCountText}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                  </Grid>
            </Border>

            <!-- ── Cut bar / prompt ─────────────────────────────────────
                 Auto-height so it takes no room at all when the grid is showing
                 the whole library. -->
            <views:ActionBarView Grid.Row="1" DataContext="{Binding Library}"/>

            <!-- ── Content ──────────────────────────────────────────────── -->
            <Panel Grid.Row="2">

                <!-- Cover wall. -->
                <ScrollViewer Name="GridScroll"
                              IsVisible="{Binding Library.ShowGrid}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0">
                    <!-- The wall owns its own geometry: it divides the width it
                         is measured with, so the column count it realizes
                         against and the column count it arranges with are the
                         same number, from the same expression, every pass. That
                         is the whole reason it exists instead of ItemsRepeater
                         + UniformGridLayout — see CoverWall's remarks. -->
                    <!-- 24 on the right, not 20: Fluent's scrollbar overlays the
                         content rather than reserving a column, so the gutter has
                         to clear the bar AND the §9.1 resize inset (12 + 10).
                         At 20 the bar clipped two pixels off the last tile and
                         off the list's idle column. -->
                    <views:CoverWall Name="TileWall"
                                     Margin="20,20,24,20"
                                     Spacing="16"
                                     CellAspect="1.5"
                                     MinCellWidth="{Binding Library.TileWidth}"
                                     ItemsSource="{Binding Library.VisibleTiles}">
                        <views:CoverWall.ItemTemplate>
                            <DataTemplate DataType="vm:GameTileViewModel">
                                <views:GameTileView PointerPressed="OnTilePressed"/>
                            </DataTemplate>
                        </views:CoverWall.ItemTemplate>
                    </views:CoverWall>
                </ScrollViewer>

                <!-- ── List view (§6) ──────────────────────────────────────
                     The power-user view: same data, no art dependency, so it
                     stays readable before a single cover has downloaded.
                     Virtualized (ListBox's VirtualizingStackPanel) because 616
                     rows is the normal case, not the stress case. -->
                <Grid RowDefinitions="30,*" IsVisible="{Binding Library.ShowList}">

                    <!-- Column headers. Clicking one writes the shared sort
                         state; clicking the active one flips its direction. -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="2,18,*,84,104,92,24">
                            <Button Grid.Column="2" Classes="colhead"
                                    Command="{Binding Library.SortByTitleCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="label" FontSize="10" Text="TITLE"/>
                                    <Path Data="M 0,5 L 8,5 L 4,0 Z" Fill="{StaticResource Volt}"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding Library.ShowTitleSortUp}"/>
                                    <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{StaticResource Volt}"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding Library.ShowTitleSortDown}"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Column="3" Classes="label" FontSize="10"
                                       Text="STORE" VerticalAlignment="Center"/>

                            <Button Grid.Column="4" Classes="colhead"
                                    HorizontalContentAlignment="Right"
                                    Command="{Binding Library.SortByPlaytimeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Right">
                                    <Path Data="M 0,5 L 8,5 L 4,0 Z" Fill="{StaticResource Volt}"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding Library.ShowPlaytimeSortUp}"/>
                                    <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{StaticResource Volt}"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding Library.ShowPlaytimeSortDown}"/>
                                    <TextBlock Classes="label" FontSize="10" Text="PLAYTIME"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="5" Classes="colhead"
                                    HorizontalContentAlignment="Right"
                                    Command="{Binding Library.SortByIdleCommand}"
                                    ToolTip.Tip="Time since you last played">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Right">
                                    <Path Data="M 0,5 L 8,5 L 4,0 Z" Fill="{StaticResource Volt}"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding Library.ShowIdleSortUp}"/>
                                    <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{StaticResource Volt}"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding Library.ShowIdleSortDown}"/>
                                    <TextBlock Classes="label" FontSize="10" Text="IDLE"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             Name="ListRows"
                             Classes="rows"
                             SelectionMode="Multiple"
                             ItemsSource="{Binding Library.VisibleTiles}"
                             SelectedItem="{Binding Library.SelectedTile, Mode=TwoWay}"
                             SelectionChanged="OnListSelectionChanged"
                             DoubleTapped="OnListDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:GameTileViewModel">
                                <Border BorderBrush="{StaticResource Line}"
                                        BorderThickness="0,0,0,1"
                                        Height="44">
                                    <Grid ColumnDefinitions="2,18,*,84,104,92,24">
                                        <!-- 2px Volt selection edge (§6), bound to
                                             the row's own state for the same
                                             name-scope reason as the rail. -->
                                        <Border Grid.Column="0"
                                                Background="{StaticResource Volt}"
                                                IsVisible="{Binding IsSelected}"/>
                                        <!-- The unread dot: Flare, here and on
                                             the tile and the rail pip. Nowhere
                                             else, ever. -->
                                        <Border Grid.Column="1"
                                                Width="8" Height="8" CornerRadius="4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="6,0,0,0"
                                                Background="{StaticResource Flare}"
                                                BoxShadow="0 0 8 0 #B3FF4D93"
                                                IsVisible="{Binding HasUnread}"
                                                ToolTip.Tip="Patched since you played"/>
                                        <TextBlock Grid.Column="2"
                                                   Classes="body-l"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontWeight="Bold"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="3"
                                                   Classes="body" FontSize="11"
                                                   Foreground="{StaticResource TextDim}"
                                                   Text="{Binding StoreBadge}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4"
                                                   Classes="data"
                                                   Text="{Binding PlaytimeText}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5"
                                                   Classes="data"
                                                   Foreground="{StaticResource TextDim}"
                                                   Text="{Binding IdleText}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Empty states are directions, not moods (§7). -->
                <Border IsVisible="{Binding Library.ShowEmpty}" Padding="32">
                    <TextBlock Classes="body-l"
                               MaxWidth="440"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="22"
                               Foreground="{StaticResource TextDim}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{Binding Library.EmptyMessage}"/>
                </Border>

            </Panel>
        </Grid>

        <!-- ── Merge confirm queue (§5.3 step 3 / §6) ────────────────────── -->
        <views:MergeQueueView Name="MergeQueue"
                              DataContext="{Binding MergeQueue}"
                              IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsMergeQueueVisible}"/>

        </Panel>

        <!-- ══ FILTER PANEL ════════════════════════════════════════════════
             Last in the file and last in the Tab walk, because it is the
             rightmost thing on screen. Its own edges are described in
             FilterPanelView. -->
        <views:FilterPanelView Grid.Column="2"
                               Name="FilterPanel"
                               DataContext="{Binding Library.Filters}"
                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsFilterPanelVisible}"/>

        <!-- ── Game detail modal (§5.3's other half) ─────────────────────────
             Spans the rail as well as the pane: it is a modal, so nothing
             behind it is clickable while it is up. Enter on the selection or a
             double click opens it; Escape or the scrim closes it. -->
        <views:GameDetailsView Name="DetailsPanel"
                               Grid.Column="0" Grid.ColumnSpan="3"
                               DataContext="{Binding Library.Details}"
                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Library.IsDetailsOpen}"/>

    </Grid>
    </Grid>
    </Panel>

</Window>
