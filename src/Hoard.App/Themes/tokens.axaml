<!--
    Design tokens — Game Library Manager
    Merge into App.axaml:

        <Application.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceInclude Source="avares://Hoard/Themes/tokens.axaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Application.Resources>

    Fonts must be bundled as AvaloniaResource. All three are SIL OFL.
    Do not fall back to system fonts — the display face is load-bearing.
-->
<!-- TODO(data-layer M0): added xmlns:sys and qualified <sys:TimeSpan> below —
     bare <TimeSpan> does not resolve in the Avalonia namespace (AVLN2000). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!-- ══ Colour ══════════════════════════════════════════════════════════
         The neutral family is a single dark green-teal ink, stepped five
         times. It is not grey: teal reads as that ink turned up to full
         voltage — continuous with the room, which is right for a colour that
         marks state the interface always has (selection, recency). Flare is
         the only hue in the palette that the room cannot produce, which is
         exactly what an unread marker has to be.

         Flare is the rarest colour in the app. It marks ONLY unread updates.
         The moment it becomes a generic accent, the badge stops meaning
         anything and the product loses its point.
    -->
    <!-- ⚠ EVERY THEMEABLE BRUSH IS DECLARED Color="#RRGGBB" AS AN ATTRIBUTE,
         never as element content. The two forms look identical and are not:
         Avalonia's XAML compiler constant-folds

             <SolidColorBrush x:Key="X">#16282A</SolidColorBrush>

         into an ImmutableSolidColorBrush, whose Color cannot be written. The
         attribute form

             <SolidColorBrush x:Key="X" Color="#16282A"/>

         stays a real SolidColorBrush. ThemeService changes themes by writing
         Color on the brush objects the views already resolved (StaticResource
         looks up once and never again), so a folded brush is a token the theme
         system silently cannot reach — the window half repaints and the
         leftovers look like a rendering fault rather than a bug. Measured, not
         assumed: the first build of the theme system had thirty-five of them.
    -->
    <Color x:Key="WellColor">#050D0E</Color>
    <Color x:Key="GroundColor">#0F1C1E</Color>
    <Color x:Key="SurfaceColor">#16282A</Color>
    <Color x:Key="SurfaceRaisedColor">#1D3437</Color>
    <Color x:Key="LineColor">#2B4A4C</Color>
    <Color x:Key="TextColor">#F0EDE7</Color>
    <Color x:Key="TextDimColor">#8FA5A0</Color>
    <Color x:Key="FlareColor">#FF4D93</Color>
    <Color x:Key="VoltColor">#4DE8C2</Color>
    <Color x:Key="AmberColor">#FFB63D</Color>
    <Color x:Key="AzureColor">#57A8F0</Color>
    <Color x:Key="DangerColor">#E04B45</Color>

    <SolidColorBrush x:Key="Well"          Color="{StaticResource WellColor}"/>
    <SolidColorBrush x:Key="Ground"        Color="{StaticResource GroundColor}"/>
    <SolidColorBrush x:Key="Surface"       Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="Line"          Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Text"          Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextDim"       Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="Flare"         Color="{StaticResource FlareColor}"/>
    <SolidColorBrush x:Key="Volt"          Color="{StaticResource VoltColor}"/>
    <SolidColorBrush x:Key="Amber"         Color="{StaticResource AmberColor}"/>
    <SolidColorBrush x:Key="Azure"         Color="{StaticResource AzureColor}"/>
    <!-- Destructive affordances only. Today that is one control: the window
         close button's hover fill. Hue 2°, far enough from Flare's 336° that
         a red the size of a caption button can never be mistaken for a 10px
         unread dot. -->
    <SolidColorBrush x:Key="Danger"        Color="{StaticResource DangerColor}"/>

    <!-- Ink for text sitting ON Volt (the Play button, "Same game"). Dark
         enough to read at 9.9:1, and green-teal rather than black so the
         button looks lit from inside rather than punched out. -->
    <SolidColorBrush x:Key="VoltInk" Color="#0C2A24"/>
    <SolidColorBrush x:Key="VoltHover" Color="#6FEDCE"/>
    <SolidColorBrush x:Key="VoltPress" Color="#3BD1AC"/>

    <!-- ══ The rest of the family, named ══════════════════════════════════
         These were literal hexes scattered through six views until the theme
         system needed to reach them. A colour written inline is a colour no
         theme can change, and the failure is silent: the window half repaints
         and the leftovers look like a rendering fault. Every one of them is
         "some role at N%" or "one step past a step", so they are DERIVED from
         the palette in HoardTheme.Tokens rather than restated per theme. -->

    <!-- One step above SurfaceRaised: a selected menu item, a pressed caption
         button. SurfaceRaised on SurfaceRaised is no step at all. -->
    <SolidColorBrush x:Key="SurfaceHigh" Color="#254042"/>
    <!-- The quietest ink that is still ink: watermarks, disabled arrows. -->
    <SolidColorBrush x:Key="TextFaint" Color="#5A8286"/>

    <SolidColorBrush x:Key="DangerHover" Color="#EF645E"/>
    <SolidColorBrush x:Key="DangerPress" Color="#B33A35"/>
    <SolidColorBrush x:Key="DangerInk" Color="#FFF2EF"/>

    <!-- Volt at 30 / 24 / 40 %: text selection, a soft selection wash, a
         half-lit edge. Never a new colour, always the same one turned down. -->
    <SolidColorBrush x:Key="VoltSelection" Color="#4D4DE8C2"/>
    <SolidColorBrush x:Key="VoltSelectionSoft" Color="#3D4DE8C2"/>
    <SolidColorBrush x:Key="VoltEdgeSoft" Color="#664DE8C2"/>

    <!-- Flare at 70 / 85 %. Still only ever on an unread marker (§5.2). -->
    <SolidColorBrush x:Key="FlareSoft" Color="#B3FF4D93"/>
    <SolidColorBrush x:Key="FlareGlow" Color="#D9FF4D93"/>

    <SolidColorBrush x:Key="LineSoft" Color="#992B4A4C"/>
    <SolidColorBrush x:Key="SurfaceRaisedHalf" Color="#801D3437"/>
    <SolidColorBrush x:Key="SurfaceRaisedGhost" Color="#1F1D3437"/>
    <SolidColorBrush x:Key="SurfaceRaisedFaint" Color="#141D3437"/>
    <SolidColorBrush x:Key="GroundVeil" Color="#4D0F1C1E"/>
    <!-- The detail modal's scrim (§9): the same unlit tone as the caption. -->
    <SolidColorBrush x:Key="ModalScrim" Color="#D6050D0E"/>

    <!-- Hover overlay scrim on cover tiles (§5.3): soft top edge, then Ground
         at 92% across the bottom third so the facts read over any art. -->
    <LinearGradientBrush x:Key="TileScrim" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0"    Color="#000F1C1E"/>
        <GradientStop Offset="0.35" Color="#EB0F1C1E"/>
        <GradientStop Offset="1"    Color="#EB0F1C1E"/>
    </LinearGradientBrush>

    <!-- ══ Window chrome ══════════════════════════════════════════════════
         The app draws its own title bar (ExtendClientAreaToDecorationsHint),
         so the first inch of the window stops being a light Windows caption
         bar sitting on a dark UI. Well is DARKER than Ground on purpose: the
         chrome is a stage, and the platform habit of a lighter caption strip
         puts the brightest band in the window above the art. Inverting it
         makes cover art the first thing on screen with any light in it.
    -->
    <x:Double x:Key="TitleBarHeight">36</x:Double>
    <x:Double x:Key="WindowButtonWidth">46</x:Double>

    <!-- ══ The four grounds ═══════════════════════════════════════════════
         Which surface may admit the desktop, and which may not. This replaces
         the caption-only Mica rule and resolves design-system.md §13 gap 7.

         The old rule was reached by a correct measurement and a wrong
         conclusion. TextDim on SurfaceRaised at 85% over white is 3.1:1, under
         AA — so translucency was confined to the 36px caption, where it is
         effectively invisible. What that sum actually proves is narrower than
         it looked: it proves you cannot take an ink CHOSEN FOR AN OPAQUE GROUND
         and subtract alpha from it. Transparency mode therefore has its own
         token set — darker surface inks, a brighter dim ink — and lands ABOVE
         the opaque numbers rather than under them, even against a pure-white
         backdrop. HoardTheme carries the values; ThemeContrastTests carries the
         proof.

           ShellGround   the whole client area below the caption. Opaque Ground
                         normally; NOTHING at all in transparency mode, because
                         the columns over it paint their own — which is what
                         lets the rail be see-through without the window
                         painting an opaque field behind it first.
           WallGround    the cover wall, the merge queue, the settings panes.
                         OPAQUE IN BOTH MODES. §1 says the art is the interface,
                         and a wallpaper behind six hundred capsules is a second
                         image competing with all of them; §5.4's two-layer
                         dormancy cross-fade also needs the ground under a tile
                         to be the ground it was calibrated against.
           ChromeGround  the command bar and the cut bar.
           ChromeRaised  a rail or panel row's hover and selection fill. Opaque,
                         it is the ordinary Surface -> SurfaceRaised step.
                         Translucent, a DARKER ink over an already-translucent
                         rail composites downwards and the raised row comes out
                         darker than its neighbour — so the step becomes a 10%
                         veil of the theme's own Text, which lifts whatever is
                         under it on every backdrop. Elevation stays relative,
                         which is what §6 says it is.
           TileGround    under the art stack inside a tile, so a cover that has
                         decoded one of its two dormancy layers and not the
                         other cannot show the window through the gap.

         Surface and Well themselves carry the alpha in transparency mode, so
         the rail, the filter panel and the caption need no separate keys.
         Popovers do NOT: a flyout is its own popup root and never receives the
         window's backdrop, so a translucent fill there would sample the
         application rather than the desktop and give a different answer at
         every position. They keep SurfaceRaised, opaque, in both modes.

         Every value here is written at runtime by ThemeService. What is
         declared is the OPAQUE state on the default theme, because that is the
         state that is correct on every host — a machine where none of this
         works needs nothing to go right in order to look deliberate. -->
    <SolidColorBrush x:Key="ShellGround" Color="#0F1C1E"/>
    <SolidColorBrush x:Key="CaptionFill" Color="#050D0E"/>
    <SolidColorBrush x:Key="ChromeSurface" Color="#16282A"/>
    <SolidColorBrush x:Key="WallGround" Color="#0F1C1E"/>
    <SolidColorBrush x:Key="ChromeGround" Color="#0F1C1E"/>
    <SolidColorBrush x:Key="ChromeRaised" Color="#1D3437"/>
    <SolidColorBrush x:Key="TileGround" Color="#0F1C1E"/>

    <!-- ══ Scrollbars ═════════════════════════════════════════════════════
         Fluent's ScrollBar theme is kept — its rest/expanded behaviour is
         good — and only repainted, by overriding the keys its template reads.
         Application.Resources outranks Application.Styles in Avalonia's
         lookup, so these win over the theme's own values without a template
         fork. The thumb is neutral, never Volt: a scrollbar is chrome, and
         spending the selection colour on it would make every scroll position
         look like a selection.
    -->
    <x:Double x:Key="ScrollBarSize">12</x:Double>

    <!-- The strip along the window edge that the OS resize border owns.
         With the client area extended over the decorations (§9) Windows still
         hit-tests the outer few pixels as HTRIGHT/HTBOTTOM before the client
         area ever sees the pointer — so a scrollbar flush to the edge is a
         control you cannot click. Nothing interactive may live inside this
         inset; scrollbars at the window edge carry it as a margin.
         10 = the 8px Windows resize frame (SM_CXFRAME + SM_CXPADDEDBORDER) with
         2px of slack, measured against this window rather than assumed. -->
    <Thickness x:Key="ScrollBarEdgeInset">0,0,10,10</Thickness>
    <!-- Fluent binds this to Rectangle.StrokeThickness, which is a double —
         a Thickness here type-casts at runtime, not at build. -->
    <x:Double x:Key="ScrollBarTrackBorderThemeThickness">0</x:Double>

    <SolidColorBrush x:Key="ScrollBarBackground">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#D9050D0E"/>
    <SolidColorBrush x:Key="ScrollBarBorderBrush">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarForeground" Color="#8FA5A0"/>
    <SolidColorBrush x:Key="ScrollBarTrackFill">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#D9050D0E"/>
    <SolidColorBrush x:Key="ScrollBarTrackStroke">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver">Transparent</SolidColorBrush>

    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#4E7679"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#6C9498"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#8FA5A0"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="#22393B"/>
    <Color x:Key="ScrollBarThumbBackgroundColor">#6C9498</Color>

    <!-- Fluent's resting thumb is a 2px hairline, which on a 606-tile wall is
         a scroll position you have to hunt for. Widened to 4px at rest; the
         theme still swells it to the full 12 on hover. -->
    <ScaleTransform x:Key="VerticalSmallScrollThumbScaleTransform" ScaleX="0.34" ScaleY="1"/>
    <ScaleTransform x:Key="HorizontalSmallScrollThumbScaleTransform" ScaleX="1" ScaleY="0.34"/>

    <SolidColorBrush x:Key="ScrollBarButtonBackground">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundDisabled">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarButtonBorderBrush">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarButtonBorderBrushPointerOver">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarButtonBorderBrushPressed">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarButtonBorderBrushDisabled">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#5A8286"/>
    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="#8FA5A0"/>
    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="#F0EDE7"/>
    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundDisabled" Color="#22393B"/>

    <!-- ══ Dormancy ramp ══════════════════════════════════════════════════
         Consumed by the cover renderer. Clamped floor is deliberate: a cover
         you cannot identify is a cover you cannot choose. Colour-agnostic —
         untouched by the palette revision.
    -->
    <x:Double x:Key="DormancySatFloor">0.22</x:Double>
    <x:Double x:Key="DormancyBrightFloor">0.68</x:Double>
    <x:Double x:Key="DormancyHueDegrees">-6</x:Double>
    <x:Double x:Key="DormancyFullMonths">36</x:Double>
    <sys:TimeSpan x:Key="HoverRestoreDuration">0:0:0.140</sys:TimeSpan>

    <!-- ══ Type ═══════════════════════════════════════════════════════════
         All three faces are bundled TTFs under Assets/Fonts (AvaloniaResource).
         No system-font fallback: the display face is load-bearing.

         TODO(avalonia-ui M0): §3 asks for Bricolage at `wdth` 105–110, but
         Avalonia 11.x exposes no variable-axis API (FontFeatures is HarfBuzz
         OpenType *features*, not fvar axes) and renders a variable TTF at its
         default instance — which made every display style come out light. The
         bundled faces are therefore the STATIC instances (Bricolage Bold 700,
         Jakarta 400/500/600). Bricolage's real `wdth` axis is 75–100, so the
         static Bold sits at wdth 100 — the widest the face has, and what the
         mock's clamped `wdth 105` actually renders in a browser. -->

    <FontFamily x:Key="DisplayFont">avares://Hoard/Assets/Fonts#Bricolage Grotesque</FontFamily>
    <FontFamily x:Key="BodyFont">avares://Hoard/Assets/Fonts#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="DataFont">avares://Hoard/Assets/Fonts#IBM Plex Mono</FontFamily>

    <x:Double x:Key="DisplayLSize">22</x:Double>
    <x:Double x:Key="DisplaySSize">12</x:Double>
    <x:Double x:Key="BodyLSize">15</x:Double>
    <x:Double x:Key="BodySize">13</x:Double>
    <x:Double x:Key="LabelSize">11</x:Double>
    <x:Double x:Key="DataSize">12</x:Double>
    <x:Double x:Key="DataSSize">10</x:Double>

    <!-- ══ Spacing (4px base) ═════════════════════════════════════════════ -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>
    <x:Double x:Key="Space12">48</x:Double>

    <!-- ══ Geometry ═══════════════════════════════════════════════════════ -->
    <x:Double x:Key="RailWidth">220</x:Double>
    <x:Double x:Key="CommandBarHeight">48</x:Double>
    <x:Double x:Key="TileWidth">148</x:Double>       <!-- 2:3, matches 600x900 capsule -->
    <x:Double x:Key="TileHeight">222</x:Double>
    <x:Double x:Key="TileGutter">16</x:Double>
    <x:Double x:Key="TileMinWidth">108</x:Double>    <!-- density slider bounds -->
    <x:Double x:Key="TileMaxWidth">200</x:Double>
    <x:Double x:Key="ListRowHeight">44</x:Double>
    <x:Double x:Key="BadgeSize">10</x:Double>
    <CornerRadius x:Key="RadiusTile">6</CornerRadius>
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <Thickness x:Key="SelectionEdge">2,0,0,0</Thickness>

    <!-- ══ Text styles ════════════════════════════════════════════════════ -->
    <!-- TODO(data-layer M0): two mechanical fixes to make this compile as a
         ResourceDictionary include (AXN0002 / AVLN3000):
         1. removed the redundant xmlns re-declaration on this element
            (Avalonia only allows xmlns on the root);
         2. gave the Styles block x:Key="TextStyles" — a ResourceDictionary
            cannot hold an unkeyed child. App.axaml.cs adds it to
            Application.Styles at startup, so selectors behave as authored. -->
    <Styles x:Key="TextStyles">

        <!-- ── Why `:is(TextBlock)` and not `TextBlock` ─────────────────────
             An Avalonia type selector matches the EXACT type, so a bare
             `TextBlock.body` silently skips SelectableTextBlock — which derives
             from TextBlock and is what the detail view uses so titles, summaries
             and install paths can be selected and copied. The result was not a
             build error but unstyled text: system font, wrong size, wrong ink.
             `:is()` matches the subtree, so one style covers both, and a
             selectable line is indistinguishable from a static one. -->

        <Style Selector=":is(TextBlock).display-l">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{StaticResource DisplayLSize}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style Selector=":is(TextBlock).display-s">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{StaticResource DisplaySSize}"/>
            <Setter Property="LetterSpacing" Value="0.72"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style Selector=":is(TextBlock).body-l">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="{StaticResource BodyLSize}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style Selector=":is(TextBlock).body">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style Selector=":is(TextBlock).label">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource LabelSize}"/>
            <Setter Property="LetterSpacing" Value="0.44"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>

        <!-- Every number in the app. tnum is mandatory in list view. -->
        <Style Selector=":is(TextBlock).data">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="{StaticResource DataSize}"/>
            <Setter Property="FontFeatures" Value="tnum"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style Selector=":is(TextBlock).data-s">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="{StaticResource DataSSize}"/>
            <Setter Property="FontFeatures" Value="tnum"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>

        <!-- Selection ink for copyable text. Volt at 30%: the selection colour
             the search box already uses, so "this text is picked" looks the same
             wherever the user does it. -->
        <Style Selector="SelectableTextBlock">
            <Setter Property="SelectionBrush" Value="{StaticResource VoltSelection}"/>
            <Setter Property="SelectionForegroundBrush" Value="{StaticResource Text}"/>
        </Style>

        <!-- ══ Focus — accessibility floor, not optional ══════════════════ -->
        <Style Selector=":is(Control):focus-visible">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border BorderBrush="{StaticResource Volt}"
                            BorderThickness="2"
                            Margin="-2"
                            CornerRadius="{StaticResource RadiusControl}"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>

    </Styles>

</ResourceDictionary>
