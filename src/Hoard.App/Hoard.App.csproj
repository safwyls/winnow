<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- avares:// URIs in tokens.axaml address the assembly as "Hoard" (design doc: binary `hoard`). -->
    <AssemblyName>Hoard</AssemblyName>
    <RootNamespace>Hoard.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <!-- No Avalonia.Controls.ItemsRepeater. Its UniformGridLayout charges every
         item in a row for a trailing gutter when it computes items-per-line for
         the scroll anchor, but packs rows greedily when it places them, so §4's
         flush-row geometry made the two disagree by one column at every window
         width. The cover wall is Views/CoverWall now — see its remarks and
         docs/spikes/avalonia-dormancy-rendering.md. -->
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hoard.Core\Hoard.Core.csproj" />
    <ProjectReference Include="..\Hoard.Covers\Hoard.Covers.csproj" />
    <ProjectReference Include="..\Hoard.Covers.Igdb\Hoard.Covers.Igdb.csproj" />
    <ProjectReference Include="..\Hoard.Data\Hoard.Data.csproj" />
    <ProjectReference Include="..\Hoard.Enrich.Igdb\Hoard.Enrich.Igdb.csproj" />
    <ProjectReference Include="..\Hoard.Enrich.Steam\Hoard.Enrich.Steam.csproj" />
    <ProjectReference Include="..\Hoard.Enrich.Updates\Hoard.Enrich.Updates.csproj" />
    <ProjectReference Include="..\Hoard.Ingest.Steam\Hoard.Ingest.Steam.csproj" />
    <ProjectReference Include="..\Hoard.Resolve\Hoard.Resolve.csproj" />
  </ItemGroup>

</Project>


