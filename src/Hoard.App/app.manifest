<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Hoard.app"/>

  <!--
    This file is a PREREQUISITE of the embedded-browser sign-in, not a nicety.

    Avalonia's NativeControlHost refuses to create a child window for a native
    control when the running process declares no supported OS list, and the
    refusal is its own guard rather than WebView2's — it fires on the first
    layout pass, before any browser code runs:

        System.InvalidOperationException: Unable to create child window for
        native control host. Application manifest with supported OS list might
        be required.
           at Avalonia.Win32.Win32NativeControlHost.DumbWindow..ctor(...)

    Hoard had no manifest at all until M4.6, which is why this arrived with the
    sign-in window rather than with the app. Confirmed in the spike by hitting
    the exception and then fixing it by adding exactly this
    (docs/spikes/embedded-auth.md section 2a).
  -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11. GUID per Microsoft's published application-manifest
           compatibility list; 10 and 11 share one. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        Per-monitor v2, which is what Avalonia expects and what the browser host
        needs: WebView2's Bounds are physical pixels while Avalonia lays out in
        device-independent units, so the two only agree if the process reports a
        real per-monitor scale factor. Under system DPI awareness a browser
        dragged to a second monitor is scaled by the OS into a blur.
      -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
    </windowsSettings>
  </application>
</assembly>
