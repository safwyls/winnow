<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Winnow.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Migrations are append-only versioned .sql scripts, embedded and run by DbUp. -->
    <EmbeddedResource Include="Migrations\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="dbup-sqlite" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- MergeUndoTests compares the journal's table list against the
         merge executor's cascade tripwire, and both are internal. -->
    <InternalsVisibleTo Include="Winnow.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Winnow.Core\Winnow.Core.csproj" />
  </ItemGroup>

</Project>
