<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A portable TFM lets Winnow.App reference this project on every platform.
         WebView2 and native calls are Windows-only and guarded at runtime.
         A net10.0-windows target would also force the app to target Windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Winnow.Auth.WebView</RootNamespace>

  </PropertyGroup>

  <!-- The WebView2 package's unused WPF/WinForms wrapper references are removed
       repo-wide by DropWebView2UiWrappers in Directory.Build.targets; see the
       rationale there. -->
  <ItemGroup>
    <!--
      Avalonia, for NativeControlHost and the window the browser lives in. NOT
      Avalonia.Desktop or the Fluent theme: this project renders a browser
      surface inside a window the host application has already started, and
      pulling in a second copy of the platform backends would be a way to end up
      with two of them.
    -->
    <PackageReference Include="Avalonia" Version="11.3.20" />

    <!-- Abstractions only. This project logs what happened, never what was
         captured; the host decides where the lines go, and the DI extension
         is the seam it is registered through. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />

    <!--
      Ships ~1.26 MB of DLLs, no browser. The Chromium engine is the OS-provided
      Evergreen WebView2 Runtime, present on this machine at 151.0.4129.107 with
      no install step. Its ABSENCE is handled rather than assumed away — see
      WebView2Runtime — because "Windows 11 always has it" is confirmed on
      exactly one machine.

      The alternative was CEF, measured at 123 MB for one architecture, on
      Chromium 120 (2023), dragging ReactiveUI into an app that uses
      CommunityToolkit.Mvvm. That is roughly 100x the size for a three-year-old
      browser engine.
    -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Core only. This project implements IInteractiveAuthPrompt and knows nothing
      about Epic, tokens, grants or storage — it puts a page in front of the user
      and returns a code. That is what keeps Winnow.Ingest.* free of any reference
      to Avalonia or WebView2 (§5.1).
    -->
    <ProjectReference Include="..\Winnow.Core\Winnow.Core.csproj" />
  </ItemGroup>

</Project>
