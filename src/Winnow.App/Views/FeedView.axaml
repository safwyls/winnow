<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Winnow.App.ViewModels"
             xmlns:views="using:Winnow.App.Views"
             x:Class="Winnow.App.Views.FeedView"
             x:DataType="vm:FeedViewModel">

    <!-- ══ The Feed (M8) ════════════════════════════════════════════════════
         Five sections in wrapping grids (FeedGrid.cs), no virtualization
         (~50 cards max). Flare on the unread dot only. -->

    <UserControl.Styles>

        <!-- Section: outline only, no fill (avoids a second opaque layer or
             the inverted elevation from §14.2). -->
        <Style Selector="Border.section">
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusPane}"/>
        </Style>

        <!-- The section heading. Bricolage, because a section title is the
             app's own voice making a claim — but not display-l, which is the
             screen's own name and has to outrank it. -->
        <Style Selector="TextBlock.shelf">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="{StaticResource PaneGround}">

        <!-- ══ Header ═══════════════════════════════════════════════════════
             Full-bleed rule distinguishes this from section headers. Count
             shown only once nonzero. -->
        <Border Grid.Row="0"
                Padding="24,20,24,18"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="7">
                    <TextBlock Classes="display-l" Text="{Binding Title}"/>

                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding ShowCandidates}">
                        <TextBlock Classes="data"
                                   Foreground="{StaticResource Text}"
                                   Text="{Binding CandidateCountText}"/>
                        <TextBlock Classes="body"
                                   Foreground="{StaticResource TextDim}"
                                   Text="games scored"/>
                    </StackPanel>

                    <!-- Confidence note from the scoring engine; hidden once
                         the library has enough history. -->
                    <TextBlock Classes="body" FontSize="12"
                               MaxWidth="640"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Foreground="{StaticResource TextDim}"
                               IsVisible="{Binding HasConfidenceNote}"
                               Text="{Binding ConfidenceNote}"/>
                </StackPanel>

                <!-- ══ Feed history toggle ══════════════════════════════════
                     Audit trail of feed responses; second undo route. -->
                <Button Grid.Column="1"
                        Classes="act quiet"
                        Padding="12,6"
                        FontSize="12"
                        VerticalAlignment="Top"
                        Command="{Binding ToggleHistoryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="{Binding HistoryLabel}"/>
                        <TextBlock Classes="data-s"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDim}"
                                   IsVisible="{Binding ShowHistoryCount}"
                                   Text="{Binding History.CountText}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══ Working / quiet / broken ═════════════════════════════════════
             One sentence, never blank. Points at the rail. -->
        <Border Grid.Row="1"
                Padding="32"
                IsVisible="{Binding ShowMessage}">
            <StackPanel MaxWidth="480" Spacing="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="body-l"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           LineHeight="22"
                           Foreground="{StaticResource TextDim}"
                           Text="{Binding Message}"/>
                <!-- Retry shown only on failure. -->
                <Button Classes="act quiet"
                        Content="Try again"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding CanRetry}"
                        Command="{Binding LoadCommand}"/>
            </StackPanel>
        </Border>

        <!-- ══ The sections ═════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      Name="Page"
                      IsVisible="{Binding ShowShelves}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Shelves}" Margin="24,24,24,32">

                <!-- 24 between islands vs 14 gutter inside, so section
                     spacing outranks card spacing. -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="24"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FeedShelfViewModel">
                        <Border Classes="section">
                            <StackPanel>

                                <!-- The section's header band. -->
                                <StackPanel Margin="18,15,18,14" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="shelf" Text="{Binding Title}"/>

                                        <!-- Section count, beside its name. Confirms
                                             a short section is complete. -->
                                        <TextBlock Classes="data-s"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding CountText}"/>
                                    </StackPanel>

                                    <!-- The section's own pitch, in the engine's
                                         words. It is the sentence the cards
                                         under it are all instances of. -->
                                    <TextBlock Classes="body"
                                               MaxWidth="720"
                                               HorizontalAlignment="Left"
                                               TextWrapping="Wrap"
                                               LineHeight="19"
                                               Foreground="{StaticResource TextDim}"
                                               Text="{Binding Blurb}"/>
                                </StackPanel>

                                <!-- Divider between section header and cards. -->
                                <Border Height="1" Background="{StaticResource Line}"/>

                                <ItemsControl ItemsSource="{Binding Cards}" Margin="16">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <!-- Column count derived from width. -->
                                            <views:FeedGrid MinItemWidth="420" Gutter="14"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FeedCardViewModel">
                                            <views:FeedCardView/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Feedback history: inline panel (not a popup; focus adorner needs
             the main tree). Every row shown so the loop is auditable. -->
        <ScrollViewer Grid.Row="1"
                      IsVisible="{Binding ShowHistory}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Border Classes="section" Margin="24,24,24,32">
                <StackPanel>

                    <StackPanel Margin="18,15,18,14" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="shelf" Text="{Binding History.Title}"/>
                            <TextBlock Classes="data-s"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding History.HasEntries}"
                                       Text="{Binding History.CountText}"/>
                        </StackPanel>
                        <TextBlock Classes="body"
                                   MaxWidth="720"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   LineHeight="19"
                                   Foreground="{StaticResource TextDim}"
                                   Text="Your feed responses, newest first."/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource Line}"/>

                    <!-- Empty state points at the controls (§7). -->
                    <TextBlock Classes="body"
                               Margin="18,16,18,18"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               Foreground="{StaticResource TextDim}"
                               IsVisible="{Binding History.ShowMessage}"
                               Text="{Binding History.Message}"/>

                    <ItemsControl ItemsSource="{Binding History.Entries}"
                                  IsVisible="{Binding History.HasEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FeedHistoryEntryViewModel">
                                <!-- A row, ruled off from the next. -->
                                <Border BorderBrush="{StaticResource LineSoft}"
                                        BorderThickness="0,0,0,1"
                                        Padding="18,12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding Title}"
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontWeight="Bold" FontSize="14"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource Text}"/>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <!-- Verdict kind in words, not
                                                     colour (§12.1). -->
                                                <TextBlock Classes="label"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextDim}"
                                                           Text="{Binding KindLabel}"/>
                                                <TextBlock Classes="body"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextDim}"
                                                           Text="{Binding StatusNote}"/>
                                                <TextBlock Classes="data"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextDim}"
                                                           IsVisible="{Binding HasStatusDate}"
                                                           Text="{Binding StatusDate}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Undo only on standing verdicts. -->
                                        <Button Grid.Column="1"
                                                Classes="act quiet"
                                                FontSize="12"
                                                Padding="14,6"
                                                VerticalAlignment="Center"
                                                Content="Undo"
                                                IsVisible="{Binding CanUndo}"
                                                Command="{Binding UndoCommand}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>
        </ScrollViewer>

    </Grid>

</UserControl>
