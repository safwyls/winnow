<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Winnow.App.ViewModels"
             x:Class="Winnow.App.Views.MergeQueueView"
             x:DataType="vm:MergeQueueViewModel">

    <!-- The Same Game screen. One pane, a 48px header carrying a
         three-segment control (REVIEW / EXPANSIONS / HISTORY), and three
         surfaces under it.

         REVIEW's unit is a GROUP, not a pair: every store entry that
         resolves to the same game is one card, so answering one member
         cannot leave a sibling card stale. Answering writes a link, which
         can be undone, so no card and no row is ever terminal.

         One card layout at every member count. The act is asymmetric
         (one parent, N children, one act, one undo), so the card is a
         primary capsule on the left and rows on the right. At exactly
         two members the single row draws its cover at 200x300 with the
         full open diff and no checkbox, so §6's two covers side by side
         survive literally.

         No Flare anywhere on this screen: Flare marks only unread updates
         and the bucket that counts them (§2). Amber carries attention,
         Volt stays on the primary answer and on selection. -->

    <UserControl.Resources>

        <!-- One row of the matcher's own breakdown. One template, used by the
             two-member card's open diff and by the roster's disclosure, so the
             two cannot drift apart. -->
        <DataTemplate x:Key="MergeSignalTemplate" DataType="vm:MergeSignalViewModel">
            <Grid Classes="signal"
                  Classes.unfired="{Binding !Fired}"
                  ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto"
                  Margin="0,0,0,9">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Classes="label"
                           Text="{Binding Label}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Classes="data"
                           Margin="12,0,0,0"
                           Text="{Binding ValueText}"
                           VerticalAlignment="Center"/>
                <!-- The matcher's own words. This is the line that separates
                     Prey from Prey. -->
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Classes="body" FontSize="11"
                           LineHeight="15"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource TextDim}"
                           TextWrapping="Wrap"
                           Text="{Binding Detail}"/>
            </Grid>
        </DataTemplate>

        <!-- THE PRIMARY, in its own 200px column. The title the library keeps,
             at the density slider's maximum, at every member count: the card's
             outer geometry never changes between densities (TASK-70.3). -->
        <DataTemplate x:Key="MergeMemberTemplate" DataType="vm:MergeGroupMemberViewModel">
            <StackPanel Width="200" Spacing="10">

                <!-- §6: 200x300, the density slider's maximum. An identity
                     decision deserves the art at full size. -->
                <Border Width="200" Height="300"
                        CornerRadius="{StaticResource RadiusTile}"
                        ClipToBounds="True"
                        BorderThickness="1" BorderBrush="{StaticResource LineSoft}">
                    <Panel>
                        <!-- Placeholder (§7): title in Bricolage on a Surface
                             field. Never a spinner, never a hole. -->
                        <Border Background="{Binding Side.PlaceholderBrush}"
                                IsVisible="{Binding Side.ShowPlaceholder}">
                            <TextBlock Text="{Binding Side.Title}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="Bold" FontSize="22" LineHeight="24"
                                       TextWrapping="Wrap"
                                       Foreground="White"
                                       VerticalAlignment="Bottom" Margin="16"/>
                        </Border>

                        <!-- Real capsule art when the cover cache has it. No
                             dormancy ramp here: the question is identity, not
                             recency. -->
                        <Image Source="{Binding Side.Cover}" Stretch="UniformToFill"/>
                    </Panel>
                </Border>

                <TextBlock Classes="body-l"
                           Text="{Binding Side.Title}"
                           TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           LineHeight="19"/>

                <TextBlock Classes="data-s" Text="{Binding Side.YearText}"/>

                <!-- The store, on its own line. Same outlined chip the tiles
                     wear (1px Line, radius 3, body face 9px, TextDim). The
                     200px column holds three chips (123.1px); WrapPanel so it
                     never clips. -->
                <ItemsControl ItemsSource="{Binding StoreChips}"
                              IsVisible="{Binding HasStores}"
                              ToolTip.Tip="{Binding StoreNames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="store-chip">
                                <TextBlock Text="{Binding}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="body" FontSize="12"
                           Foreground="{StaticResource TextDim}"
                           Text="{Binding Side.PublisherText}"
                           TextWrapping="Wrap"/>

                <!-- The chooser. Which title the library keeps is the user's
                     call, and the card says which one it proposes rather than
                     leaving the choice to look arbitrary. This radio is the
                     ONE place the card states it; the bordered KEEP box that
                     repeated the same sentence underneath is gone. -->
                <RadioButton Classes="primary"
                             GroupName="{Binding GroupName}"
                             IsChecked="{Binding IsPrimary, Mode=TwoWay}"
                             AutomationProperties.Name="{Binding PrimaryAutomationName}"
                             Content="{Binding PrimaryControlText}"/>
            </StackPanel>
        </DataTemplate>

        <!-- EVERY OTHER MEMBER, as a row.
             What varies with member count is inside the row. The sole child
             of a two-member group draws its cover at 200x300, carries the
             full four-row diff open, and shows no include checkbox; the two
             answer buttons already carry include and exclude. In a roster
             of three or more the cover drops to a 64x96 chip, the evidence
             condenses to one line, the matcher's own sentences go behind a
             disclosure, and the checkbox appears. -->
        <DataTemplate x:Key="MergeRosterRowTemplate" DataType="vm:MergeGroupMemberViewModel">
            <Border Classes="member">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto">

                    <!-- Who joins. None, some or all is one gesture. -->
                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                              Classes="member"
                              Margin="0,0,14,0"
                              VerticalAlignment="Center"
                              IsVisible="{Binding ShowIncludeControl}"
                              IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding IncludeAutomationName}"/>

                    <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                            Width="{Binding CoverWidth}" Height="{Binding CoverHeight}"
                            VerticalAlignment="Top"
                            CornerRadius="{StaticResource RadiusControl}"
                            ClipToBounds="True"
                            BorderThickness="1" BorderBrush="{StaticResource LineSoft}">
                        <Panel>
                            <Border Background="{Binding Side.PlaceholderBrush}"
                                    IsVisible="{Binding Side.ShowPlaceholder}">
                                <TextBlock Text="{Binding Side.Title}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold"
                                           FontSize="{Binding PlaceholderFontSize}"
                                           LineHeight="{Binding PlaceholderLineHeight}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="White"
                                           VerticalAlignment="Bottom" Margin="10"/>
                            </Border>
                            <Image Source="{Binding Side.Cover}" Stretch="UniformToFill"/>
                        </Panel>
                    </Border>

                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6" Margin="14,0,14,0">
                        <TextBlock Classes="body-l"
                                   Text="{Binding Side.Title}"
                                   TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   LineHeight="19"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- The store leads the metadata line so that down
                                 a roster the stores form a column at one
                                 constant x, which is what you want when the
                                 question is which of several rows is which
                                 storefront. -->
                            <ItemsControl ItemsSource="{Binding StoreChips}"
                                          IsVisible="{Binding HasStores}"
                                          ToolTip.Tip="{Binding StoreNames}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="store-chip">
                                            <TextBlock Text="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="data-s" Text="{Binding Side.YearText}"/>
                            <TextBlock Classes="data-s" Text="·"/>
                            <TextBlock Classes="body" FontSize="12"
                                       Foreground="{StaticResource TextDim}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Side.PublisherText}"/>
                        </StackPanel>

                        <!-- The diff, condensed: the same three values in the
                             same data face, on one line instead of four rows.
                             A roster of six cannot afford the grid. -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding ShowCondensedEvidence}"
                                    AutomationProperties.Name="{Binding Evidence.SummaryText}">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       VerticalAlignment="Center"
                                       Text="{Binding TitleDistanceLabel}"/>
                            <TextBlock Classes="data-s" VerticalAlignment="Center"
                                       Text="{Binding Evidence.TitleDistanceText}"/>
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding YearDeltaLabel}"/>
                            <TextBlock Classes="data-s" VerticalAlignment="Center"
                                       Text="{Binding Evidence.YearDeltaText}"/>
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding PublisherMatchLabel}"/>
                            <TextBlock Classes="data-s" VerticalAlignment="Center"
                                       Text="{Binding Evidence.PublisherMatchText}"/>
                        </StackPanel>

                        <!-- No proposal ever named this member and the chosen
                             title together: it reached the group through a
                             sibling. Amber, because it is the one thing on the
                             row that has to be read before the checkbox makes
                             sense, and it is why the member arrives
                             unchecked. -->
                        <TextBlock Classes="body" FontSize="12" LineHeight="17"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Amber}"
                                   IsVisible="{Binding IsIndirect}"
                                   Text="{Binding IndirectText}"/>

                        <!-- Two members: the whole diff, open. Nothing is
                             hidden behind a disclosure on a card that asks
                             about exactly two titles. -->
                        <ItemsControl IsVisible="{Binding ShowFullEvidence}"
                                      Margin="0,4,0,0"
                                      ItemsSource="{Binding Evidence.Signals}"
                                      ItemTemplate="{StaticResource MergeSignalTemplate}"/>

                        <TextBlock Classes="body" FontSize="12"
                                   IsVisible="{Binding ShowNoEvidenceNote}"
                                   TextWrapping="Wrap" LineHeight="17"
                                   Foreground="{StaticResource TextDim}"
                                   Text="{Binding Evidence.NoSignalsMessage}"/>

                        <StackPanel Spacing="8" IsVisible="{Binding ShowEvidenceDisclosure}">
                            <Button Classes="disclose"
                                    HorizontalAlignment="Left"
                                    Content="{Binding EvidenceToggleText}"
                                    AutomationProperties.Name="{Binding EvidenceToggleText}"
                                    Command="{Binding ToggleEvidenceCommand}"/>

                            <ItemsControl IsVisible="{Binding IsEvidenceOpen}"
                                          ItemsSource="{Binding Evidence.Signals}"
                                          ItemTemplate="{StaticResource MergeSignalTemplate}"/>
                        </StackPanel>
                    </StackPanel>

                    <RadioButton Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"
                                 Classes="primary"
                                 VerticalAlignment="Center"
                                 GroupName="{Binding GroupName}"
                                 IsChecked="{Binding IsPrimary, Mode=TwoWay}"
                                 AutomationProperties.Name="{Binding PrimaryAutomationName}"
                                 Content="{Binding PrimaryControlText}"/>
                </Grid>
            </Border>
        </DataTemplate>


        <!-- THE BASE GAME on an expansion card.
             The same 200x300 capsule the merge card gives its chosen title,
             and deliberately WITHOUT the primary radio. On a same-game card
             either title could be the one the library keeps, so the radio asks
             a real question; here the parent is fixed by the relation, and a
             radio would let someone assert that Civilization IV is an
             expansion of Beyond the Sword. -->
        <DataTemplate x:Key="ExpansionBaseTemplate" DataType="vm:MergeSideViewModel">
            <StackPanel Width="200" Spacing="10">
                <Border Width="200" Height="300"
                        CornerRadius="{StaticResource RadiusTile}"
                        ClipToBounds="True"
                        BorderThickness="1" BorderBrush="{StaticResource LineSoft}">
                    <Panel>
                        <Border Background="{Binding PlaceholderBrush}"
                                IsVisible="{Binding ShowPlaceholder}">
                            <TextBlock Text="{Binding Title}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="Bold" FontSize="22" LineHeight="24"
                                       TextWrapping="Wrap"
                                       Foreground="White"
                                       VerticalAlignment="Bottom" Margin="16"/>
                        </Border>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                    </Panel>
                </Border>

                <TextBlock Classes="body-l"
                           Text="{Binding Title}"
                           TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           LineHeight="19"/>

                <TextBlock Classes="data-s" Text="{Binding YearText}"/>

                <ItemsControl ItemsSource="{Binding StoreChips}"
                              IsVisible="{Binding HasStores}"
                              ToolTip.Tip="{Binding StoreNames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="store-chip">
                                <TextBlock Text="{Binding}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="body" FontSize="12"
                           Foreground="{StaticResource TextDim}"
                           Text="{Binding PublisherText}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <!-- ONE PROPOSED PACK, in the merge roster's grammar: include
             checkbox, 64x96 chip, title, and one line of labelled values in
             the data face. The values differ from the merge roster's because
             the question does: this shows what the title ADDS to the base,
             not how far the two titles are apart.

             The row also states the storefront's own word for the relation
             (demo, beta, playtest, expansion, dlc, remaster, port, mod,
             among others) rather than the link kind, because three kinds
             carry an open vocabulary and calling a playtest an expansion
             is what made this surface confusing.

             Rows arrive CHECKED, unlike a same-game roster row. An unchecked
             same-game default guards against a connected component's closure
             asserting more than any single proposal did; an expansion
             proposal is one direct claim about one pair, already
             corroborated, so there is no closure to guard. -->
        <DataTemplate x:Key="ExpansionRosterRowTemplate" DataType="vm:ExpansionMemberViewModel">
            <Border Classes="member">
                <Grid ColumnDefinitions="Auto,64,*,Auto"
                      RowDefinitions="Auto,Auto">

                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                              Classes="member"
                              Margin="0,0,14,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding IncludeAutomationName}"
                              ToolTip.Tip="{Binding IncludeControlText}"/>

                    <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                            Width="64" Height="96"
                            VerticalAlignment="Top"
                            CornerRadius="{StaticResource RadiusControl}"
                            ClipToBounds="True"
                            BorderThickness="1" BorderBrush="{StaticResource LineSoft}">
                        <Panel>
                            <Border Background="{Binding Side.PlaceholderBrush}"
                                    IsVisible="{Binding Side.ShowPlaceholder}"/>
                            <Image Source="{Binding Side.Cover}" Stretch="UniformToFill"/>
                        </Panel>
                    </Border>

                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6" Margin="14,0,0,0">
                        <TextBlock Classes="body-l"
                                   Text="{Binding Side.Title}"
                                   TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   LineHeight="19"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ItemsControl ItemsSource="{Binding StoreChips}"
                                          IsVisible="{Binding HasStores}"
                                          ToolTip.Tip="{Binding StoreNames}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="store-chip">
                                            <TextBlock Text="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="data-s" Text="{Binding Side.YearText}"/>
                        </StackPanel>

                        <!-- The evidence, one line. What the title adds, how
                             far apart the years are, whether the publishers
                             agree, and whether the child's own title splits
                             the base from the pack. -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       VerticalAlignment="Center"
                                       Text="{Binding ExtendsLabel}"/>
                            <TextBlock Classes="data-s" VerticalAlignment="Center"
                                       Text="{Binding SuffixText}"/>
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       VerticalAlignment="Center"
                                       Text="{Binding YearLabel}"/>
                            <TextBlock Classes="data-s" VerticalAlignment="Center"
                                       Text="{Binding YearDeltaText}"/>
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       VerticalAlignment="Center"
                                       Text="{Binding PublisherLabel}"/>
                            <TextBlock Classes="data-s" VerticalAlignment="Center"
                                       Text="{Binding PublisherText}"/>
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       VerticalAlignment="Center"
                                       Text="{Binding SeparatorLabel}"/>
                            <TextBlock Classes="data-s" VerticalAlignment="Center"
                                       Text="{Binding SeparatorText}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- The storefront's own word for what this is. -->
                    <TextBlock Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"
                               Classes="label" FontSize="10" LetterSpacing="1"
                               Margin="14,2,0,0"
                               VerticalAlignment="Top"
                               IsVisible="{Binding HasRelation}"
                               Text="{Binding RelationText}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- What the last answer actually did.
             In the header rather than beside the card that caused it, because
             the card is gone the moment it is answered. Written from what the
             repository returned, so a no-op says so here instead of the screen
             simply going quiet. The undo that makes answering safe is on this
             line, not behind a segment.

             One template, shown by whichever surface raised the outcome. It
             was written out three times identically. -->
        <DataTemplate x:Key="ReportNoteTemplate" DataType="vm:MergeQueueViewModel">
            <Border Classes="note attention">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Classes="body" FontSize="12" LineHeight="18"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               TextWrapping="Wrap"
                               Text="{Binding ReportMessage}"/>
                    <Button Grid.Column="1"
                            Classes="answer different"
                            VerticalAlignment="Center"
                            IsVisible="{Binding CanUndoReport}"
                            Content="{Binding ReportUndoButtonText}"
                            AutomationProperties.Name="{Binding ReportUndoAutomationName}"
                            ToolTip.Tip="{Binding ReportUndoTooltipText}"
                            Command="{Binding UndoReportCommand}"/>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <UserControl.Styles>

        <!-- ══ The content column ═══════════════════════════════════════════
             One measure for the whole screen. The 840px ceiling sat on the
             card alone, so on a wide window the header's count stood hundreds
             of pixels from the cards it counted. Everything the user reads
             down one column now takes it: the segment strip's content, each
             header, the outcome report, the card lists, the empty states
             and the history log. The rules still cross the pane (§11.1). -->
        <Style Selector=":is(Control).measure">
            <Setter Property="MaxWidth" Value="840"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ══ Group card ═══════════════════════════════════════════════════
             Border thickness stays at 2 in both states so selecting a card
             recolours it instead of reflowing the whole queue under it. The
             card fills the content column rather than setting it. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style Selector="Border.card.selected">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>

        <!-- One roster row. Quieter than the card that holds it: the row is a
             member of a decision, not a decision of its own. -->
        <Style Selector="Border.member">
            <Setter Property="Background" Value="{StaticResource Well}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- An unfired signal keeps full ink and steps its VALUE cell from Text
             down to TextDim, the app's content-to-metadata step. Opacity was the
             previous mark, but any alpha below 1 on a dark field lowers contrast:
             TextDim at 0.55 measured 2.79:1 on Surface and 3.01:1 on Well, against
             §8's 5.04:1 floor. The state stays carried three ways: the em-dash
             value, the reason sentence, and the demoted ink. -->
        <Style Selector="Grid.signal.unfired > :is(TextBlock).data">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>

        <!-- ══ The two member controls ══════════════════════════════════════
             Real CheckBox and RadioButton — they toggle on Space and report
             their state to automation — templated rather than restyled, on the
             same terms as the filter panel's facet rows: Fluent's own read a
             dozen resource keys across six states, and overriding all of them
             is more surface than drawing a 14px box and a mark. -->
        <Style Selector="CheckBox.member">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <!-- §8's 2px Volt ring. Brush opacity rather than
                             thickness, so nothing reflows as focus moves. -->
                        <Border Name="Ring"
                                Margin="-5"
                                CornerRadius="{StaticResource RadiusControl}"
                                BorderBrush="{StaticResource Volt}"
                                BorderThickness="2"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <Panel>
                            <Border Name="Box" Width="16" Height="16"
                                    CornerRadius="3"
                                    Background="{StaticResource ChromeFieldOnSurface}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1"/>
                            <Path Name="Tick"
                                  Data="M 0,3 L 2.6,5.6 L 7.4,0.8"
                                  Stroke="{StaticResource VoltInk}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Width="8" Height="7"
                                  Opacity="0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Panel>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.member:focus-visible /template/ Border#Ring">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="CheckBox.member:pointerover /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="CheckBox.member:checked /template/ Border#Box">
            <Setter Property="Background" Value="{StaticResource Volt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="CheckBox.member:checked /template/ Path#Tick">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="RadioButton.primary">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <Border Name="Ring"
                                Margin="-5,-4"
                                CornerRadius="{StaticResource RadiusControl}"
                                BorderBrush="{StaticResource Volt}"
                                BorderThickness="2"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Panel VerticalAlignment="Center">
                                <Ellipse Name="Dial" Width="16" Height="16"
                                         Fill="{StaticResource ChromeFieldOnSurface}"
                                         Stroke="{StaticResource Line}"
                                         StrokeThickness="1"/>
                                <Ellipse Name="Dot" Width="7" Height="7"
                                         Fill="{StaticResource VoltInk}"
                                         Opacity="0"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Panel>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.primary:focus-visible /template/ Border#Ring">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="RadioButton.primary:pointerover /template/ Ellipse#Dial">
            <Setter Property="Stroke" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="RadioButton.primary:checked /template/ Ellipse#Dial">
            <Setter Property="Fill" Value="{StaticResource Volt}"/>
            <Setter Property="Stroke" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="RadioButton.primary:checked /template/ Ellipse#Dot">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="RadioButton.primary:checked">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <!-- ══ The two answers (§6, §7) ═════════════════════════════════════ -->
        <Style Selector="Button.answer">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.answer.same">
            <Setter Property="Background" Value="{StaticResource Volt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <Style Selector="Button.answer.same:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VoltHover}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <Style Selector="Button.answer.same:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VoltPress}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>

        <!-- A control the engine refuses, or an undo a later merge has taken
             out of reach. TextDim on the room's own ground, never Flare: Flare
             marks unread updates and the bucket that counts them, and a
             disabled button is not an alarm. The reason is always written
             beside it in words (§8), so the dimming is never the only thing
             saying so. -->
        <Style Selector="Button.answer:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>

        <!-- "Different games" is not a cancel and is not destructive: it is the
             other half of the answer, and it carries as much weight. It reads
             quieter only because the queue's job is to shrink. -->
        <Style Selector="Button.answer.different">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Button.answer.different:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextDim}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Button.answer.different:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <!-- A history entry: lighter than a queue card, 1px border rather than
             2px, because nothing here is selectable and a 2px edge that never
             changes colour is a border pretending to be a state. -->
        <Style Selector="Border.entry">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- An inset note the card or entry is making about itself. Well is the
             app's inset tone (§9). -->
        <Style Selector="Border.note">
            <Setter Property="Background" Value="{StaticResource Well}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <!-- Amber is §2's attention colour and the one this screen is allowed
             to reach for. A refusal, a block the answer cannot get past and the
             report of what the last answer actually did are all "read this
             before going on". Amber on the edge only; the text stays legible
             ink. -->
        <Style Selector="Border.note.attention">
            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
        </Style>

        <!-- Section rule and heading on the history surface. -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="48,*" Background="{StaticResource PaneGround}">

        <!-- ══ The header strip ═════════════════════════════════════════════
             48px, the command bar's height and the settings surface's, so
             the rule under it continues the rule that crosses the rest of
             the window (§11.1). Each surface keeps its own header and its
             own scroll below it. -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">
            <StackPanel Classes="measure"
                        Orientation="Horizontal"
                        Spacing="14"
                        Margin="24,0"
                        VerticalAlignment="Center">
                <TextBlock Classes="label"
                           FontSize="10"
                           LetterSpacing="1.4"
                           Text="{Binding ScreenLabel}"
                           VerticalAlignment="Center"/>
                <Border BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}"
                        Background="{StaticResource ChromeFieldOnGround}"
                        ClipToBounds="True"
                        Height="30">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="seg tab"
                                Classes.on="{Binding IsReviewVisible}"
                                Command="{Binding ShowReviewCommand}"
                                ToolTip.Tip="{Binding ReviewSegmentTooltip}">
                            <TextBlock Classes="display-s" Text="{Binding ReviewSegmentLabel}"/>
                        </Button>
                        <!-- The third surface. A segment rather than a
                             third kind of card in the review scroll, because
                             the two questions take different answers: REVIEW
                             answers Same game / Different games and this
                             answers Group / Not expansions, and one column
                             holding both would give S and D two meanings.
                             This surface has its own keys, G and N. -->
                        <Button Classes="seg tab"
                                Classes.on="{Binding IsExpansionsVisible}"
                                Command="{Binding ShowExpansionsCommand}"
                                ToolTip.Tip="{Binding ExpansionsSegmentTooltip}">
                            <TextBlock Classes="display-s" Text="{Binding ExpansionsSegmentLabel}"/>
                        </Button>
                        <Button Classes="seg tab"
                                Classes.on="{Binding IsHistoryVisible}"
                                Command="{Binding ShowHistoryCommand}"
                                ToolTip.Tip="{Binding HistorySegmentTooltip}">
                            <TextBlock Classes="display-s" Text="{Binding HistorySegmentLabel}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1">

            <!-- ══ REVIEW — the queue, and nothing else ═════════════════════ -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsReviewVisible}">

                <Border Grid.Row="0"
                        Padding="24,20,24,18"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,0,1">
                  <StackPanel Classes="measure" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="7">
                            <TextBlock Classes="display-l" Text="{Binding ReviewQuestion}"/>
                            <!-- Stands down when the queue is empty: the empty
                                 state is the only thing that should be
                                 speaking then. The line carries what every
                                 card used to repeat. -->
                            <TextBlock Classes="body"
                                       MaxWidth="620"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       IsVisible="{Binding HasPending}"
                                       Foreground="{StaticResource TextDim}"
                                       Text="{Binding IntroMessage}"/>
                        </StackPanel>

                        <!-- Count only while there is something pending: a
                             permanent zero is noise. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding HasPending}">
                            <TextBlock Classes="data" FontSize="22"
                                       Text="{Binding PendingCountText}"
                                       VerticalAlignment="Bottom"/>
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="{Binding PendingCountLabel}"
                                       Margin="0,0,0,3"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Grid>

                    <ContentControl IsVisible="{Binding HasReviewReport}"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource ReportNoteTemplate}"/>
                  </StackPanel>
                </Border>

                <Panel Grid.Row="1">

                    <ScrollViewer Name="QueueScroll"
                                  IsVisible="{Binding HasPending}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <ItemsControl Name="CardList"
                                    Classes="measure"
                                    Margin="24,20,24,24"
                                    GotFocus="OnCardFocus"
                                    ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:MergeGroupViewModel">
                                <Border Classes="card"
                                        Classes.selected="{Binding IsSelected}"
                                        PointerPressed="OnCardPressed">
                                    <Grid RowDefinitions="Auto,Auto,Auto">

                                        <!-- ── The card's own header ───────
                                             Confidence, the matcher's band and
                                             how many titles the group holds. -->
                                        <Grid Grid.Row="0"
                                              ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                              Margin="0,0,0,16">
                                            <TextBlock Grid.Column="0" Classes="label"
                                                       Text="{Binding ConfidenceLabel}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,10,2"/>
                                            <TextBlock Grid.Column="1" Classes="data"
                                                       FontSize="20"
                                                       VerticalAlignment="Bottom"
                                                       Text="{Binding ScoreText}"/>

                                            <!-- The matcher's top confidence
                                                 band, in Azure (§8: colour is
                                                 never the only carrier — the
                                                 word says it). Several cards
                                                 can carry it at once. -->
                                            <TextBlock Grid.Column="2" Classes="label"
                                                       FontSize="10" LetterSpacing="1"
                                                       Margin="12,0,0,2"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{StaticResource Azure}"
                                                       IsVisible="{Binding IsPriority}"
                                                       Text="{Binding PriorityBandLabel}"/>

                                            <TextBlock Grid.Column="3" Classes="data"
                                                       FontSize="20"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,8,0"
                                                       Text="{Binding MemberCountText}"/>
                                            <TextBlock Grid.Column="4" Classes="label"
                                                       FontSize="10" LetterSpacing="1"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,0,2"
                                                       Text="{Binding MemberCountLabel}"/>
                                        </Grid>

                                        <!-- ── One layout, every count ──────
                                             The primary's capsule on the left,
                                             every other member as a row on the
                                             right. What changes with the count
                                             is inside the row. -->
                                        <Grid Grid.Row="1" ColumnDefinitions="200,*">

                                            <StackPanel Grid.Column="0" Width="200" Spacing="10">
                                                <ContentControl
                                                    Content="{Binding Primary}"
                                                    ContentTemplate="{StaticResource MergeMemberTemplate}"/>

                                                <!-- Why that title, on the
                                                     chooser's own line rather
                                                     than in a second box that
                                                     said "keep" again. -->
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="7"
                                                            IsVisible="{Binding HasPrimaryReason}">
                                                    <TextBlock Classes="label"
                                                               FontSize="10" LetterSpacing="1"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding PrimaryReasonLabel}"/>
                                                    <TextBlock Classes="body" FontSize="12"
                                                               LineHeight="17"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding PrimaryReasonText}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <ItemsControl Grid.Column="1"
                                                          Margin="28,0,0,0"
                                                          ItemsSource="{Binding Others}"
                                                          ItemTemplate="{StaticResource MergeRosterRowTemplate}"/>
                                        </Grid>

                                        <!-- ── The answer ─────────────────────
                                             Automation names identify the group
                                             and its members, never the verb: a
                                             column of buttons all reading
                                             "Same game" is one target a screen
                                             reader cannot tell apart (§8). -->
                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    Spacing="12"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,16,0,0">
                                            <Button Classes="answer same"
                                                    Content="{Binding SameGameButtonText}"
                                                    IsEnabled="{Binding !IsDecided}"
                                                    AutomationProperties.Name="{Binding SameGameAutomationName}"
                                                    ToolTip.Tip="{Binding SameGameTooltip}"
                                                    Command="{Binding $parent[UserControl].((vm:MergeQueueViewModel)DataContext).SameGameCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Classes="answer different"
                                                    Content="{Binding DifferentGamesButtonText}"
                                                    IsEnabled="{Binding !IsDecided}"
                                                    AutomationProperties.Name="{Binding DifferentGamesAutomationName}"
                                                    ToolTip.Tip="{Binding DifferentGamesTooltip}"
                                                    Command="{Binding $parent[UserControl].((vm:MergeQueueViewModel)DataContext).DifferentGamesCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <!-- ══ Queue empty, the normal state (§7) ═══════════════ -->
                    <Border Classes="measure"
                            IsVisible="{Binding ShowEmpty}" Padding="32">
                        <StackPanel MaxWidth="460" Spacing="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="body-l"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       LineHeight="22"
                                       Foreground="{StaticResource TextDim}"
                                       Text="{Binding EmptyMessage}"/>
                        </StackPanel>
                    </Border>

                </Panel>
            </Grid>

            <!-- EXPANSIONS.
                 The one-to-many relation presented once: a base game and every
                 pack proposed under it, on one card, applied as one act, with
                 the user free to take none, some or all. Grouping is
                 presentation only: no count, no playtime, no bucket and no
                 recommendation moves, and the header says so rather than
                 leaving the user to notice that nothing changed. -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsExpansionsVisible}">

                <Border Grid.Row="0"
                        Padding="24,20,24,18"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,0,1">
                  <StackPanel Classes="measure" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="7">
                            <TextBlock Classes="display-l" Text="{Binding ExpansionsQuestion}"/>
                            <TextBlock Classes="body"
                                       MaxWidth="620"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       IsVisible="{Binding HasExpansions}"
                                       Foreground="{StaticResource TextDim}"
                                       Text="{Binding ExpansionsIntro}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding HasExpansions}">
                            <TextBlock Classes="data" FontSize="22"
                                       Text="{Binding ExpansionCountText}"
                                       VerticalAlignment="Bottom"/>
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="{Binding ExpansionCountLabel}"
                                       Margin="0,0,0,3"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Grid>

                    <ContentControl IsVisible="{Binding HasExpansionsReport}"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource ReportNoteTemplate}"/>
                  </StackPanel>
                </Border>

                <Panel Grid.Row="1">

                    <ScrollViewer IsVisible="{Binding HasExpansions}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <ItemsControl Name="ExpansionList"
                                    Classes="measure"
                                    Margin="24,20,24,24"
                                    GotFocus="OnExpansionCardFocus"
                                    ItemsSource="{Binding ExpansionGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ExpansionGroupViewModel">
                                <Border Classes="card"
                                        Classes.selected="{Binding IsSelected}"
                                        PointerPressed="OnExpansionCardPressed">
                                    <Grid RowDefinitions="Auto,Auto,Auto">

                                        <Grid Grid.Row="0"
                                              ColumnDefinitions="Auto,*,Auto,Auto"
                                              Margin="0,0,0,16">
                                            <TextBlock Grid.Column="0" Classes="label"
                                                       Text="{Binding BaseLabel}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,10,2"/>
                                            <TextBlock Grid.Column="1" Classes="body-l"
                                                       VerticalAlignment="Bottom"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding BaseTitle}"/>
                                            <TextBlock Grid.Column="2" Classes="data"
                                                       FontSize="20"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,8,0"
                                                       Text="{Binding MemberCountText}"/>
                                            <TextBlock Grid.Column="3" Classes="label"
                                                       FontSize="10" LetterSpacing="1"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,0,2"
                                                       Text="{Binding MemberCountLabel}"/>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="200,*">
                                            <ContentControl Grid.Column="0"
                                                            Content="{Binding Base}"
                                                            ContentTemplate="{StaticResource ExpansionBaseTemplate}"/>
                                            <ItemsControl Grid.Column="1"
                                                          Margin="28,0,0,0"
                                                          ItemsSource="{Binding Members}"
                                                          ItemTemplate="{StaticResource ExpansionRosterRowTemplate}"/>
                                        </Grid>

                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    Spacing="12"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,16,0,0">
                                            <Button Classes="answer same"
                                                    Content="{Binding GroupButtonText}"
                                                    IsEnabled="{Binding !IsDecided}"
                                                    AutomationProperties.Name="{Binding GroupAutomationName}"
                                                    ToolTip.Tip="{Binding GroupTooltip}"
                                                    Command="{Binding $parent[UserControl].((vm:MergeQueueViewModel)DataContext).GroupExpansionsCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Classes="answer different"
                                                    Content="{Binding NotExpansionsButtonText}"
                                                    IsEnabled="{Binding !IsDecided}"
                                                    AutomationProperties.Name="{Binding NotExpansionsAutomationName}"
                                                    ToolTip.Tip="{Binding NotExpansionsTooltip}"
                                                    Command="{Binding $parent[UserControl].((vm:MergeQueueViewModel)DataContext).NotExpansionsCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <Border Classes="measure"
                            IsVisible="{Binding ShowExpansionsEmpty}" Padding="32">
                        <StackPanel MaxWidth="460" Spacing="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="body-l"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       LineHeight="22"
                                       Foreground="{StaticResource TextDim}"
                                       Text="{Binding ExpansionsEmptyMessage}"/>
                        </StackPanel>
                    </Border>

                </Panel>
            </Grid>

            <!-- ══ HISTORY, one chronological log ═══════════════════════════
                 Every act this screen records, newest first, both relations
                 in one list. An act that has been undone is not on it; the
                 row leaves rather than staying struck through, so what is on
                 screen is what is in force. The same group can be linked
                 again from the queue on the next load. -->
            <ScrollViewer IsVisible="{Binding IsHistoryVisible}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Classes="measure" Margin="24,20,24,24" Spacing="0">

                <ContentControl Margin="0,0,0,20"
                                IsVisible="{Binding HasHistoryReport}"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource ReportNoteTemplate}"/>

                <StackPanel Spacing="7" Margin="0,0,0,8">
                    <TextBlock Classes="section" Text="{Binding LinkHistoryHeading}"/>
                    <TextBlock Classes="body" FontSize="12" LineHeight="18"
                               MaxWidth="620" TextWrapping="Wrap"
                               HorizontalAlignment="Left"
                               Foreground="{StaticResource TextDim}"
                               Text="{Binding LinkHistoryIntro}"/>
                </StackPanel>

                <ItemsControl Margin="0,12,0,0"
                              IsVisible="{Binding HasLinkHistory}"
                              ItemsSource="{Binding LinkHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:MergeLinkHistoryRowViewModel">
                            <Border Classes="entry">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,20,0">
                                        <TextBlock Classes="body-l"
                                                   TextWrapping="Wrap" LineHeight="21"
                                                   Text="{Binding Description}"/>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding LinkedAtLabel}"/>
                                            <TextBlock Classes="data-s"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding LinkedAtText}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Automation name identifies the group,
                                         not the button; a static label
                                         repeated down the list is one target a
                                         screen reader cannot distinguish. -->
                                    <Button Grid.Column="1"
                                            Classes="answer different"
                                            VerticalAlignment="Top"
                                            Content="{Binding UndoButtonText}"
                                            IsEnabled="{Binding CanUndo}"
                                            AutomationProperties.Name="{Binding UndoAutomationName}"
                                            ToolTip.Tip="{Binding UndoTooltip}"
                                            Command="{Binding $parent[UserControl].((vm:MergeQueueViewModel)DataContext).UndoCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="body" FontSize="12" LineHeight="18"
                           Margin="0,4,0,0"
                           MaxWidth="520" TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           Foreground="{StaticResource TextDim}"
                           IsVisible="{Binding ShowLinkHistoryEmpty}"
                           Text="{Binding LinkHistoryEmptyMessage}"/>

              </StackPanel>
            </ScrollViewer>

        </Panel>

    </Grid>

</UserControl>
