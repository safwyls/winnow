<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lists="using:Winnow.App.ViewModels.Lists"
             x:Class="Winnow.App.Views.FeedListPromptView"
             x:DataType="lists:ActionPromptViewModel"
             AutomationProperties.Name="{Binding Question}"
             AutomationProperties.ControlTypeOverride="Window">
    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Volt}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource VoltSelection}"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource ChromeFieldOnGround}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="Button.act.danger">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerInk}"/>
        </Style>
        <Style Selector="Button.act.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerHover}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerInk}"/>
        </Style>
        <Style Selector="Button.act.danger:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource DangerInk}"/>
        </Style>
    </UserControl.Styles>
    <Grid KeyboardNavigation.TabNavigation="Cycle" KeyDown="OnPromptKeyDown">
        <Border Background="{StaticResource ModalScrim}" PointerPressed="OnScrimPressed"/>
        <Border Width="480" MaxWidth="{Binding $parent[UserControl].Bounds.Width}"
                Margin="24" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusPane}">
            <StackPanel Spacing="16">
                <TextBlock Classes="body-l" Text="{Binding Question}" TextWrapping="Wrap"/>
                <!-- Keep the scrollbar in the card padding so rows and the field share an edge. -->
                <ScrollViewer MaxHeight="240" Classes="inner" Margin="0,0,-20,0" HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding HasChoices}">
                    <ItemsControl ItemsSource="{Binding Choices}" Margin="{StaticResource InnerScrollGutter}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="lists:GameListViewModel">
                                <Button Classes="act quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        MinHeight="{StaticResource ListRowHeight}" Padding="12,8" Margin="0,0,0,8"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        ToolTip.Tip="{Binding Name}"
                                        Command="{Binding $parent[ItemsControl].((lists:ActionPromptViewModel)DataContext).ChooseCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Canvas Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                            <Path Data="M 1,3 H 3 M 6,3 H 15 M 1,8 H 3 M 6,8 H 15 M 1,13 H 3 M 6,13 H 15"
                                                  Stroke="{StaticResource TextDim}" StrokeThickness="1.5"/>
                                        </Canvas>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Classes="data" Margin="12,0,0,0" Text="{Binding CountText}"
                                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                        <Canvas Grid.Column="3" Width="16" Height="16" Margin="16,0,0,0" VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                            <Path Data="M 8,2 V 14 M 2,8 H 14" Stroke="{StaticResource Azure}" StrokeThickness="1.5"/>
                                        </Canvas>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Height="1" Background="{StaticResource Line}" IsVisible="{Binding HasChoices}"/>
                <TextBox Name="PromptInput" IsVisible="{Binding HasInput}" MinHeight="40"
                         IsEnabled="{Binding CanInteract}"
                         AutomationProperties.Name="{Binding InputWatermark}"
                         Watermark="{Binding InputWatermark}" Text="{Binding Text, Mode=TwoWay}"/>
                <TextBlock Classes="body" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                           IsVisible="{Binding HasNote}" Text="{Binding Note}"/>
                <TextBlock Classes="body" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                           IsVisible="{Binding HasProblem}" Text="{Binding Problem}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Name="CancelButton" Classes="act quiet" Content="Cancel" Command="{Binding CancelCommand}"/>
                    <Button Classes="act" Classes.primary="{Binding !IsDestructive}" Classes.danger="{Binding IsDestructive}"
                            Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
