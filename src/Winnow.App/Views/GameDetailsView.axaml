<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Winnow.App.ViewModels"
             xmlns:views="using:Winnow.App.Views"
             x:Class="Winnow.App.Views.GameDetailsView"
             x:DataType="vm:GameDetailsViewModel"
             Focusable="True">

    <!-- Game detail modal (§10). Four bands: identity, history, actions, rest.
         Rows appear when their data exists. No flyouts (focus adorner
         cannot render inside a popup). -->

    <UserControl.Styles>

        <!-- The modal's own scrollbar is an interior control, not one at the
             window edge, so it opts out of the resize-border inset (§9). -->
        <Style Selector="ScrollViewer.inner /template/ ScrollBar">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- ══ Focus, drawn rather than adorned ═══════════════════════════════
             Brush swap on constant-thickness border (FocusAdorner fails here). -->

        <!-- Close affordance and patch-notes rows: quiet until touched. The 1px
             border is transparent at rest, so it costs nothing but reserves the
             space the focus ring will need. -->
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.quiet /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.quiet:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>

        <!-- Azure is the palette's boring one and does the boring work (§2):
             every outbound link in the panel, and nothing else. -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.link:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.link :is(TextBlock)">
            <Setter Property="Foreground" Value="{StaticResource Azure}"/>
        </Style>

        <!-- Secondary action: Text colour, not Azure (acts on our DB, not
             outbound) and not Flare (§2). -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.secondary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.secondary :is(TextBlock)">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <!-- The one filled control on the screen. Volt marks the active thing,
             and starting the game is the most active thing there is (§2). -->
        <Style Selector="Button.launch">
            <Setter Property="Background" Value="{StaticResource Volt}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <!-- 2px of border at all times, Volt on Volt so it is invisible at
                 rest. It exists purely so the focus state has somewhere to land
                 without changing the button's size. -->
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.launch /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="Button.launch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VoltHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VoltHover}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <Style Selector="Button.launch:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VoltPress}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VoltPress}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <!-- Focus ring uses VoltInk here (Volt on Volt is invisible). -->
        <Style Selector="Button.launch:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource VoltInk}"/>
        </Style>

        <!-- Copyable text. Only title, summary, appid and install path keep
             Focusable; the rest opt out to shorten the Tab run to Play.
             Focused text gets a raised field (keyboard only), not a ring. -->
        <Style Selector="SelectableTextBlock.copyable">
            <Setter Property="Cursor" Value="Ibeam"/>
        </Style>
        <Style Selector="SelectableTextBlock.copyable:focus-visible">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>

        <!-- Update rows. Flare dot shows on rows that landed after last
             session and are above the dismissal watermark (migration 0012).
             Older rows keep the column width for alignment. -->
        <Style Selector="Border.updaterow:pointerover">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedFaint}"/>
        </Style>

    </UserControl.Styles>

    <Panel>

        <!-- Scrim. Clicking it dismisses — §8's Escape is the keyboard half of
             the same promise: nothing here traps the user. Well at 84%, the
             same unlit tone as the title bar (§9). -->
        <Border Name="Scrim" Background="{StaticResource ModalScrim}" PointerPressed="OnScrimPressed"/>

        <!-- Tab cycles inside the card. A modal that leaks focus into the
             library behind it is a modal in appearance only (§8). -->
        <Border Name="Card"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusTile}"
                BoxShadow="0 18 48 0 #A6000000"
                MinWidth="700" MaxWidth="860" MaxHeight="720"
                Margin="40"
                KeyboardNavigation.TabNavigation="Cycle"
                HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Two columns: LEFT is the object (art, appid, path),
                 RIGHT is your relationship (playtime, gap, actions, updates). -->
            <Grid ColumnDefinitions="200,*" ColumnSpacing="26" Margin="26,24,26,0">


                <!-- ══ Right: your relationship with it ═════════════════════ -->
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto">

                    <StackPanel Grid.Row="0" Spacing="16">

                        <!-- ── Band 1: what is this ───────────────────────── -->
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <SelectableTextBlock Grid.Column="0"
                                           Classes="display-l copyable"
                                           Focusable="True"
                                           FontSize="26"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap"
                                           LineHeight="30"
                                           Margin="0,0,12,0"/>
                                <Button Grid.Column="1" Classes="quiet"
                                        Name="CloseButton"
                                        VerticalAlignment="Top"
                                        Click="OnClosePressed"
                                        ToolTip.Tip="Close (Esc)">
                                    <TextBlock Classes="body-l"
                                               Foreground="{StaticResource TextDim}"
                                               Text="&#x00D7;"/>
                                </Button>
                            </Grid>

                            <!-- Year and publisher: three typefaces distinguish
                                 the three kinds of content (§3). -->
                            <StackPanel Orientation="Horizontal"
                                        IsVisible="{Binding HasIdentityLine}">
                                <SelectableTextBlock Classes="data copyable"
                                           Focusable="False"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding IdentityYearText}"/>
                                <SelectableTextBlock Classes="body copyable"
                                           Focusable="False"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDim}"
                                           IsVisible="{Binding HasPublisher}"
                                           Text="{Binding Publisher}"/>
                            </StackPanel>

                            <!-- A provisional title is an appid wearing a
                                 title's clothes. Saying so is the difference
                                 between "still loading" and "broken". -->
                            <TextBlock Classes="body" FontSize="12"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDim}"
                                       IsVisible="{Binding TitleIsProvisional}"
                                       Text="{Binding ProvisionalNote}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Every store this game is on. The per-entry rows
                                 in ALSO COVERS below are the breakdown; this is
                                 the header saying which platforms the title
                                 exists on at all. -->
                            <ItemsControl ItemsSource="{Binding StoreChips}"
                                          ToolTip.Tip="{Binding StoreNames}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="store-chip" Padding="7,3">
                                            <TextBlock Text="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{StaticResource SurfaceRaised}"
                                    CornerRadius="3" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Classes="body" FontSize="11"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding BucketLabel}"/>
                            </Border>
                            <!-- Install state: null (no source looked) is
                                 hidden, never shown as "Unknown" (§10.5). -->
                            <Border Background="{StaticResource SurfaceRaised}"
                                    CornerRadius="3" Padding="7,3" VerticalAlignment="Center"
                                    IsVisible="{Binding HasInstallState}">
                                <TextBlock Classes="body" FontSize="11"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding InstallText}"/>
                            </Border>
                        </StackPanel>

                        <!-- ── Band 2: my history ─────────────────────────── -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="26">

                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Top">
                                <TextBlock Classes="data"
                                           FontSize="30" LineHeight="34"
                                           Text="{Binding PlaytimeText}"/>
                                <TextBlock Classes="label" FontSize="10" Text="PLAYED"/>
                            </StackPanel>

                            <!-- The gap: last session → now, with what shipped
                                 in between. §10's signature. -->
                            <StackPanel Grid.Column="1" Spacing="7"
                                        IsVisible="{Binding HasGap}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label"
                                               FontSize="10" Text="SINCE YOU PLAYED"/>
                                    <TextBlock Grid.Column="1" Classes="data"
                                               FontSize="14"
                                               Foreground="{StaticResource Text}"
                                               Text="{Binding IdleText}"/>
                                </Grid>

                                <views:GapRail Marks="{Binding RailMarks}"
                                               StartBrush="{StaticResource Volt}"
                                               EndBrush="{StaticResource Line}"
                                               MarkBrush="{StaticResource Flare}"
                                               MarkRingBrush="{StaticResource Surface}"/>

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="data-s"
                                               Text="{Binding LastPlayedText}"/>
                                    <TextBlock Grid.Column="2" Classes="data-s"
                                               Text="today"/>
                                </Grid>

                                <TextBlock Classes="body" FontSize="12"
                                           LineHeight="17"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding GapCaption}"/>

                                <!-- §1's longitudinal record, at the resolution
                                     the data supports: a sentence, not a chart
                                     through one point. -->
                                <TextBlock Classes="body" FontSize="12"
                                           LineHeight="17"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDim}"
                                           IsVisible="{Binding HasRecordLine}"
                                           Text="{Binding RecordLine}"/>
                            </StackPanel>

                            <!-- No date, no rail. Two different absences, and
                                 the copy keeps them apart. -->
                            <StackPanel Grid.Column="1" Spacing="7"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding LacksGap}">
                                <TextBlock Classes="body" FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding NoGapText}"/>
                                <TextBlock Classes="body" FontSize="12"
                                           LineHeight="17"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDim}"
                                           IsVisible="{Binding HasRecordLine}"
                                           Text="{Binding RecordLine}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ── Band 3: get me in ──────────────────────────── -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- steam://run when it is on disk, steam://install
                                 when it is not. The button is named for what it
                                 does, so it cannot promise the wrong thing. -->
                            <Button Classes="launch"
                                    Name="LaunchButton"
                                    IsVisible="{Binding HasPrimaryAction}"
                                    Content="{Binding PrimaryAction.Label}"
                                    ToolTip.Tip="{Binding PrimaryAction.Tooltip}"
                                    Command="{Binding Tile.PrimaryActionCommand}"
                                    CommandParameter="{Binding Tile}"/>

                            <ItemsControl ItemsSource="{Binding Links}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:GameLink">
                                        <Button Classes="link"
                                                Click="OnLinkPressed"
                                                ToolTip.Tip="{Binding Tooltip}">
                                            <TextBlock Classes="body" FontSize="12"
                                                       Text="{Binding Label}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Local folder, not a file: URI — GameLink refuses
                                 that scheme on purpose and the launcher takes a
                                 DirectoryInfo directly. -->
                            <Button Classes="link"
                                    IsVisible="{Binding HasOpenableFolder}"
                                    Click="OnOpenFolderPressed"
                                    ToolTip.Tip="{Binding InstallPath}">
                                <TextBlock Classes="body" FontSize="12" Text="Open folder"/>
                            </Button>
                        </StackPanel>

                    </StackPanel>

                    <!-- The seam between deciding and reading. It spans the
                         right column only: the left column keeps going. -->
                    <Border Grid.Row="1" Height="1" Margin="0,22,0,0"
                            Background="{StaticResource Line}"/>

                <!-- ══ Band 4: the rest ═════════════════════════════════════ -->
                <!-- Breathing room is the content's margin, not ScrollViewer
                     padding (padding is not counted in desired height). -->
                <ScrollViewer Grid.Row="2"
                              Classes="inner"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="22" Margin="0,18,0,24">

                        <!-- ALSO COVERS. The user's fourth complaint answered:
                             this game also covers these titles. First in the
                             band because it is a fact about identity, and it
                             draws only when there is coverage to draw.

                             Every row carries ONE entry's minutes beside THAT
                             SAME entry's last-played. The total above them is a
                             sum across stores - Winnow's own composite, which no
                             source reports - and it carries its own coherent
                             date, the latest anywhere in the group. The rows
                             stay on screen underneath so the composite can be
                             checked against its parts.

                             Achievements are per release (6.2), on the release's
                             own row. There is no combined percentage here and no
                             property that could produce one. -->
                        <StackPanel IsVisible="{Binding ShowCoverage}">
                        <StackPanel Spacing="10"
                                    DataContext="{Binding Coverage}"
                                    x:DataType="vm:GameCoverageViewModel">
                            <TextBlock Classes="label" Text="{Binding Heading}"/>

                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Classes="label" FontSize="10"
                                           VerticalAlignment="Center"
                                           Text="{Binding TotalLabel}"/>
                                <TextBlock Grid.Column="1" Classes="data"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Text}"
                                           Text="{Binding TotalPlaytimeText}"/>
                                <TextBlock Grid.Column="2" Classes="body" FontSize="12"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding TotalNote}"/>
                                <TextBlock Grid.Column="3" Classes="data-s"
                                           VerticalAlignment="Center"
                                           Text="{Binding TotalLastPlayedText}"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:CoverageRowViewModel">
                                        <Border BorderBrush="{StaticResource Line}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,9">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="52,*,Auto,Auto,Auto"
                                                      ColumnSpacing="10">
                                                    <TextBlock Grid.Column="0" Classes="data-s"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding StoreBadge}"/>
                                                    <TextBlock Grid.Column="1" Classes="body"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Title}"/>
                                                    <TextBlock Grid.Column="2" Classes="data-s"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding PlaytimeText}"/>
                                                    <TextBlock Grid.Column="3" Classes="data-s"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding LastPlayedText}"/>
                                                    <Button Grid.Column="4" Classes="quiet"
                                                            IsVisible="{Binding IsCovered}"
                                                            AutomationProperties.Name="{Binding SeparateAutomationName}"
                                                            ToolTip.Tip="{Binding SeparateTooltip}"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding $parent[ItemsControl].((vm:GameCoverageViewModel)DataContext).SeparateCommand}">
                                                        <TextBlock Classes="body" FontSize="12"
                                                                   Text="{Binding SeparateLabel}"/>
                                                    </Button>
                                                </Grid>

                                                <StackPanel IsVisible="{Binding HasAchievements}">
                                                <Grid ColumnDefinitions="52,Auto,Auto,*"
                                                      ColumnSpacing="10"
                                                      DataContext="{Binding Achievements}"
                                                      x:DataType="vm:ReleaseAchievementRowViewModel">
                                                    <TextBlock Grid.Column="1" Classes="label"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Label}"/>
                                                    <TextBlock Grid.Column="2" Classes="data-s"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding CountText}"/>
                                                    <TextBlock Grid.Column="3" Classes="data-s"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding PercentText}"/>
                                                </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="body" FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Amber}"
                                       IsVisible="{Binding HasProblem}"
                                       Text="{Binding Problem}"/>
                        </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Classes="label" Text="ABOUT"/>
                            <SelectableTextBlock Classes="body copyable"
                                       Focusable="True"
                                       Foreground="{StaticResource TextDim}"
                                       LineHeight="20"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasSummary}"
                                       Text="{Binding Summary}"/>
                            <!-- §7: an empty screen is a direction, not a mood. -->
                            <TextBlock Classes="body"
                                       Foreground="{StaticResource TextDim}"
                                       LineHeight="20"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding ShowEmptyBody}"
                                       Text="{Binding EmptyBodyText}"/>
                        </StackPanel>

                        <!-- Updates list. Patch-notes links only appear when the
                             update carries a page (§5.2). -->
                        <StackPanel Spacing="4" IsVisible="{Binding HasUpdates}">
                            <TextBlock Classes="label" Text="{Binding UpdatesLabel}"/>
                            <ItemsControl ItemsSource="{Binding Updates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:UpdateEventViewModel">
                                        <Border Classes="updaterow"
                                                BorderBrush="{StaticResource Line}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,9">
                                            <Grid ColumnDefinitions="16,*,Auto,Auto" ColumnSpacing="10">
                                                <!-- Flare: unread-update marker
                                                     only, here as everywhere. -->
                                                <Border Grid.Column="0"
                                                        Width="7" Height="7" CornerRadius="4"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource Flare}"
                                                        BoxShadow="{DynamicResource PipGlow}"
                                                        IsVisible="{Binding IsUnread}"
                                                        ToolTip.Tip="Unread update"/>
                                                <SelectableTextBlock Grid.Column="1" Classes="body copyable"
                                                           Focusable="False"
                                                           Text="{Binding Headline}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Classes="data-s"
                                                           Text="{Binding DateText}"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="3"
                                                        Classes="quiet"
                                                        IsVisible="{Binding HasLink}"
                                                        Click="OnUpdateLinkPressed"
                                                        ToolTip.Tip="{Binding Link.Tooltip}">
                                                    <TextBlock Classes="body" FontSize="12"
                                                               Foreground="{StaticResource Azure}"
                                                               Text="Patch notes"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- "I've read this one": placed under the update list.
                             Not "Not interested"; that is the feed card's verdict. -->
                        <StackPanel Spacing="8" IsVisible="{Binding ShowFlagControl}">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                                  IsVisible="{Binding ShowDismissFlag}">
                                <Button Grid.Column="0" Classes="secondary"
                                        Command="{Binding DismissFlagCommand}"
                                        ToolTip.Tip="{Binding DismissFlagNote}">
                                    <TextBlock Classes="body" FontSize="12"
                                               Text="{Binding DismissFlagLabel}"/>
                                </Button>
                                <TextBlock Grid.Column="1" Classes="body"
                                           FontSize="12" LineHeight="17"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding DismissFlagNote}"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                                  IsVisible="{Binding ShowRestoreFlag}">
                                <Button Grid.Column="0" Classes="secondary"
                                        Command="{Binding RestoreFlagCommand}"
                                        ToolTip.Tip="{Binding RestoreFlagNote}">
                                    <TextBlock Classes="body" FontSize="12"
                                               Text="{Binding RestoreFlagLabel}"/>
                                </Button>
                                <TextBlock Grid.Column="1" Classes="body"
                                           FontSize="12" LineHeight="17"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding RestoreFlagNote}"/>
                            </Grid>

                            <!-- A write that did not land. Controls stay in
                                 place for retry; Amber for attention (§2). -->
                            <TextBlock Classes="body" FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Amber}"
                                       IsVisible="{Binding HasFlagProblem}"
                                       Text="{Binding FlagProblem}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                </Grid>

                <!-- ══ Left: the object ═════════════════════════════════════
                     Declared after right column so Tab reaches Play first
                     (tree order, not TabIndex). -->
                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="18"
                            Margin="0,0,0,24">

                    <Border Height="300"
                            CornerRadius="{StaticResource RadiusTile}"
                            ClipToBounds="True"
                            BorderThickness="1" BorderBrush="{StaticResource LineSoft}">
                        <Panel>
                            <!-- Placeholder is the fallback, never a hole (§7). -->
                            <Border Background="{Binding PlaceholderBrush}"
                                    IsVisible="{Binding ShowPlaceholder}">
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold" FontSize="22" LineHeight="24"
                                           TextWrapping="Wrap" Foreground="White"
                                           VerticalAlignment="Bottom" Margin="16"/>
                            </Border>
                            <!-- Full saturation: the ramp is a scanning aid for
                                 the grid, and the user has already scanned. -->
                            <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                        </Panel>
                    </Border>

                    <!-- What Steam calls it. Selectable because an appid is a
                         thing people paste into a search box. -->
                    <StackPanel Spacing="3" IsVisible="{Binding HasSteamAppId}">
                        <TextBlock Classes="label" FontSize="10" Text="STEAM APPID"/>
                        <SelectableTextBlock Classes="data copyable"
                                   Focusable="True"
                                   HorizontalAlignment="Left"
                                   Text="{Binding SteamAppId}"/>
                    </StackPanel>

                    <!-- Only when there is a path to give. "Not installed" is
                         already a chip at the top, and §7 does not want a fact
                         stated twice on one screen. -->
                    <StackPanel Spacing="3" IsVisible="{Binding HasInstallPath}">
                        <TextBlock Classes="label" FontSize="10" Text="ON DISK"/>
                        <SelectableTextBlock Classes="data-s copyable"
                                   Focusable="True"
                                   Text="{Binding InstallPath}"
                                   LineHeight="15"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>
    </Panel>

</UserControl>
