<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Winnow.App.ViewModels"
             xmlns:conv="using:Winnow.App.Converters"
             xmlns:views="using:Winnow.App.Views"
             xmlns:lists="using:Winnow.App.ViewModels.Lists"
             x:Class="Winnow.App.Views.GameDetailsView"
             x:DataType="vm:GameDetailsViewModel"
             Focusable="True"
             AutomationProperties.Name="{Binding Title, StringFormat='Details of {0}'}"
             AutomationProperties.ControlTypeOverride="Window">
    <UserControl.Resources>
        <!-- Window-relative caps retain the measured limits in §10.1.
             Stretch fills the available card space so switching tabs cannot
             move the persistent header or change the modal's dimensions. -->
        <conv:ScaledLength x:Key="CardWidthCap" Fraction="0.5" Least="860" Most="1582"/>
        <conv:ScaledLength x:Key="CardHeightCap" Fraction="0.667" Least="720"/>
        <ControlTheme x:Key="DetailsTabTheme" TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="TabFocusBorder"
                            BorderThickness="2"
                            BorderBrush="Transparent"
                            CornerRadius="{StaticResource RadiusControl}"
                            Background="Transparent"
                            Margin="0,0,18,0">
                        <Border Name="TabSelectionBorder"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="0,10,0,10">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:selected">
                <Setter Property="Foreground" Value="{StaticResource Volt}"/>
            </Style>
            <Style Selector="^:selected /template/ Border#TabSelectionBorder">
                <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#TabFocusBorder">
                <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            </Style>
            <Style Selector="^:focus-visible /template/ Border#TabFocusBorder">
                <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- Native tabs own selection, keyboard navigation and automation.
             This template only adds the shared divider below their headers. -->
        <Style Selector="TabControl.details-tabs">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="Auto,*">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </Border>
                        <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.details-tabs /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Expander.gog-notes /template/ ToggleButton#ExpanderHeader">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Expander.gog-notes /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground, Expander.gog-notes /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="Expander.gog-notes /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter, Expander.gog-notes /template/ ToggleButton#ExpanderHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Expander.gog-notes /template/ ToggleButton#ExpanderHeader /template/ Path#ExpandCollapseChevron, Expander.gog-notes /template/ ToggleButton#ExpanderHeader:pointerover /template/ Path#ExpandCollapseChevron, Expander.gog-notes /template/ ToggleButton#ExpanderHeader:pressed /template/ Path#ExpandCollapseChevron">
            <Setter Property="Stroke" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Expander.gog-notes /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder, Expander.gog-notes /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ExpandCollapseChevronBorder, Expander.gog-notes /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ExpandCollapseChevronBorder">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Expander.gog-notes /template/ ToggleButton#ExpanderHeader:focus-visible /template/ Border#ToggleButtonBackground">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="ScrollViewer.inner /template/ ScrollBar">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.quiet /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.quiet:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="CheckBox.listtick">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <Border Name="Ring"
                                Margin="-4,0"
                                CornerRadius="{StaticResource RadiusControl}"
                                BorderBrush="{StaticResource Volt}"
                                BorderThickness="2"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <Border Name="Row"
                                Margin="-4,0"
                                Padding="4,0"
                                CornerRadius="{StaticResource RadiusControl}"
                                Background="Transparent">
                            <Grid ColumnDefinitions="14,10,*">
                                <Panel Grid.Column="0" VerticalAlignment="Center">
                                    <Border Name="Box"
                                            Width="14"
                                            Height="14"
                                            CornerRadius="3"
                                            Background="{StaticResource SurfaceRaised}"
                                            BorderBrush="{StaticResource Line}"
                                            BorderThickness="1"/>
                                    <Path Name="Tick"
                                          Data="M 0,3 L 2.6,5.6 L 7.4,0.8"
                                          Stroke="{StaticResource VoltInk}"
                                          StrokeThickness="1.8"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Width="8"
                                          Height="7"
                                          Opacity="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Panel>
                                <ContentPresenter Grid.Column="2"
                                                  Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.listtick:focus-visible /template/ Border#Ring">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="CheckBox.listtick:pointerover /template/ Border#Row">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="CheckBox.listtick:pointerover /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="CheckBox.listtick:checked /template/ Border#Box">
            <Setter Property="Background" Value="{StaticResource Volt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="CheckBox.listtick:checked /template/ Path#Tick">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.link:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.link :is(TextBlock)">
            <Setter Property="Foreground" Value="{StaticResource Azure}"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.secondary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.secondary :is(TextBlock)">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Button.launch">
            <Setter Property="Background" Value="{StaticResource Volt}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.launch /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="Button.launch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VoltHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VoltHover}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <Style Selector="Button.launch:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VoltPress}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VoltPress}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <Style Selector="Button.launch:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource VoltInk}"/>
        </Style>
        <Style Selector="SelectableTextBlock.copyable">
            <Setter Property="Cursor" Value="Ibeam"/>
        </Style>
        <Style Selector="SelectableTextBlock.copyable:focus-visible">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Border.updaterow:pointerover">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedFaint}"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource VoltSelection}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Well}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Well}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Well}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="TextBox.field /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="TextBlock.actstatus">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="TextBlock.actstatus.problem">
            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
        </Style>
        <Style Selector="Button.shot">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.shot /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.shot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="Button.shot.picked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="Button.shot:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
    </UserControl.Styles>
    <Panel>
        <Border Name="Scrim" Background="{StaticResource ModalScrim}" PointerPressed="OnScrimPressed"/>
        <Border Name="Card"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusTile}"
                BoxShadow="0 18 48 0 #A6000000"
                MinWidth="700"
                MaxWidth="{Binding $parent[Window].Bounds.Width,                                    Converter={StaticResource CardWidthCap}}"
                MaxHeight="{Binding $parent[Window].Bounds.Height,                                     Converter={StaticResource CardHeightCap}}"
                Margin="40"
                KeyboardNavigation.TabNavigation="Cycle"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Panel>
                <Border CornerRadius="{StaticResource RadiusTile}" ClipToBounds="True" IsHitTestVisible="False">
                    <Panel>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                        <Border Background="{StaticResource ArtVeil}"/>
                    </Panel>
                </Border>
                <Grid RowDefinitions="Auto,*,Auto" Margin="26,24,26,0">
                    <Grid Name="DetailsHeader"
                          Grid.Row="0"
                          ColumnDefinitions="82,*"
                          ColumnSpacing="20"
                          Margin="0,0,0,16">
                        <StackPanel Grid.Column="1" Spacing="12">
                            <StackPanel Spacing="6"
                                        AutomationProperties.Name="{Binding IdentityGroupName}"
                                        AutomationProperties.AccessibilityView="Control">
                                <Grid ColumnDefinitions="*,Auto">
                                    <SelectableTextBlock Grid.Column="0"
                                                         Classes="display-l copyable"
                                                         Focusable="True"
                                                         FontSize="26"
                                                         AutomationProperties.HeadingLevel="1"
                                                         Text="{Binding Title}"
                                                         TextWrapping="Wrap"
                                                         LineHeight="30"
                                                         Margin="0,0,12,0"/>
                                    <Button Grid.Column="1"
                                            Classes="quiet"
                                            Name="CloseButton"
                                            VerticalAlignment="Top"
                                            Click="OnClosePressed"
                                            AutomationProperties.Name="{Binding CloseAutomationName}"
                                            ToolTip.Tip="Close details">
                                        <TextBlock Classes="body-l" Foreground="{StaticResource TextDim}" Text="×"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasIdentityLine}">
                                    <SelectableTextBlock Grid.Column="0" Classes="data copyable"
                                                         Focusable="False"
                                                         FontSize="12"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextDim}"
                                                         Text="{Binding IdentityYearText}"/>
                                    <SelectableTextBlock Grid.Column="1" Classes="body copyable"
                                                         TextWrapping="Wrap"
                                                         Focusable="False"
                                                         FontSize="12"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextDim}"
                                                         IsVisible="{Binding HasPublisher}"
                                                         Text="{Binding Publisher}"/>
                                </Grid>
                                <TextBlock Classes="body"
                                           FontSize="12"
                                           LineHeight="17"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextDim}"
                                           IsVisible="{Binding TitleIsProvisional}"
                                           Text="{Binding ProvisionalNote}"/>
                            </StackPanel>
                            <WrapPanel ItemSpacing="8" LineSpacing="4">
                                <ItemsControl ItemsSource="{Binding StoreChips}"
                                              ToolTip.Tip="{Binding StoreNames}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="store-chip" Padding="7,3">
                                                <TextBlock Text="{Binding}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="{StaticResource SurfaceRaised}"
                                        CornerRadius="3"
                                        Padding="7,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Classes="body"
                                               FontSize="11"
                                               Foreground="{StaticResource TextDim}"
                                               Text="{Binding BucketLabel}"/>
                                </Border>
                                <Border Background="{StaticResource SurfaceRaised}"
                                        CornerRadius="3"
                                        Padding="7,3"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding HasInstallState}">
                                    <TextBlock Classes="body"
                                               FontSize="11"
                                               Foreground="{StaticResource TextDim}"
                                               Text="{Binding InstallText}"/>
                                </Border>
                            </WrapPanel>
                            <WrapPanel ItemSpacing="10"
                                       LineSpacing="8"
                                       AutomationProperties.Name="{Binding ActionsGroupName}"
                                       AutomationProperties.AccessibilityView="Control">
                                <Button Classes="launch"
                                        Name="LaunchButton"
                                        IsVisible="{Binding HasPrimaryAction}"
                                        AutomationProperties.Name="{Binding LaunchAutomationName}"
                                        ToolTip.Tip="{Binding PrimaryAction.Tooltip}"
                                        Command="{Binding Tile.PrimaryActionCommand}"
                                        CommandParameter="{Binding Tile}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Panel Width="16" Height="16"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                            <Path Name="HeaderPlayGlyph"
                                                  Data="M 4,2 L 14,8 L 4,14 Z"
                                                  Fill="{Binding $parent[Button].Foreground}"
                                                  IsVisible="{Binding Tile.IsPlayAction}"/>
                                            <Path Name="HeaderInstallGlyph"
                                                  Data="M 8,1 L 8,10 M 4.5,6.5 L 8,10 L 11.5,6.5 M 2,13 L 14,13"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.7"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  IsVisible="{Binding Tile.IsInstallAction}"/>
                                        </Panel>
                                        <TextBlock Classes="body"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding $parent[Button].Foreground}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding PrimaryAction.Label}"/>
                                    </StackPanel>
                                </Button>
                                <Button Name="AddToListButton"
                                        Classes="secondary"
                                        AutomationProperties.Name="Add to list"
                                        ToolTip.Tip="Add this game to a list"
                                        IsVisible="{Binding ShowAddToList}"
                                        Command="{Binding AddToListCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Name="HeaderAddToListGlyph"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="1.6"
                                              StrokeLineCap="Round"
                                              Data="M 2,4 L 9,4 M 2,8 L 9,8 M 2,12 L 7,12 M 12,9 L 12,15 M 9,12 L 15,12"/>
                                        <TextBlock Classes="body"
                                                   FontSize="13"
                                                   Foreground="{Binding $parent[Button].Foreground}"
                                                   VerticalAlignment="Center"
                                                   Text="Add to list"/>
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="{Binding MoreActionsLabel}"
                                        Classes="secondary"
                                        Name="MoreActionsButton"
                                        IsVisible="{Binding HasMoreActions}"
                                        ToolTip.Tip="{Binding MoreActionsTooltip}">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="actions">
                                            <MenuItem Name="ManageInstallationItem"
                                                      Header="{Binding ManagementAction.Label}"
                                                      IsVisible="{Binding HasManagementAction}"
                                                      ToolTip.Tip="{Binding ManagementAction.Tooltip}"/>
                                            <MenuItem Name="OpenFolderItem"
                                                      Header="Open folder"
                                                      IsVisible="{Binding HasOpenableFolder}"
                                                      ToolTip.Tip="{Binding InstallPath}"/>
                                            <MenuItem Name="RefetchItem"
                                                      Header="{Binding Refetch.MenuLabel}"
                                                      IsVisible="{Binding ShowRefetch}"
                                                      Command="{Binding Refetch.RefetchCommand}"
                                                      ToolTip.Tip="{Binding Refetch.MenuTooltip}"/>
                                            <MenuItem Name="WrongGameItem"
                                                      Header="{Binding IgdbMatch.OpenLabel}"
                                                      IsVisible="{Binding ShowIgdbMatch}"
                                                      Command="{Binding IgdbMatch.OpenCommand}"
                                                      ToolTip.Tip="{Binding IgdbMatch.OpenTooltip}"/>
                                            <MenuItem Name="EditDetailsItem"
                                                      Header="{Binding MetadataEditor.OpenLabel}"
                                                      IsVisible="{Binding ShowMetadataEditor}"
                                                      Command="{Binding MetadataEditor.OpenCommand}"
                                                      ToolTip.Tip="{Binding MetadataEditor.OpenTooltip}"/>
                                            <MenuItem Name="HideItem"
                                                      Header="{Binding HideLabel}"
                                                      IsVisible="{Binding ShowHide}"
                                                      Command="{Binding HideCommand}"
                                                      CommandParameter="{Binding Tile}"
                                                      ToolTip.Tip="{Binding HideTooltip}"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <TextBlock Classes="body" FontSize="12" Text="{Binding MoreActionsLabel}"/>
                                </Button>
                            </WrapPanel>
                            <TextBlock Classes="body"
                                       Name="NoWayInLine"
                                       FontSize="12"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasNoWayInSentence}"
                                       Text="{Binding NoWayInSentence}"/>
                        </StackPanel>
                        <Border Grid.Row="0"
                                Name="HeaderCover"
                                Width="82"
                                Height="123"
                                VerticalAlignment="Top"
                                CornerRadius="{StaticResource RadiusControl}"
                                ClipToBounds="True"
                                BorderThickness="1"
                                BorderBrush="{StaticResource LineSoft}">
                            <Panel>
                                <Border Background="{Binding PlaceholderBrush}" IsVisible="{Binding ShowPlaceholder}">
                                    <TextBlock Text="{Binding Title}"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               LineHeight="15"
                                               TextWrapping="Wrap"
                                               Foreground="White"
                                               VerticalAlignment="Bottom"
                                               Margin="8"/>
                                </Border>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                            </Panel>
                        </Border>
                    </Grid>
                    <Panel Grid.Row="1">
                        <!-- Explicit page content retains each scroll offset and
                             its controls while native tabs select the visible page. -->
                        <TabControl Name="DetailsTabs"
                                    Classes="details-tabs"
                                    IsVisible="{Binding ShowDetailsTabs}"
                                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                                    Background="Transparent"
                                    Padding="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="Game details"
                                    KeyDown="OnDetailsTabsKeyDown">
                            <TabItem Name="OverviewTab"
                                     Theme="{StaticResource DetailsTabTheme}"
                                     Header="{x:Static vm:GameDetailsCopy.OverviewTab}"
                                     AutomationProperties.Name="{x:Static vm:GameDetailsCopy.OverviewTab}">
                                <ScrollViewer Name="OverviewScroll"
                                              Classes="inner"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="{StaticResource InnerScrollGutter}">
                                        <StackPanel Spacing="24" Margin="0,24,0,24">
                                            <Border BorderBrush="{StaticResource Line}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,0,0,20">
                                                <StackPanel Spacing="8">
                                                    <WrapPanel ItemSpacing="10" LineSpacing="4">
                                                        <TextBlock Classes="data"
                                                                   FontSize="24"
                                                                   Text="{Binding PlaytimeText}"/>
                                                        <TextBlock Classes="body"
                                                                   VerticalAlignment="Center"
                                                                   Text="played"/>
                                                        <TextBlock Classes="body"
                                                                   Foreground="{StaticResource TextDim}"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding OverviewHistoryText}"/>
                                                    </WrapPanel>
                                                    <Button Name="UpdatesShortcutButton"
                                                            Classes="quiet"
                                                            HorizontalAlignment="Left"
                                                            IsVisible="{Binding HasUnreadUpdates}"
                                                            Command="{Binding ShowActivityCommand}"
                                                            Click="OnActivityShortcutPressed"
                                                            AutomationProperties.Name="{Binding UpdatesShortcutText}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Width="7"
                                                                    Height="7"
                                                                    CornerRadius="4"
                                                                    Background="{StaticResource Flare}"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Classes="body"
                                                                       Text="{Binding UpdatesShortcutText}"/>
                                                            <TextBlock Classes="body"
                                                                       Foreground="{StaticResource Azure}"
                                                                       Text="→"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Classes="body"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasLifecycle}"
                                                       Text="{Binding LifecycleText}"/>
                                            <StackPanel Spacing="7">
                                                <TextBlock Classes="label section"
                                                           Text="{Binding AboutHeading}"
                                                           AutomationProperties.HeadingLevel="2"/>
                                                <SelectableTextBlock Classes="body prose copyable"
                                                                     Focusable="True"
                                                                     LineHeight="20"
                                                                     IsVisible="{Binding HasSummary}"
                                                                     Name="SummaryTextBlock"
                                                                     Text="{Binding SummaryText}"/>
                                                <Button Name="SummaryDisclosureButton"
                                                        Classes="quiet"
                                                        HorizontalAlignment="Left"
                                                        IsVisible="{Binding CanExpandSummary}"
                                                        Content="{Binding SummaryDisclosureLabel}"
                                                        AutomationProperties.Name="{Binding SummaryDisclosureLabel}"
                                                        Command="{Binding ToggleSummaryCommand}"/>
                                                <TextBlock Classes="body prose"
                                                           LineHeight="20"
                                                           IsVisible="{Binding ShowEmptyBody}"
                                                           Text="{Binding EmptyBodyText}"/>
                                                <StackPanel IsVisible="{Binding ShowScreenshots}">
                                                    <StackPanel Spacing="8"
                                                                DataContext="{Binding Screenshots}"
                                                                x:DataType="vm:GameScreenshotsViewModel">
                                                        <ScrollViewer x:Name="ScreenshotScroll"
                                                                      Classes="inner"
                                                                      GotFocus="OnScreenshotGotFocus"
                                                                      IsScrollChainingEnabled="False"
                                                                      HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollBarVisibility="Disabled">
                                                            <ItemsControl ItemsSource="{Binding Shots}"
                                                                          Margin="{StaticResource InnerScrollGutterBottom}"
                                                                          AutomationProperties.Name="{Binding ListAutomationName}"
                                                                          AutomationProperties.AccessibilityView="Control">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Spacing="8"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="vm:GameScreenshotViewModel">
                                                                        <Button Classes="shot"
                                                                                Classes.picked="{Binding IsSelected}"
                                                                                Width="120"
                                                                                Height="68"
                                                                                Click="OnShotPressed"
                                                                                AutomationProperties.Name="{Binding AutomationName}"
                                                                                AutomationProperties.ControlTypeOverride="ListItem"
                                                                                ToolTip.Tip="{Binding Tooltip}"
                                                                                CommandParameter="{Binding}"
                                                                                Command="{Binding $parent[ItemsControl].((vm:GameScreenshotsViewModel)DataContext).SelectCommand}">
                                                                            <Border ClipToBounds="True"
                                                                                    CornerRadius="2"
                                                                                    Background="{StaticResource SurfaceRaised}">
                                                                                <Image Source="{Binding Image}"
                                                                                       Stretch="UniformToFill"/>
                                                                            </Border>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                        <TextBlock Classes="data-s" Text="{Binding Caption}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Reception.Figures}"
                                                          IsVisible="{Binding ShowReception}"
                                                          AutomationProperties.Name="{Binding Reception.AutomationName}"
                                                          AutomationProperties.AccessibilityView="Control"
                                                          AutomationProperties.ControlTypeOverride="Group">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:ReceptionFigureViewModel">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="6"
                                                                    Margin="0,0,14,0"
                                                                    ToolTip.Tip="{Binding Tooltip}"
                                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                                    AutomationProperties.AccessibilityView="Control">
                                                            <TextBlock Classes="label"
                                                                       FontSize="10"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding Source}"/>
                                                            <TextBlock Classes="data"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Text}"
                                                                       Text="{Binding Value}"/>
                                                            <TextBlock Classes="data-s"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding Count}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel IsVisible="{Binding ShowExtends}">
                                                <StackPanel Spacing="10"
                                                            DataContext="{Binding Expansions}"
                                                            x:DataType="vm:GameExpansionsViewModel">
                                                    <TextBlock Classes="label section"
                                                               Text="{Binding ExtendsHeading}"
                                                               AutomationProperties.HeadingLevel="2"/>
                                                    <ContentControl Content="{Binding Extends}">
                                                        <ContentControl.ContentTemplate>
                                                            <DataTemplate DataType="vm:ExpansionRowViewModel">
                                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                                      ColumnSpacing="10">
                                                                    <TextBlock Grid.Column="0"
                                                                               Classes="body"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Text="{Binding Title}"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Classes="data-s"
                                                                               VerticalAlignment="Center"
                                                                               Text="{Binding PlaytimeText}"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Classes="data-s"
                                                                               VerticalAlignment="Center"
                                                                               Text="{Binding LastPlayedText}"/>
                                                                    <Button Grid.Column="3"
                                                                            Classes="quiet"
                                                                            AutomationProperties.Name="{Binding UngroupAutomationName}"
                                                                            ToolTip.Tip="{Binding UngroupTooltip}"
                                                                            CommandParameter="{Binding}"
                                                                            Command="{Binding $parent[ContentControl].((vm:GameExpansionsViewModel)DataContext).UngroupCommand}">
                                                                        <TextBlock Classes="body"
                                                                                   FontSize="12"
                                                                                   Text="{Binding UngroupLabel}"/>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ContentControl.ContentTemplate>
                                                    </ContentControl>
                                                    <TextBlock Classes="body"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding ExtendsNote}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel IsVisible="{Binding ShowExpansions}">
                                                <StackPanel Spacing="10"
                                                            DataContext="{Binding Expansions}"
                                                            x:DataType="vm:GameExpansionsViewModel">
                                                    <Expander Name="ExpansionsDisclosure"
                                                              Classes="gog-notes"
                                                              Header="{Binding Heading}"
                                                              AutomationProperties.Name="{Binding Heading}"
                                                              HorizontalAlignment="Stretch">
                                                        <StackPanel Spacing="10" Margin="0,16,0,0">
                                                            <TextBlock Classes="body"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       Text="{Binding Note}"/>
                                                            <ItemsControl ItemsSource="{Binding Expansions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="vm:ExpansionRowViewModel">
                                                                        <Border BorderBrush="{StaticResource Line}"
                                                                                BorderThickness="0,0,0,1"
                                                                                Padding="0,9">
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                                                  ColumnSpacing="10">
                                                                                <ItemsControl Grid.Column="0"
                                                                                              VerticalAlignment="Center"
                                                                                              IsVisible="{Binding HasStores}"
                                                                                              ToolTip.Tip="{Binding StoreNames}"
                                                                                              ItemsSource="{Binding StoreChips}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal"
                                                                                                        Spacing="4"/>
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Classes="store-chip">
                                                                                                <TextBlock Text="{Binding}"/>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <TextBlock Grid.Column="1"
                                                                                           Classes="body"
                                                                                           VerticalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           Text="{Binding Title}"/>
                                                                                <TextBlock Grid.Column="2"
                                                                                           Classes="data-s"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="{Binding PlaytimeText}"/>
                                                                                <TextBlock Grid.Column="3"
                                                                                           Classes="data-s"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="{Binding LastPlayedText}"/>
                                                                                <Button Grid.Column="4"
                                                                                        Classes="quiet"
                                                                                        AutomationProperties.Name="{Binding UngroupAutomationName}"
                                                                                        ToolTip.Tip="{Binding UngroupTooltip}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:GameExpansionsViewModel)DataContext).UngroupCommand}">
                                                                                    <TextBlock Classes="body"
                                                                                               FontSize="12"
                                                                                               Text="{Binding UngroupLabel}"/>
                                                                                </Button>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Classes="body"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource Amber}"
                                                                       IsVisible="{Binding HasProblem}"
                                                                       Text="{Binding Problem}"/>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Name="ActivityTab"
                                     Theme="{StaticResource DetailsTabTheme}"
                                     AutomationProperties.Name="{Binding ActivityTabAutomationName}"
                                     AutomationProperties.ItemStatus="{Binding UpdatesShortcutText}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Static vm:GameDetailsCopy.ActivityTab}"/>
                                        <Border Width="6"
                                                Height="6"
                                                CornerRadius="3"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource Flare}"
                                                IsVisible="{Binding HasUnreadUpdates}"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer Name="ActivityScroll"
                                              Classes="inner"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="{StaticResource InnerScrollGutter}">
                                        <StackPanel Spacing="24" Margin="0,24,0,24">
                                            <views:ActivityTrackerView DataContext="{Binding Tracker}"/>
                                            <StackPanel Spacing="4" IsVisible="{Binding HasUpdates}">
                                                <TextBlock Classes="label section"
                                                           Text="{Binding UpdatesLabel}"
                                                           AutomationProperties.HeadingLevel="2"/>
                                                <ItemsControl ItemsSource="{Binding Updates}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:UpdateEventViewModel">
                                                            <Border Classes="updaterow"
                                                                    BorderBrush="{StaticResource Line}"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="0,9"
                                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                                    AutomationProperties.AccessibilityView="Control"
                                                                    AutomationProperties.ControlTypeOverride="ListItem">
                                                                <Grid ColumnDefinitions="16,*,Auto,Auto"
                                                                      ColumnSpacing="10">
                                                                    <Border Grid.Column="0"
                                                                            Width="7"
                                                                            Height="7"
                                                                            CornerRadius="4"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Center"
                                                                            Background="{StaticResource Flare}"
                                                                            BoxShadow="{DynamicResource PipGlow}"
                                                                            IsVisible="{Binding IsUnread}"
                                                                            ToolTip.Tip="Unread update"/>
                                                                    <SelectableTextBlock Grid.Column="1"
                                                                                         Classes="body copyable"
                                                                                         Focusable="False"
                                                                                         Text="{Binding Headline}"
                                                                                         TextTrimming="CharacterEllipsis"
                                                                                         VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Classes="data-s"
                                                                               Text="{Binding DateText}"
                                                                               VerticalAlignment="Center"/>
                                                                    <Button AutomationProperties.Name="Patch notes"
                                                                            Grid.Column="3"
                                                                            Classes="quiet"
                                                                            IsVisible="{Binding HasLink}"
                                                                            Click="OnUpdateLinkPressed"
                                                                            ToolTip.Tip="{Binding Link.Tooltip}">
                                                                        <TextBlock Classes="body"
                                                                                   FontSize="12"
                                                                                   Foreground="{StaticResource Azure}"
                                                                                   Text="Patch notes"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Classes="body"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           LineHeight="18"
                                                           Margin="26,4,0,0"
                                                           Foreground="{StaticResource TextDim}"
                                                           IsVisible="{Binding ShowNoNotesNote}"
                                                           Text="{Binding NoNotesText}"/>
                                            </StackPanel>
                                            <TextBlock Classes="body prose"
                                                       IsVisible="{Binding HasNoUpdates}"
                                                       Text="{x:Static vm:GameDetailsCopy.UpdatesEmpty}"/>
                                            <StackPanel Spacing="8" IsVisible="{Binding ShowFlagControl}">
                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="12"
                                                      IsVisible="{Binding ShowDismissFlag}">
                                                    <Button AutomationProperties.Name="{Binding DismissFlagLabel}"
                                                            Grid.Column="0"
                                                            Classes="secondary"
                                                            Command="{Binding DismissFlagCommand}"
                                                            ToolTip.Tip="{Binding DismissFlagNote}">
                                                        <TextBlock Classes="body"
                                                                   FontSize="12"
                                                                   Text="{Binding DismissFlagLabel}"/>
                                                    </Button>
                                                    <TextBlock Grid.Column="1"
                                                               Classes="body"
                                                               FontSize="12"
                                                               LineHeight="17"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextDim}"
                                                               Text="{Binding DismissFlagNote}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="12"
                                                      IsVisible="{Binding ShowRestoreFlag}">
                                                    <Button AutomationProperties.Name="{Binding RestoreFlagLabel}"
                                                            Grid.Column="0"
                                                            Classes="secondary"
                                                            Command="{Binding RestoreFlagCommand}"
                                                            ToolTip.Tip="{Binding RestoreFlagNote}">
                                                        <TextBlock Classes="body"
                                                                   FontSize="12"
                                                                   Text="{Binding RestoreFlagLabel}"/>
                                                    </Button>
                                                    <TextBlock Grid.Column="1"
                                                               Classes="body"
                                                               FontSize="12"
                                                               LineHeight="17"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextDim}"
                                                               Text="{Binding RestoreFlagNote}"/>
                                                </Grid>
                                                <TextBlock Classes="body"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource Amber}"
                                                           IsVisible="{Binding HasFlagProblem}"
                                                           Text="{Binding FlagProblem}"/>
                                            </StackPanel>
                                            <Expander Header="GOG patch notes"
                                                      Classes="gog-notes"
                                                      Background="{StaticResource Surface}"
                                                      BorderBrush="{StaticResource Line}"
                                                      AutomationProperties.Name="GOG patch notes"
                                                      IsVisible="{Binding HasGogPatchNotes}"
                                                      Margin="0,12,0,0"
                                                      HorizontalAlignment="Stretch">
                                                <TextBlock Classes="body"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding GogPatchNotes}"/>
                                            </Expander>
                                            <StackPanel IsVisible="{Binding ShowJournal}">
                                                <views:GameJournalView DataContext="{Binding Journal}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Name="LibraryTab"
                                     Theme="{StaticResource DetailsTabTheme}"
                                     Header="{x:Static vm:GameDetailsCopy.LibraryTab}"
                                     AutomationProperties.Name="{x:Static vm:GameDetailsCopy.LibraryTab}">
                                <ScrollViewer Name="LibraryScroll"
                                              Classes="inner"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="{StaticResource InnerScrollGutter}">
                                        <StackPanel Spacing="24" Margin="0,24,0,24">
                                            <StackPanel IsVisible="{Binding ShowCopyBreakdown}">
                                                <StackPanel Spacing="10"
                                                            DataContext="{Binding Coverage}"
                                                            x:DataType="vm:GameCoverageViewModel">
                                                    <TextBlock Classes="label section"
                                                               Text="{x:Static vm:GameDetailsCopy.YourCopies}"
                                                               AutomationProperties.HeadingLevel="2"/>
                                                    <Grid IsVisible="{Binding IsComposite}"
                                                          ColumnDefinitions="Auto,Auto,*,Auto"
                                                          ColumnSpacing="12">
                                                        <TextBlock Grid.Column="0"
                                                                   Classes="label"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding TotalLabel}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Classes="data"
                                                                   FontSize="18"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Text}"
                                                                   Text="{Binding TotalPlaytimeText}"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Classes="body"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextDim}"
                                                                   Text="{Binding TotalNote}"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Classes="data-s"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding TotalLastPlayedText}"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:CoverageRowViewModel">
                                                                <Border BorderBrush="{StaticResource Line}"
                                                                        BorderThickness="0,0,0,1"
                                                                        Padding="0,9">
                                                                    <StackPanel Spacing="4">
                                                                        <Grid ColumnDefinitions="52,*,Auto,Auto,Auto"
                                                                              ColumnSpacing="10">
                                                                            <TextBlock Grid.Column="0"
                                                                                       Classes="data-s"
                                                                                       VerticalAlignment="Center"
                                                                                       Text="{Binding StoreBadge}"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Classes="body"
                                                                                       VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       Text="{Binding Title}"/>
                                                                            <TextBlock Grid.Column="2"
                                                                                       Classes="data-s"
                                                                                       VerticalAlignment="Center"
                                                                                       Text="{Binding PlaytimeText}"/>
                                                                            <TextBlock Grid.Column="3"
                                                                                       Classes="data-s"
                                                                                       VerticalAlignment="Center"
                                                                                       Text="{Binding LastPlayedText}"/>
                                                                            <Button Grid.Column="4"
                                                                                    Classes="quiet"
                                                                                    IsVisible="{Binding IsCovered}"
                                                                                    AutomationProperties.Name="{Binding SeparateAutomationName}"
                                                                                    ToolTip.Tip="{Binding SeparateTooltip}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:GameCoverageViewModel)DataContext).SeparateCommand}">
                                                                                <TextBlock Classes="body"
                                                                                           FontSize="12"
                                                                                           Text="{Binding SeparateLabel}"/>
                                                                            </Button>
                                                                        </Grid>
                                                                        <StackPanel IsVisible="{Binding HasAchievements}">
                                                                            <Grid ColumnDefinitions="52,Auto,Auto,*"
                                                                                  ColumnSpacing="10"
                                                                                  DataContext="{Binding Achievements}"
                                                                                  x:DataType="vm:ReleaseAchievementRowViewModel">
                                                                                <TextBlock Grid.Column="1"
                                                                                           Classes="label"
                                                                                           FontSize="10"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="{Binding Label}"/>
                                                                                <TextBlock Grid.Column="2"
                                                                                           Classes="data-s"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="{Binding CountText}"/>
                                                                                <TextBlock Grid.Column="3"
                                                                                           Classes="data-s"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="{Binding PercentText}"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Classes="body"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource Amber}"
                                                               IsVisible="{Binding HasProblem}"
                                                               Text="{Binding Problem}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Spacing="12" IsVisible="{Binding ShowOwnCopies}">
                                                <TextBlock Classes="label section"
                                                           Text="{x:Static vm:GameDetailsCopy.YourCopies}"
                                                           AutomationProperties.HeadingLevel="2"/>
                                                <ItemsControl ItemsSource="{Binding OwnCopies}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:DetailsCopyRow">
                                                            <Border BorderBrush="{StaticResource Line}"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="0,12">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Classes="body"
                                                                                   Text="{Binding Store}"/>
                                                                        <TextBlock Classes="body"
                                                                                   Foreground="{StaticResource TextDim}"
                                                                                   Text="{Binding InstallState}"
                                                                                   IsVisible="{Binding HasInstallState}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1"
                                                                                Spacing="4"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock Classes="data"
                                                                                   Text="{Binding Playtime, StringFormat='{}{0} played'}"/>
                                                                        <TextBlock Classes="data-s"
                                                                                   Text="{Binding LastPlayed}"
                                                                                   IsVisible="{Binding HasLastPlayed}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel IsVisible="{Binding ShowLists}">
                                                <StackPanel Spacing="10"
                                                            DataContext="{Binding Lists}"
                                                            x:DataType="lists:GameListsViewModel">
                                                    <TextBlock Classes="label section"
                                                               Text="{Binding Heading}"
                                                               AutomationProperties.HeadingLevel="2"/>
                                                    <TextBlock Classes="body"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               LineHeight="18"
                                                               IsVisible="{Binding IsEmpty}"
                                                               Text="{Binding EmptyText}"/>
                                                    <ItemsControl IsVisible="{Binding HasLists}"
                                                                  ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="lists:GameListEntryViewModel">
                                                                <CheckBox Classes="listtick"
                                                                          IsChecked="{Binding IsMember, Mode=TwoWay}"
                                                                          AutomationProperties.Name="{Binding AutomationName}"
                                                                          ToolTip.Tip="{Binding AutomationName}">
                                                                    <TextBlock Classes="body"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Text="{Binding Name}"/>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Spacing="3" IsVisible="{Binding ShowAcquisition}">
                                                <TextBlock Classes="label"
                                                           FontSize="10"
                                                           Text="{Binding AcquiredLabel}"/>
                                                <StackPanel Spacing="3"
                                                            DataContext="{Binding Acquisition}"
                                                            x:DataType="vm:GameAcquisitionViewModel">
                                                    <SelectableTextBlock Classes="data copyable"
                                                                         Focusable="False"
                                                                         HorizontalAlignment="Left"
                                                                         IsVisible="{Binding HasDate}"
                                                                         Text="{Binding DateText}"/>
                                                    <TextBlock Classes="body"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextDim}"
                                                               IsVisible="{Binding HasLicence}"
                                                               Text="{Binding LicenseText}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Expander Name="TechnicalFactsDisclosure"
                                                      Classes="gog-notes"
                                                      Header="{x:Static vm:GameDetailsCopy.TechnicalFacts}"
                                                      AutomationProperties.Name="{x:Static vm:GameDetailsCopy.TechnicalFacts}"
                                                      IsVisible="{Binding HasTechnicalFacts}"
                                                      HorizontalAlignment="Stretch">
                                                <StackPanel Spacing="18" Margin="0,16,0,0">
                                                    <StackPanel Spacing="3" IsVisible="{Binding HasSteamAppId}">
                                                        <TextBlock Classes="label" FontSize="10" Text="STEAM APPID"/>
                                                        <SelectableTextBlock Classes="data copyable"
                                                                             Focusable="True"
                                                                             HorizontalAlignment="Left"
                                                                             Text="{Binding SteamAppId}"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="3" IsVisible="{Binding HasInstallPath}">
                                                        <TextBlock Classes="label" FontSize="10" Text="ON DISK"/>
                                                        <SelectableTextBlock Classes="data-s copyable"
                                                                             Focusable="True"
                                                                             Text="{Binding InstallPath}"
                                                                             LineHeight="15"
                                                                             TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button AutomationProperties.Name="{Binding IgdbMatch.ClearLabel}"
                                                            Name="IgdbClearButton"
                                                            Classes="link"
                                                            HorizontalAlignment="Left"
                                                            IsVisible="{Binding IgdbMatch.ShowPinned, FallbackValue=False}"
                                                            Command="{Binding IgdbMatch.ClearCommand}"
                                                            ToolTip.Tip="{Binding IgdbMatch.ClearTooltip}">
                                                        <TextBlock Classes="body"
                                                                   FontSize="12"
                                                                   Text="{Binding IgdbMatch.ClearLabel}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                        <Grid Name="FocusedDetailsHost" RowDefinitions="Auto,*" IsVisible="{Binding IsFocusedView}">
                            <Button Grid.Row="0"
                                    Name="BackToDetailsButton"
                                    Classes="quiet"
                                    HorizontalAlignment="Left"
                                    Content="{x:Static vm:GameDetailsCopy.BackToDetails}"
                                    AutomationProperties.Name="{x:Static vm:GameDetailsCopy.BackToDetails}"
                                    Command="{Binding BackToDetailsCommand}"/>
                            <Grid Grid.Row="1">
                                <ScrollViewer Name="FocusedDetailsScroll"
                                              Classes="inner"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="{StaticResource InnerScrollGutter}">
                                        <StackPanel Spacing="24" Margin="0,24,0,24">
                                            <StackPanel Name="IgdbMatchHost" IsVisible="{Binding IsMatchFocused}">
                                                <StackPanel DataContext="{Binding IgdbMatch}"
                                                            x:DataType="vm:GameIgdbMatchViewModel">
                                                    <TextBlock Classes="body"
                                                               FontSize="12"
                                                               Margin="0,18,0,0"
                                                               TextWrapping="Wrap"
                                                               LineHeight="17"
                                                               Foreground="{StaticResource TextDim}"
                                                               IsVisible="{Binding HasNote}"
                                                               Text="{Binding Note}"/>
                                                    <StackPanel Name="IgdbMatchDisclosure"
                                                                Spacing="10"
                                                                Margin="0,18,0,0"
                                                                IsVisible="{Binding IsOpen}">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Classes="label section"
                                                                       VerticalAlignment="Center"
                                                                       AutomationProperties.HeadingLevel="2"
                                                                       Text="{Binding SectionHeading}"/>
                                                            <Button Grid.Column="1"
                                                                    Classes="quiet"
                                                                    Name="MatchCloseButton"
                                                                    VerticalAlignment="Top"
                                                                    Command="{Binding CloseCommand}"
                                                                    Click="OnSectionClosePressed"
                                                                    AutomationProperties.Name="{Binding CloseAutomationName}"
                                                                    ToolTip.Tip="{Binding CloseTooltip}">
                                                                <TextBlock Classes="body-l"
                                                                           Foreground="{StaticResource TextDim}"
                                                                           Text="×"/>
                                                            </Button>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBox Grid.Column="0"
                                                                     Name="MatchQueryField"
                                                                     Classes="field"
                                                                     Watermark="{Binding FieldWatermark}"
                                                                     AutomationProperties.Name="{Binding FieldLabel}"
                                                                     Text="{Binding Query, Mode=TwoWay}"
                                                                     KeyDown="OnMatchQueryKeyDown"/>
                                                            <Button AutomationProperties.Name="{Binding SearchLabel}"
                                                                    Grid.Column="1"
                                                                    Classes="secondary"
                                                                    Command="{Binding SearchCommand}">
                                                                <TextBlock Classes="body"
                                                                           FontSize="12"
                                                                           Text="{Binding SearchLabel}"/>
                                                            </Button>
                                                        </Grid>
                                                        <TextBlock Classes="body"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextDim}"
                                                                   IsVisible="{Binding HasStatus}"
                                                                   Text="{Binding Status}"/>
                                                        <TextBlock Classes="body"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="17"
                                                                   Foreground="{StaticResource TextDim}"
                                                                   IsVisible="{Binding ShowIdMiss}"
                                                                   Text="{Binding IdMissText}"/>
                                                        <TextBlock Classes="body"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="17"
                                                                   Foreground="{StaticResource TextDim}"
                                                                   IsVisible="{Binding ShowNoMatches}"
                                                                   Text="{Binding NoMatchesText}"/>
                                                        <Border IsVisible="{Binding ShowClaim}"
                                                                BorderBrush="{StaticResource Line}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource RadiusControl}"
                                                                Padding="12">
                                                            <StackPanel Spacing="10">
                                                                <TextBlock Classes="body"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="17"
                                                                           Text="{Binding Claim.Headline}"/>
                                                                <Grid ColumnDefinitions="34,*" ColumnSpacing="12">
                                                                    <Border Grid.Column="0"
                                                                            Width="34"
                                                                            Height="51"
                                                                            VerticalAlignment="Top"
                                                                            ClipToBounds="True"
                                                                            CornerRadius="{StaticResource RadiusControl}"
                                                                            Background="{StaticResource SurfaceRaised}">
                                                                        <Image Source="{Binding Claim.Cover}"
                                                                               Stretch="UniformToFill"/>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1"
                                                                                Spacing="4"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock Classes="body"
                                                                                   FontSize="12"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Text="{Binding Claim.Name}"/>
                                                                        <TextBlock Classes="data-s"
                                                                                   IsVisible="{Binding Claim.HasYear, FallbackValue=False}"
                                                                                   Text="{Binding Claim.YearText}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Button Classes="secondary"
                                                                            AutomationProperties.Name="{Binding Claim.LinkAutomationName}"
                                                                            ToolTip.Tip="{Binding Claim.LinkAutomationName}"
                                                                            Command="{Binding LinkClaimCommand}">
                                                                        <TextBlock Classes="body"
                                                                                   FontSize="12"
                                                                                   Text="{Binding ClaimLinkLabel}"/>
                                                                    </Button>
                                                                    <Button AutomationProperties.Name="{Binding ClaimDeclineLabel}"
                                                                            Classes="quiet"
                                                                            Command="{Binding DeclineClaimCommand}">
                                                                        <TextBlock Classes="body"
                                                                                   FontSize="12"
                                                                                   Text="{Binding ClaimDeclineLabel}"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <ScrollViewer Classes="inner"
                                                                      MaxHeight="238"
                                                                      IsVisible="{Binding HasCandidates}"
                                                                      GotFocus="OnCandidateGotFocus"
                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                      VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl ItemsSource="{Binding Candidates}"
                                                                          Margin="{StaticResource InnerScrollGutter}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="vm:IgdbCandidateViewModel">
                                                                        <Border BorderBrush="{StaticResource Line}"
                                                                                BorderThickness="0,0,0,1"
                                                                                Padding="0,8">
                                                                            <Grid ColumnDefinitions="34,*,Auto"
                                                                                  ColumnSpacing="12">
                                                                                <Border Grid.Column="0"
                                                                                        Width="34"
                                                                                        Height="51"
                                                                                        VerticalAlignment="Top"
                                                                                        ClipToBounds="True"
                                                                                        CornerRadius="{StaticResource RadiusControl}"
                                                                                        Background="{StaticResource SurfaceRaised}">
                                                                                    <Image Source="{Binding Cover}"
                                                                                           Stretch="UniformToFill"/>
                                                                                </Border>
                                                                                <StackPanel Grid.Column="1"
                                                                                            Spacing="4"
                                                                                            VerticalAlignment="Center">
                                                                                    <Grid ColumnDefinitions="Auto,*">
                                                                                        <Border Grid.Column="0"
                                                                                                Classes="store-chip"
                                                                                                Margin="0,0,6,0"
                                                                                                IsVisible="{Binding IsIdMatch}">
                                                                                            <TextBlock Text="{Binding IdMatchLabel}"/>
                                                                                        </Border>
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Classes="body"
                                                                                                   FontSize="12"
                                                                                                   VerticalAlignment="Center"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   Text="{Binding Name}"/>
                                                                                    </Grid>
                                                                                    <Grid ColumnDefinitions="Auto,*"
                                                                                          IsVisible="{Binding HasDetailLine}">
                                                                                        <TextBlock Grid.Column="0"
                                                                                                   Classes="data-s"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Text="{Binding YearText}"/>
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Classes="body"
                                                                                                   FontSize="11"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Foreground="{StaticResource TextDim}"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   ToolTip.Tip="{Binding PlatformsTooltip}"
                                                                                                   Text="{Binding PlatformsText}"/>
                                                                                    </Grid>
                                                                                </StackPanel>
                                                                                <Button Grid.Column="2"
                                                                                        Classes="quiet"
                                                                                        VerticalAlignment="Center"
                                                                                        AutomationProperties.Name="{Binding AssignAutomationName}"
                                                                                        ToolTip.Tip="{Binding AssignAutomationName}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:GameIgdbMatchViewModel)DataContext).AssignCommand}">
                                                                                    <TextBlock Classes="body"
                                                                                               FontSize="12"
                                                                                               Text="{Binding AssignLabel}"/>
                                                                                </Button>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                    <TextBlock Classes="body"
                                                               FontSize="11"
                                                               Margin="0,18,0,0"
                                                               TextWrapping="Wrap"
                                                               LineHeight="16"
                                                               Foreground="{StaticResource Amber}"
                                                               IsVisible="{Binding HasProblem}"
                                                               Text="{Binding Problem}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Name="MetadataEditorHost"
                                                        IsVisible="{Binding IsMetadataFocused}">
                                                <views:GameMetadataEditorView Name="MetadataEditorView"
                                                                              DataContext="{Binding MetadataEditor}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Panel>
                    <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,16">
                        <TextBlock Classes="body actstatus"
                                   Name="RefetchStatus"
                                   FontSize="12"
                                   LineHeight="17"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Classes.problem="{Binding Refetch.IsProblem, FallbackValue=False}"
                                   IsVisible="{Binding Refetch.HasStatus, FallbackValue=False}"
                                   Text="{Binding Refetch.Status}"/>
                        <StackPanel IsVisible="{Binding ShowDetailsTabs}" Spacing="8">
                            <TextBlock Classes="body actstatus"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding IgdbMatch.HasNote, FallbackValue=False}"
                                       Text="{Binding IgdbMatch.Note}"/>
                            <TextBlock Classes="body actstatus"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Amber}"
                                       IsVisible="{Binding IgdbMatch.HasProblem, FallbackValue=False}"
                                       Text="{Binding IgdbMatch.Problem}"/>
                            <TextBlock Classes="body actstatus"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding MetadataEditor.HasNote, FallbackValue=False}"
                                       Text="{Binding MetadataEditor.Note}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Panel>
        </Border>
    </Panel>
</UserControl>
