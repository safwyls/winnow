<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Winnow.App.ViewModels"
             x:Class="Winnow.App.Views.AppearanceView"
             x:DataType="vm:AppearanceViewModel">

    <!-- SETTINGS > APPEARANCE. Theme picker (1/8-scale miniatures of the
         window), layout picker, and transparency slider with backdrop/reach
         qualifiers. Nothing animates on this screen. -->

    <UserControl.Styles>

        <!-- ══ A theme card ═══════════════════════════════════════════════
             Button for keyboard access. Constant border thickness (§10.7). -->
        <Style Selector="Button.themecard">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.themecard /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style Selector="Button.themecard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="Button.themecard.picked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="Button.themecard:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>

        <!-- ══ A text-only choice ═════════════════════════════════════════
             Backdrop material and reach. Same Button grammar as theme cards.
             Recessed (Ground inside Surface) to read as part of the
             transparency setting, not as separate cards. -->
        <Style Selector="Button.optioncard">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="{StaticResource Ground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style Selector="Button.optioncard /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Ground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style Selector="Button.optioncard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Ground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="Button.optioncard.picked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Ground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="Button.optioncard:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>

        <!-- The miniature. Fixed geometry so four of them line up exactly:
             a 2:3 wall of capsules is the app's own atom (§4) and the mock
             reads wrong the moment the proportions drift. -->
        <Style Selector="Border.mini">
            <Setter Property="Height" Value="96"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <!-- ══ The transparency slider ════════════════════════════════════
             Same grammar as the density slider (neutral thumb, TextDim
             travelled side). Slightly larger since this is a sit-and-tune
             setting.
        -->
        <Style Selector="Slider.opacity">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="Slider.opacity /template/ Track#PART_Track RepeatButton#PART_DecreaseButton /template/ Border">
            <Setter Property="Background" Value="{StaticResource TextDim}"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <Style Selector="Slider.opacity /template/ Track#PART_Track RepeatButton#PART_IncreaseButton /template/ Border">
            <Setter Property="Background" Value="{StaticResource Line}"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <Style Selector="Slider.opacity /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource TextDim}"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
        <Style Selector="Slider.opacity:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource Text}"/>
        </Style>

        <!-- Focus ring on the slider frame via :focus-within (global
             FocusAdorner and Thumb's own template both fail here).
             Constant thickness, brush-only swap (§10.7). -->
        <Style Selector="Border.sliderframe">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="-8,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.sliderframe:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>

        <!-- Worst-case ratio under AA turns Amber (attention, not error). -->
        <Style Selector="TextBlock.ratio.under">
            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
        </Style>

        <!-- ══ One line of the themes folder's report ══════════════════════
             Failed files take Amber; warnings take ordinary ink. The two are
             told apart in words as well as by edge colour (§8). -->
        <Style Selector="Border.problem">
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>
        <Style Selector="Border.problem.failed">
            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
        </Style>
        <Style Selector="Border.problem TextBlock.verdict">
            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
        </Style>
        <Style Selector="Border.problem.failed TextBlock.verdict">
            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="{StaticResource PaneGround}">

        <!-- ══ Header ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Padding="24,20,24,18"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="7">
                <TextBlock Classes="display-l" Text="{Binding Title}"/>
                <TextBlock Classes="body"
                           MaxWidth="640"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           Foreground="{StaticResource TextDim}"
                           Text="{Binding IntroMessage}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Name="ScreenScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,28" MaxWidth="920"
                        HorizontalAlignment="Left" Spacing="14">

                <TextBlock Classes="label" FontSize="10" LetterSpacing="1.4" Text="THEME"/>

                <ItemsControl ItemsSource="{Binding Themes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ThemeChoiceViewModel">
                            <Button Classes="themecard"
                                    Classes.picked="{Binding IsSelected}"
                                    Margin="0,0,12,12"
                                    Command="{Binding $parent[ItemsControl].((vm:AppearanceViewModel)DataContext).SelectThemeCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Reason}">
                                <StackPanel Spacing="0">

                                    <!-- ══ The window, at 1/8 ══════════════
                                         Chrome bracket + wall in this theme's
                                         own brushes. -->
                                    <Border Classes="mini" CornerRadius="4,4,0,0"
                                            Background="{Binding Ground}">
                                        <Grid RowDefinitions="12,*">

                                            <!-- Caption in rail's colour. -->
                                            <Border Grid.Row="0" Background="{Binding Surface}"/>

                                            <Grid Grid.Row="1" ColumnDefinitions="46,*">

                                                <!-- Rail with one lit row and
                                                     chrome/art seam at theme's
                                                     Line. -->
                                                <Border Grid.Column="0" Background="{Binding Surface}"
                                                        BorderBrush="{Binding Line}"
                                                        BorderThickness="0,0,1,0">
                                                    <StackPanel Margin="0,6" Spacing="6">
                                                        <Border Background="{Binding SurfaceRaised}" Height="12">
                                                            <Grid ColumnDefinitions="2,5,*,6">
                                                                <Border Grid.Column="0" Background="{Binding Volt}"/>
                                                                <Border Grid.Column="2" Height="4" CornerRadius="2"
                                                                        Background="{Binding Text}"/>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Patched-since row with
                                                             Flare pip. -->
                                                        <Grid ColumnDefinitions="2,5,5,3,*,6" Height="8">
                                                            <Ellipse Grid.Column="2" Width="4" Height="4"
                                                                     Fill="{Binding Flare}"
                                                                     VerticalAlignment="Center"/>
                                                            <Border Grid.Column="4" Height="4" CornerRadius="2"
                                                                    Background="{Binding TextDim}" Opacity="0.7"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="2,5,*,6" Height="8">
                                                            <Border Grid.Column="2" Height="4" CornerRadius="2"
                                                                    Background="{Binding TextDim}" Opacity="0.5"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="2,5,*,6" Height="8">
                                                            <Border Grid.Column="2" Height="4" CornerRadius="2"
                                                                    Background="{Binding TextDim}" Opacity="0.3"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- The wall: same seven 2:3 capsules
                                                     on all four cards, two showing
                                                     dormancy floor. -->
                                                <Border Grid.Column="1" Background="{Binding Ground}"
                                                        Padding="8,9,0,0" ClipToBounds="True">
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Top">
                                                        <Panel Width="46" Height="69">
                                                            <Border CornerRadius="3"
                                                                    Background="{x:Static vm:ThemeChoiceViewModel.Art1}"/>
                                                            <!-- Flare dot in this theme's colour. -->
                                                            <Ellipse Width="6" Height="6"
                                                                     Fill="{Binding Flare}"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Top"
                                                                     Margin="0,3,3,0"/>
                                                        </Panel>
                                                        <Border Width="46" Height="69" CornerRadius="3"
                                                                Background="{x:Static vm:ThemeChoiceViewModel.Art2}"/>
                                                        <Border Width="46" Height="69" CornerRadius="3"
                                                                Background="{x:Static vm:ThemeChoiceViewModel.ArtDormant1}"/>
                                                        <Border Width="46" Height="69" CornerRadius="3"
                                                                Background="{x:Static vm:ThemeChoiceViewModel.Art3}"/>
                                                        <Border Width="46" Height="69" CornerRadius="3"
                                                                Background="{x:Static vm:ThemeChoiceViewModel.Art4}"/>
                                                        <Border Width="46" Height="69" CornerRadius="3"
                                                                Background="{x:Static vm:ThemeChoiceViewModel.ArtDormant2}"/>
                                                        <Border Width="46" Height="69" CornerRadius="3"
                                                                Background="{x:Static vm:ThemeChoiceViewModel.Art5}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="16,12,16,14" Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Classes="display-l" FontSize="17"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center"/>
                                            <!-- Selected state in word + edge (§8). -->
                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding IsSelected}"
                                                    Background="{StaticResource Volt}"
                                                    CornerRadius="9" Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="label" FontSize="9" LetterSpacing="1"
                                                           Foreground="{StaticResource VoltInk}"
                                                           Text="IN USE"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Classes="para"
                                                   Text="{Binding Reason}"/>

                                        <!-- A user theme shows its source file and
                                             contrast measurements. Built-ins omit
                                             this; the AA mark on the track covers
                                             it. -->
                                        <StackPanel IsVisible="{Binding IsUserTheme}"
                                                    Spacing="4" Margin="0,3,0,0">
                                            <TextBlock Classes="data-s"
                                                       Foreground="{StaticResource TextFaint}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding SourceFile}"/>
                                            <TextBlock Classes="para"
                                                       Foreground="{StaticResource TextDim}"
                                                       Text="{Binding ContrastHeadline}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- YOUR THEMES: folder path, contrast report, and file
                     problems. No colour picker; themes are JSON files. -->
                <TextBlock Classes="label" FontSize="10" LetterSpacing="1.4"
                           Margin="0,10,0,0" Text="YOUR THEMES"/>

                <Border Classes="card" MaxWidth="720" HorizontalAlignment="Left"
                        IsVisible="{Binding HasThemeFolder}">
                    <StackPanel Spacing="12">

                        <!-- The path, selectable and in Plex Mono. -->
                        <SelectableTextBlock Classes="data-s"
                                             TextWrapping="Wrap"
                                             Foreground="{StaticResource TextDim}"
                                             Text="{Binding ThemeFolder}"/>

                        <TextBlock Classes="para" Text="{Binding UserThemeSummary}"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- Exports the theme's seeds and proportions, not
                                 raw hex values. -->
                            <Button Classes="act primary"
                                    Command="{Binding ExportThemeCommand}"
                                    Content="Export this theme as a template"/>
                            <Button Classes="act quiet"
                                    Command="{Binding ReloadThemesCommand}"
                                    Content="Re-read the folder"/>
                        </StackPanel>

                        <TextBlock Classes="para"
                                   IsVisible="{Binding HasThemeActionStatus}"
                                   Foreground="{StaticResource Volt}"
                                   Text="{Binding ThemeActionStatus}"/>

                        <!-- ══ What this theme measures ═══════════════════
                             User themes only (built-ins show on the track). -->
                        <StackPanel Spacing="10" IsVisible="{Binding ShowThemeReport}">
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,2"/>

                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1.4"
                                       Text="WHAT THIS THEME MEASURES"/>

                            <Grid ColumnDefinitions="Auto,10,*">
                                <TextBlock Grid.Column="0" Classes="data"
                                           VerticalAlignment="Top"
                                           Text="{Binding ReportAaCeiling}"/>
                                <TextBlock Grid.Column="2" Classes="para"
                                           Text="{Binding ReportAaNote}"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,10,*">
                                <TextBlock Grid.Column="0" Classes="data"
                                           VerticalAlignment="Top"
                                           Text="{Binding ReportWallCeiling}"/>
                                <TextBlock Grid.Column="2" Classes="para"
                                           Text="{Binding ReportWallNote}"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,10,*">
                                <TextBlock Grid.Column="0" Classes="data"
                                           VerticalAlignment="Top"
                                           Text="{Binding ReportMetadata}"/>
                                <TextBlock Grid.Column="2" Classes="para"
                                           Text="{Binding ReportMetadataNote}"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,10,*">
                                <TextBlock Grid.Column="0" Classes="data"
                                           VerticalAlignment="Top"
                                           Text="{Binding ReportEdge}"/>
                                <TextBlock Grid.Column="2" Classes="para"
                                           Text="{Binding ReportEdgeNote}"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,10,*">
                                <TextBlock Grid.Column="0" Classes="data"
                                           VerticalAlignment="Top"
                                           Text="{Binding ReportField}"/>
                                <TextBlock Grid.Column="2" Classes="para"
                                           Text="{Binding ReportFieldNote}"/>
                            </Grid>
                        </StackPanel>

                        <!-- ══ What is wrong, and where ═══════════════════
                             Validation printed here (not logged) so authors can
                             see why a file was skipped. Errors first; verdict
                             stated in words as well as colour (§8). -->
                        <StackPanel Spacing="10" IsVisible="{Binding HasProblems}">
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,2"/>

                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1.4"
                                       Text="{Binding ProblemsHeading}"/>

                            <ItemsControl ItemsSource="{Binding Problems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThemeProblemViewModel">
                                        <Border Classes="problem"
                                                Classes.failed="{Binding IsError}"
                                                Background="{StaticResource Ground}"
                                                CornerRadius="{StaticResource RadiusControl}"
                                                Padding="14,11" Margin="0,0,0,8">
                                            <StackPanel Spacing="5">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Classes="data-s"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Where}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Classes="label verdict" FontSize="9" LetterSpacing="1"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Verdict}"/>
                                                </Grid>
                                                <TextBlock Classes="para" Text="{Binding Message}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══ LAYOUT (§15) ═══════════════════════════════════════
                     Sits between THEME and TRANSPARENCY because it is a peer of
                     THEME (applies at every slider position), not a transparency
                     qualifier. Two cards with 1/8-scale miniatures. -->
                <TextBlock Classes="label" FontSize="10" LetterSpacing="1.4"
                           Margin="0,10,0,0" Text="LAYOUT"/>

                <ItemsControl ItemsSource="{Binding Layouts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:LayoutChoiceViewModel">
                            <Button Classes="themecard"
                                    Classes.picked="{Binding IsSelected}"
                                    Margin="0,0,12,12"
                                    Command="{Binding $parent[ItemsControl].((vm:AppearanceViewModel)DataContext).SelectLayoutCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Reason}">
                                <StackPanel Spacing="0">

                                    <!-- ══ The window, at 1/8 ══════════════
                                         Same template on both cards, differing
                                         only in the layout values (margins,
                                         radius, Line position). Uses the
                                         current theme's palette. -->
                                    <Border Classes="mini" CornerRadius="4,4,0,0"
                                            Background="{Binding GroundFill}">
                                        <Grid RowDefinitions="12,*">

                                            <!-- Caption: fill changes between
                                                 layouts. -->
                                            <Border Grid.Row="0" Background="{Binding CaptionFill}"/>

                                            <Grid Grid.Row="1" ColumnDefinitions="46,*">

                                                <!-- Rail (same fill in both). -->
                                                <Border Grid.Column="0"
                                                        Background="{Binding RailFill}"
                                                        Margin="{Binding RailMargin}"
                                                        CornerRadius="{Binding PaneRadius}"
                                                        BorderBrush="{Binding LineFill}"
                                                        BorderThickness="{Binding RailEdge}"
                                                        ClipToBounds="True">
                                                    <StackPanel Margin="0,6" Spacing="6">
                                                        <Grid ColumnDefinitions="2,5,5,3,*,6" Height="8">
                                                            <Ellipse Grid.Column="2" Width="4" Height="4"
                                                                     Fill="{Binding FlareFill}"
                                                                     VerticalAlignment="Center"/>
                                                            <Border Grid.Column="4" Height="4" CornerRadius="2"
                                                                    Background="{StaticResource TextDim}" Opacity="0.7"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="2,5,*,6" Height="8">
                                                            <Border Grid.Column="2" Height="4" CornerRadius="2"
                                                                    Background="{StaticResource TextDim}" Opacity="0.5"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="2,5,*,6" Height="8">
                                                            <Border Grid.Column="2" Height="4" CornerRadius="2"
                                                                    Background="{StaticResource TextDim}" Opacity="0.3"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Library island with command bar
                                                     inside. Fill is identical in
                                                     both layouts (§5.1 polarity
                                                     depends on it). -->
                                                <Border Grid.Column="1"
                                                        Background="{Binding WallFill}"
                                                        Margin="{Binding WallMargin}"
                                                        CornerRadius="{Binding PaneRadius}"
                                                        BorderBrush="{Binding LineFill}"
                                                        BorderThickness="{Binding WallEdge}"
                                                        ClipToBounds="True">
                                                    <Grid RowDefinitions="10,*">

                                                        <!-- Command bar, found by
                                                             its bottom rule. -->
                                                        <Border Grid.Row="0"
                                                                BorderBrush="{Binding LineFill}"
                                                                BorderThickness="0,0,0,1"/>

                                                    <Border Grid.Row="1"
                                                            Padding="7,7,0,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="5"
                                                                    VerticalAlignment="Top">
                                                            <Panel Width="38" Height="57">
                                                                <Border CornerRadius="2"
                                                                        Background="{x:Static vm:ThemeChoiceViewModel.Art1}"/>
                                                                <!-- The one Flare in the
                                                                     picture, in the corner a
                                                                     real tile carries it. -->
                                                                <Ellipse Width="5" Height="5"
                                                                         Fill="{Binding FlareFill}"
                                                                         HorizontalAlignment="Right"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,3,3,0"/>
                                                            </Panel>
                                                            <Border Width="38" Height="57" CornerRadius="2"
                                                                    Background="{x:Static vm:ThemeChoiceViewModel.Art2}"/>
                                                            <Border Width="38" Height="57" CornerRadius="2"
                                                                    Background="{x:Static vm:ThemeChoiceViewModel.ArtDormant1}"/>
                                                            <Border Width="38" Height="57" CornerRadius="2"
                                                                    Background="{x:Static vm:ThemeChoiceViewModel.Art3}"/>
                                                            <Border Width="38" Height="57" CornerRadius="2"
                                                                    Background="{x:Static vm:ThemeChoiceViewModel.Art4}"/>
                                                            <Border Width="38" Height="57" CornerRadius="2"
                                                                    Background="{x:Static vm:ThemeChoiceViewModel.ArtDormant2}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="16,12,16,14" Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Classes="display-l" FontSize="17"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding IsSelected}"
                                                    Background="{StaticResource Volt}"
                                                    CornerRadius="9" Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="label" FontSize="9" LetterSpacing="1"
                                                           Foreground="{StaticResource VoltInk}"
                                                           Text="IN USE"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Classes="para"
                                                   Text="{Binding Reason}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="label" FontSize="10" LetterSpacing="1.4"
                           Margin="0,10,0,0" Text="TRANSPARENCY"/>

                <Border Classes="card" MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="body-l"
                                       Text="Let the desktop through"
                                       VerticalAlignment="Center"/>
                            <!-- Every number in Plex Mono, tabular (§3), so the
                                 reading does not jitter sideways as it is
                                 dragged past 9 → 10 → 100. -->
                            <TextBlock Grid.Column="1" Classes="data"
                                       Text="{Binding TransparencyReading}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Classes="sliderframe">
                            <StackPanel Width="{Binding SliderWidth}" Spacing="0">

                                <!-- ══ The AA mark ═══════════════════════════
                                     Tick where worst-case contrast drops under
                                     4.5:1. Position is per-theme, computed from
                                     track geometry in the view model. -->
                                <Panel Height="14" HorizontalAlignment="Stretch">
                                    <TextBlock Classes="data-s"
                                               Text="AA"
                                               Padding="4,0,0,0"
                                               Foreground="{StaticResource TextFaint}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Margin="{Binding AaMarkMargin}"/>
                                </Panel>
                                <Panel Height="6" HorizontalAlignment="Stretch">
                                    <Border Width="1" Height="6"
                                            Background="{StaticResource TextFaint}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Margin="{Binding AaMarkMargin}"/>
                                </Panel>

                                <Slider Name="TransparencySlider"
                                        Classes="opacity"
                                        Minimum="0" Maximum="100"
                                        SmallChange="1" LargeChange="10"
                                        Value="{Binding Transparency, Mode=TwoWay}"
                                        ToolTip.Tip="How much of the desktop the rail, title bar, filter panel and command bar let through"/>

                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                                    <!-- Zero is a position, so it is named. -->
                                    <TextBlock Grid.Column="0" Classes="label" FontSize="9"
                                               Foreground="{StaticResource TextFaint}"
                                               Text="SOLID"/>
                                    <TextBlock Grid.Column="2" Classes="label" FontSize="9"
                                               Foreground="{StaticResource TextFaint}"
                                               Text="MOST DESKTOP"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══ Backdrop and reach qualifiers ═════════════════
                             Hidden while slider is at SOLID (neither does
                             anything at zero). Recessed wells, not raised
                             cards. -->
                        <StackPanel IsVisible="{Binding ShowComposition}" Spacing="12">

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,2"/>

                            <TextBlock Classes="label" FontSize="9" LetterSpacing="1.2"
                                       Text="WHAT WINDOWS PUTS BEHIND THE WINDOW"/>

                            <ItemsControl ItemsSource="{Binding Backdrops}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:AppearanceOptionViewModel">
                                        <Button Classes="optioncard"
                                                Classes.picked="{Binding IsSelected}"
                                                Margin="0,0,10,0"
                                                Command="{Binding $parent[ItemsControl].((vm:AppearanceViewModel)DataContext).SelectBackdropCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Reason}">
                                            <StackPanel Spacing="5">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Classes="body-l"
                                                               Text="{Binding Name}"
                                                               VerticalAlignment="Center"/>
                                                    <!-- Says which one is on in a
                                                         word as well as in an edge
                                                         (§8). -->
                                                    <Border Grid.Column="1"
                                                            IsVisible="{Binding IsSelected}"
                                                            Background="{StaticResource Volt}"
                                                            CornerRadius="9" Padding="8,2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Classes="label" FontSize="9"
                                                                   LetterSpacing="1"
                                                                   Foreground="{StaticResource VoltInk}"
                                                                   Text="IN USE"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Classes="para" Text="{Binding Reason}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The measurement, stated where the choice is made
                                 rather than left for someone to discover. Plex
                                 Mono because it is a number (§3). -->
                            <Grid ColumnDefinitions="Auto,10,*" IsVisible="{Binding MicaPicked}">
                                <TextBlock Grid.Column="0" Classes="data"
                                           VerticalAlignment="Top"
                                           Text="{Binding MicaComposite}"/>
                                <TextBlock Grid.Column="2" Classes="para"
                                           Text="{Binding MicaCompositeNote}"/>
                            </Grid>

                            <!-- Backdrop substitution notice. Amber for
                                 attention (not an error). -->
                            <Border IsVisible="{Binding BackdropSubstituted}"
                                    Background="{StaticResource Ground}"
                                    BorderBrush="{StaticResource Amber}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}"
                                    Padding="14,12">
                                <TextBlock Classes="body" FontSize="12" LineHeight="18"
                                           TextWrapping="Wrap"
                                           Text="{Binding BackdropSubstitutedNote}"/>
                            </Border>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,2"/>

                            <TextBlock Classes="label" FontSize="9" LetterSpacing="1.2"
                                       Text="HOW FAR IT REACHES"/>

                            <ItemsControl ItemsSource="{Binding Reach}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:AppearanceOptionViewModel">
                                        <Button Classes="optioncard"
                                                Classes.picked="{Binding IsSelected}"
                                                Margin="0,0,10,0"
                                                Command="{Binding $parent[ItemsControl].((vm:AppearanceViewModel)DataContext).SelectReachCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Reason}">
                                            <StackPanel Spacing="5">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Classes="body-l"
                                                               Text="{Binding Name}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1"
                                                            IsVisible="{Binding IsSelected}"
                                                            Background="{StaticResource Volt}"
                                                            CornerRadius="9" Padding="8,2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Classes="label" FontSize="9"
                                                                   LetterSpacing="1"
                                                                   Foreground="{StaticResource VoltInk}"
                                                                   Text="IN USE"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Classes="para" Text="{Binding Reason}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The two transparency tiers (ground and pane).
                                 Only drawn when the wall is translucent. -->
                            <StackPanel Spacing="6" IsVisible="{Binding WallTranslucent}">
                                <Grid ColumnDefinitions="Auto,10,*">
                                    <TextBlock Grid.Column="0" Classes="data"
                                               Text="{Binding GroundAdmits}"/>
                                    <TextBlock Grid.Column="2" Classes="body" FontSize="12"
                                               Foreground="{StaticResource TextDim}"
                                               VerticalAlignment="Center"
                                               Text="of the window's ground is desktop"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,10,*">
                                    <TextBlock Grid.Column="0" Classes="data"
                                               VerticalAlignment="Top"
                                               Text="{Binding PaneAdmits}"/>
                                    <TextBlock Grid.Column="2" Classes="para"
                                               Text="{Binding PaneAdmitsNote}"/>
                                </Grid>
                                <!-- These panes now match the library pane's
                                     transparency. -->
                                <TextBlock Classes="para"
                                           Text="Settings, the review queue and the list view open up with the wall — the same amount, the same setting. So does every input field, and it gets there by painting nothing at all: a field is a step cut into a pane that is already at this share, so there is nothing left for a fill of its own to spend. It is found by its border and lit by its ring."/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,2"/>

                        <!-- ══ Live contrast measurements ═══════════════════
                             Two backdrops measured: Mica composite and white
                             (worst case). Under-AA number turns Amber. -->
                        <!-- Gaps and title bar share the ground's transparency
                             figure. Only drawn when translucent. -->
                        <StackPanel Spacing="6" IsVisible="{Binding ShowGapNote}">
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,2"/>
                            <TextBlock Classes="label" FontSize="9" LetterSpacing="1.2"
                                       Text="THE GAPS, AND THE TITLE BAR"/>
                            <Grid ColumnDefinitions="Auto,10,*">
                                <TextBlock Grid.Column="0" Classes="data"
                                           VerticalAlignment="Top"
                                           Text="{Binding GroundAdmits}"/>
                                <TextBlock Grid.Column="2" Classes="para"
                                           Text="{Binding GapNote}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6" Margin="0,4,0,0">
                            <TextBlock Classes="label" FontSize="9" LetterSpacing="1.2"
                                       Text="LABELS ON THE TITLE BAR"/>

                            <Grid ColumnDefinitions="Auto,10,*" IsVisible="{Binding !IsSolid}">
                                <TextBlock Grid.Column="0" Classes="data"
                                           Text="{Binding ContrastOnDarkWallpaper}"/>
                                <TextBlock Grid.Column="2" Classes="body" FontSize="12"
                                           Foreground="{StaticResource TextDim}"
                                           VerticalAlignment="Center"
                                           Text="{Binding DarkWallpaperNote}"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,10,*" IsVisible="{Binding !IsSolid}">
                                <TextBlock Grid.Column="0" Classes="data ratio"
                                           Classes.under="{Binding UnderAa}"
                                           Text="{Binding ContrastOnWhiteWallpaper}"/>
                                <TextBlock Grid.Column="2" Classes="body" FontSize="12"
                                           Foreground="{StaticResource TextDim}"
                                           VerticalAlignment="Center"
                                           Text="{Binding WhiteWallpaperNote}"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,10,*" IsVisible="{Binding IsSolid}">
                                <TextBlock Grid.Column="0" Classes="data"
                                           Text="{Binding ContrastOnWhiteWallpaper}"/>
                                <TextBlock Grid.Column="2" Classes="body" FontSize="12"
                                           Foreground="{StaticResource TextDim}"
                                           VerticalAlignment="Center"
                                           Text="on the chrome, solid"/>
                            </Grid>

                            <TextBlock Classes="para" Text="{Binding ContrastNote}"/>
                        </StackPanel>

                        <!-- Transparency unavailable on this machine.
                             Amber for attention (not an error). -->
                        <Border IsVisible="{Binding TransparencyUnavailable}"
                                Background="{StaticResource Ground}"
                                BorderBrush="{StaticResource Amber}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusControl}"
                                Padding="14,12">
                            <TextBlock Classes="body" FontSize="12" LineHeight="18"
                                       TextWrapping="Wrap"
                                       Text="Not available here. Windows 10, a remote session and some virtual display drivers all refuse the backdrop."/>
                        </Border>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,2"/>

                        <TextBlock Classes="para"
                                   Text="{Binding TransparencyStatus}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
