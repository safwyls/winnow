<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Winnow.App.ViewModels"
             x:Class="Winnow.App.Views.StoresView"
             x:DataType="vm:StoresViewModel">

    <!-- Stores panel. One card per source (Steam, Epic, GOG), each stating
         what it can and cannot know. No Flare anywhere on this screen.
         Volt = complete, Amber = broken session, TextDim = not connected. -->

    <UserControl.Styles>

        <!-- ══ Source card ══════════════════════════════════════════════════
             Constant border thickness so status changes do not reflow. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- ══ Status pill ══════════════════════════════════════════════════
             A word, not a dot. State carried by label; colour reinforces (§8).
        -->
        <Style Selector="Border.pill">
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style Selector="Border.pill.live">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="Border.pill.live TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="Border.pill.attention">
            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
        </Style>
        <Style Selector="Border.pill.attention TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
        </Style>

        <!-- ══ Prose and actions live in Themes/controls.axaml now ═════════
             Moved there when the Epic consent window needed the same styles.
             Uses DynamicResource for Application.Styles load ordering. -->

        <!-- ══ Inset fields ═════════════════════════════════════════════════
             A note the card is making about itself: an unfilled state, a
             warning, a command to run. Well is the app's inset tone (§9). -->
        <Style Selector="Border.note">
            <Setter Property="Background" Value="{StaticResource Well}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <!-- A failed attempt, and a lapsed session. Amber on the edge only —
             the text stays legible ink rather than becoming a coloured
             paragraph. -->
        <Style Selector="Border.note.attention">
            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
        </Style>
        <!-- A flow the user is in the middle of. -->
        <Style Selector="Border.note.working">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>

        <!-- The console command. Selectable (copy is the point) and a Tab
             stop. Focused text gets a raised field, not a ring. -->
        <Style Selector="SelectableTextBlock.cmd">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="{StaticResource DataSize}"/>
            <Setter Property="FontFeatures" Value="tnum"/>
            <Setter Property="Foreground" Value="{StaticResource Azure}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="SelectableTextBlock.cmd:focus">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="{StaticResource PaneGround}">

        <!-- ══ Header ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Padding="24,20,24,18"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="7">
                <TextBlock Classes="display-l" Text="{Binding Title}"/>
                <TextBlock Classes="body"
                           MaxWidth="640"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           Foreground="{StaticResource TextDim}"
                           Text="{Binding IntroMessage}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <!-- 720px max width for readable paragraph measure. -->
            <StackPanel Margin="24,20,24,28"
                        MaxWidth="720"
                        HorizontalAlignment="Left"
                        Spacing="16">

                <!-- ══ STEAM ════════════════════════════════════════════════
                     Local files always; Web API key adds owned-but-never-
                     installed titles. -->
                <Border Classes="card">
                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        Spacing="10" VerticalAlignment="Center">
                                <TextBlock Classes="display-l" FontSize="18" Text="Steam"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="data" FontSize="12"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding SteamCountText}"
                                           IsVisible="{Binding ShowSteamCount}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="TITLES"
                                           IsVisible="{Binding ShowSteamCount}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" Classes="pill"
                                    Classes.live="{Binding SteamStatusIsLive}">
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="{Binding SteamStatusLabel}"/>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="LOCAL FILES"/>
                            <TextBlock Classes="para" Text="{Binding SteamLocalMessage}"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="STEAM WEB API"/>
                            <TextBlock Classes="para lead" Text="{Binding SteamAddsMessage}"/>
                        </StackPanel>

                        <Border Classes="note" IsVisible="{Binding ShowSteamKeyHint}">
                            <TextBlock Classes="para" Text="{Binding SteamKeyHintMessage}"/>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ══ EPIC ═════════════════════════════════════════════════
                     What Winnow has, then the gap, then the sign-in button. -->
                <Border Classes="card">
                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        Spacing="10" VerticalAlignment="Center">
                                <TextBlock Classes="display-l" FontSize="18" Text="Epic"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="data" FontSize="12"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding EpicCountText}"
                                           IsVisible="{Binding ShowEpicCount}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="TITLES"
                                           IsVisible="{Binding ShowEpicCount}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" Classes="pill"
                                    Classes.live="{Binding EpicStatusIsLive}"
                                    Classes.attention="{Binding EpicStatusNeedsAttention}">
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="{Binding EpicStatusLabel}"/>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="LOCAL FILES"/>
                            <TextBlock Classes="para" Text="{Binding EpicLocalMessage}"/>
                        </StackPanel>

                        <!-- What Epic local files cannot tell you. -->
                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="WHAT'S MISSING"/>
                            <TextBlock Classes="para lead" Text="{Binding EpicGapMessage}"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Line}"/>

                        <!-- ── Signed in ──────────────────────────────────── -->
                        <StackPanel Spacing="10" IsVisible="{Binding EpicIsSignedIn}">
                            <StackPanel Spacing="5">
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="CONNECTED AS"
                                           IsVisible="{Binding ShowEpicAccountLine}"/>
                                <!-- The display name, and nothing else about the
                                     account. Never the account id, never
                                     anything out of the token. -->
                                <TextBlock Classes="body-l"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding EpicAccountLine}"
                                           IsVisible="{Binding ShowEpicAccountLine}"/>
                                <TextBlock Classes="para lead"
                                           Text="{Binding EpicAnonymousMessage}"
                                           IsVisible="{Binding ShowEpicAnonymousLine}"/>
                            </StackPanel>

                            <Border Classes="note attention"
                                    IsVisible="{Binding EpicSessionNotPersisted}">
                                <TextBlock Classes="para"
                                           Text="{Binding EpicSessionNotPersistedMessage}"/>
                            </Border>

                            <TextBlock Classes="para" Text="{Binding EpicSignOutMessage}"/>

                            <Button Classes="act quiet"
                                    Content="Sign out"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SignOutOfEpicCommand}"/>
                        </StackPanel>

                        <!-- ── Signing in ─────────────────────────────────────
                             Text progress (no animated bar). -->
                        <StackPanel Spacing="10" IsVisible="{Binding EpicIsSigningIn}">
                            <Border Classes="note working">
                                <TextBlock Classes="para lead" Text="{Binding EpicSigningInMessage}"/>
                            </Border>
                            <Button Classes="act quiet"
                                    Content="Cancel"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SignInToEpicCancelCommand}"/>
                        </StackPanel>

                        <!-- ── Signed out, or a session that lapsed ────────── -->
                        <StackPanel Spacing="10" IsVisible="{Binding EpicCanSignIn}">

                            <!-- A session that expired while the app was closed. -->
                            <Border Classes="note attention" IsVisible="{Binding EpicIsLapsed}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                               Foreground="{StaticResource Amber}"
                                               Text="{Binding EpicAccountLine}"
                                               IsVisible="{Binding ShowEpicAccountLine}"/>
                                    <TextBlock Classes="para lead" Text="{Binding EpicLapsedMessage}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="5">
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="WHAT SIGNING IN ADDS"/>
                                <TextBlock Classes="para" Text="{Binding EpicSignInAddsMessage}"/>
                            </StackPanel>

                            <Button Classes="act primary"
                                    HorizontalAlignment="Left"
                                    Content="{Binding EpicSignInButtonText}"
                                    Command="{Binding SignInToEpicCommand}"/>

                            <!-- Preview of the consent step (not a second gate;
                                 the real consent is the pre-navigation prompt). -->
                            <TextBlock Classes="para" Text="{Binding EpicConsentPromiseMessage}"/>

                            <!-- Console sign-in alternative, always offered
                                 (not just after failure). -->
                            <StackPanel Spacing="6">
                                <TextBlock Classes="para" Text="{Binding EpicConsoleAlternativeMessage}"/>
                                <Border Classes="note">
                                    <SelectableTextBlock Classes="cmd"
                                                         Text="{Binding ConsoleSignInCommandText}"/>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                        <!-- ── A failed attempt ──────────────────────────────
                             Outside the three state panels so failures are
                             visible in every state, not just signed-out. -->
                        <Border Classes="note attention" IsVisible="{Binding ShowEpicProblem}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Foreground="{StaticResource Amber}"
                                           Text="LAST ATTEMPT"/>
                                <TextBlock Classes="para lead" Text="{Binding EpicProblemMessage}"/>

                                <!-- Console route shown only for failures it
                                     can actually solve. -->
                                <SelectableTextBlock Classes="cmd"
                                                     IsVisible="{Binding ShowConsoleRoute}"
                                                     Text="{Binding ConsoleSignInCommandText}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ══ GOG ══════════════════════════════════════════════════
                     No sign-in button: the authenticated endpoint carries
                     nothing the local DB does not already have. -->
                <Border Classes="card">
                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        Spacing="10" VerticalAlignment="Center">
                                <TextBlock Classes="display-l" FontSize="18" Text="GOG"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="data" FontSize="12"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding GogCountText}"
                                           IsVisible="{Binding ShowGogCount}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="TITLES"
                                           IsVisible="{Binding ShowGogCount}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Volt: this source is complete. -->
                            <Border Grid.Column="1" Classes="pill live">
                                <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                           Text="{Binding GogStatusLabel}"/>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="GALAXY'S DATABASE"/>
                            <TextBlock Classes="para" Text="{Binding GogLocalMessage}"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Text="NOTHING TO SIGN INTO"/>
                            <TextBlock Classes="para lead" Text="{Binding GogNoSignInMessage}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
