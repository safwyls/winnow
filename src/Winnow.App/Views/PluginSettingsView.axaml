<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Winnow.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Winnow.App.Views.PluginSettingsView"
             x:DataType="vm:PluginSettingsViewModel"
             AutomationProperties.Name="Plugin settings">
    <UserControl.Resources>
        <DataTemplate x:Key="PluginSettingEditor" DataType="vm:PluginSettingFieldViewModel">
            <StackPanel Spacing="8" Margin="0,0,0,12">
                <TextBlock Classes="body" Text="{Binding Label}"/>
                <TextBlock Classes="body prose" Text="{Binding Description}" IsVisible="{Binding HasDescription}"/>
                <TextBox Text="{Binding Value, Mode=TwoWay}" PasswordChar="{Binding PasswordChar}"
                         IsVisible="{Binding IsText}" IsEnabled="{Binding IsEnabled}" Watermark="{Binding Watermark}"
                         AutomationProperties.Name="{Binding AccessibleName}"/>
                <ToggleSwitch IsChecked="{Binding BooleanValue, Mode=TwoWay}" IsVisible="{Binding IsBoolean}"
                              IsEnabled="{Binding IsEnabled}" OnContent="On" OffContent="Off"
                              AutomationProperties.Name="{Binding AccessibleName}"/>
                <WrapPanel>
                    <Button Classes="act" Margin="0,0,8,0" Content="{Binding SetupLabel}" IsVisible="{Binding HasSetup}"
                            Command="{Binding OpenSetupCommand}" AutomationProperties.Name="{Binding SetupAccessibleName}"/>
                    <Button Classes="act" Content="Remove saved secret" IsVisible="{Binding IsSecret}"
                            Command="{Binding RemoveSecretCommand}" AutomationProperties.Name="{Binding RemoveAccessibleName}"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*" Background="{StaticResource PaneGround}">
        <Border Padding="24,20,24,18" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="7">
                <TextBlock Classes="display-l" Text="{Binding Title}" AutomationProperties.HeadingLevel="1"/>
                <TextBlock Classes="body" MaxWidth="640" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}" Text="{Binding IntroMessage}"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,16,24,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1100"/>
                </Grid.ColumnDefinitions>
                <StackPanel HorizontalAlignment="Stretch" Spacing="14">
                    <Border Classes="card" IsVisible="{Binding Installation.HasRequest}">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="label section" Text="PLUGIN INSTALLATION"/>
                            <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding Installation.Status}"
                                       AutomationProperties.AutomationId="PluginInstallStatus" AutomationProperties.LiveSetting="Polite"/>
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding Installation.IsBusy}" Height="3"
                                         Foreground="{StaticResource Volt}" AutomationProperties.Name="Installing plugin"/>
                            <Button Classes="act" Content="Retry installation" HorizontalAlignment="Left"
                                    IsVisible="{Binding Installation.CanRetry}" Command="{Binding Installation.RetryCommand}"
                                    AutomationProperties.Name="Retry plugin installation"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="label section" AutomationProperties.HeadingLevel="2" Text="LOADED PLUGINS"/>
                    <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding LoadedPluginSummary}"
                               AutomationProperties.AutomationId="LoadedPluginsSummary" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Classes="label section" AutomationProperties.HeadingLevel="2" Text="INSTALL AND CONFIGURE"/>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="body" TextWrapping="Wrap" Text="{x:Static vm:PluginSettingsViewModel.InstallationNote}"/>
                            <Button Classes="act" HorizontalAlignment="Left" Content="Open plugins folder" Click="OnOpenPluginsFolder"/>
                            <SelectableTextBlock Classes="data-s" Text="{Binding UserPluginDirectory}" TextWrapping="Wrap" Focusable="False"/>
                            <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding Status}"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Plugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PluginCardViewModel">
                                <Border Classes="card" Margin="0,0,0,16" AutomationProperties.Name="{Binding Name}"
                                        AutomationProperties.AccessibilityView="Control">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="display-l" Text="{Binding Name}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="2"/>
                                                <TextBlock Classes="data" Text="{Binding Version}" Foreground="{StaticResource TextDim}"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding ActivationSelected, Mode=TwoWay}"
                                                          OnContent="Enabled" OffContent="Disabled" IsVisible="{Binding CanConfigure}"
                                                          Command="{Binding ToggleEnabledCommand}" AutomationProperties.Name="{Binding ToggleAccessibleName}"
                                                          AutomationProperties.ItemStatus="{Binding EnabledStatus}"/>
                                        </Grid>
                                        <TextBlock Classes="body prose" Text="{Binding Description}"/>
                                        <TextBlock Classes="body" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Text="{Binding Capabilities}"/>
                                        <WrapPanel>
                                            <Button Classes="act" Content="Provider website" IsVisible="{Binding HasWebsite}"
                                                    Command="{Binding OpenWebsiteCommand}" AutomationProperties.Name="{Binding WebsiteAccessibleName}"/>
                                        </WrapPanel>
                                        <TextBlock Classes="body" Foreground="{StaticResource AmberForeground}" IsVisible="{Binding RestartRequired}"
                                                   Text="Restart Winnow to apply the enable or disable change."/>
                                        <StackPanel Spacing="8" IsVisible="{Binding HasAccount}">
                                            <TextBlock Classes="label section" Text="ACCOUNT" AutomationProperties.HeadingLevel="3"/>
                                            <TextBlock Classes="body prose" Text="{Binding AccountStatus}" AutomationProperties.LiveSetting="Polite"/>
                                            <StackPanel Spacing="8" IsVisible="{Binding HasSignInChallenge}">
                                                <TextBlock Classes="body" Text="Sign-in code"/>
                                                <SelectableTextBlock Classes="data" Text="{Binding UserCode}" TextWrapping="Wrap"
                                                                     AutomationProperties.AutomationId="PluginSignInCode"/>
                                                <SelectableTextBlock Classes="body" Text="{Binding VerificationUrl}" TextWrapping="Wrap"
                                                                     AutomationProperties.AutomationId="PluginSignInAddress"/>
                                                <Button Classes="act" Content="Open sign-in page" HorizontalAlignment="Left"
                                                        Command="{Binding OpenSignInPageCommand}" AutomationProperties.Name="{Binding SignInPageAccessibleName}"/>
                                            </StackPanel>
                                            <WrapPanel>
                                                <Button Classes="act" Margin="0,0,8,0" Content="Sign in" Command="{Binding ConnectCommand}"
                                                        IsVisible="{Binding !AccountConnected}" AutomationProperties.Name="{Binding ConnectAccessibleName}"/>
                                                <Button Classes="act" Content="Sign out" Command="{Binding DisconnectCommand}"
                                                        IsVisible="{Binding AccountConnected}" AutomationProperties.Name="{Binding DisconnectAccessibleName}"/>
                                                <Button Classes="act" Content="Cancel sign-in" Command="{Binding CancelSignInCommand}"
                                                        IsVisible="{Binding IsConnecting}" AutomationProperties.Name="{Binding CancelSignInAccessibleName}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding StandardFields}" ItemTemplate="{StaticResource PluginSettingEditor}"/>
                                        <StackPanel Spacing="12" IsVisible="{Binding HasAdvancedSettings}">
                                            <Button Classes="act" Content="{Binding AdvancedSettingsLabel}" HorizontalAlignment="Left"
                                                    Command="{Binding ToggleAdvancedSettingsCommand}"
                                                    AutomationProperties.Name="{Binding AdvancedSettingsAccessibleName}"
                                                    AutomationProperties.ItemStatus="{Binding AdvancedSettingsStatus}"/>
                                            <ItemsControl ItemsSource="{Binding AdvancedFields}" IsVisible="{Binding AdvancedSettingsExpanded}"
                                                          ItemTemplate="{StaticResource PluginSettingEditor}"/>
                                        </StackPanel>
                                        <TextBlock Classes="body prose" IsVisible="{Binding HasVisibleSecrets}" Text="{x:Static vm:PluginSettingsViewModel.SecretNote}"/>
                                        <WrapPanel>
                                            <Button Classes="act" Margin="0,0,8,0" Content="Save settings" IsVisible="{Binding HasSettings}"
                                                    Command="{Binding SaveCommand}" AutomationProperties.Name="{Binding SaveAccessibleName}"/>
                                            <Button Classes="act" Content="Refresh now" Command="{Binding RefreshCommand}" IsVisible="{Binding CanConfigure}"
                                                    AutomationProperties.Name="{Binding RefreshAccessibleName}"/>
                                        </WrapPanel>
                                        <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite"
                                                   IsVisible="{Binding Status, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
