<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Winnow.App.ViewModels"
             x:Class="Winnow.App.Views.GameTileView"
             x:DataType="vm:GameTileViewModel"
             Name="Root"
             ClipToBounds="False">

    <!--
        The cover tile. Art is the two-layer dormancy cross-fade settled in
        docs/spikes/avalonia-dormancy-rendering.md: the floor variant sits
        under the vivid layer, whose Opacity = (S − 0.22) / 0.78 rises to 1.0
        under the pointer over 140ms. M0 layers are procedural gradient
        Borders (title baked into each layer so it fades with its art); when
        real covers land each layer becomes an Image over a decoded bitmap
        and the fade logic is untouched.
    -->

    <UserControl.Styles>
        <Style Selector="Border#Lift">
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- Hover lift + the one permitted drop shadow (§4). -->
        <Style Selector="Border#Lift:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #8C000000"/>
        </Style>
        <!-- Resting scrim opacity has to come from a style, not a local value:
             a local value outranks a style setter in Avalonia's precedence, so
             Opacity="0" on the element would pin the overlay shut forever. -->
        <Style Selector="Border#Scrim">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border#Lift:pointerover Border#Scrim">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- M0 only: the placeholder title is painted into each art layer so it
             fades with its art. The scrim carries the real §5.3 title, so the
             baked one steps aside on hover instead of ghosting through. When
             real covers land the art layers carry no text and this is inert. -->
        <Style Selector="TextBlock.art-title">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#Lift:pointerover TextBlock.art-title">
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <!-- The resting store mark steps aside for the hover overlay, which
             carries the same fact in words. Same 140ms as the baked title,
             and taken away entirely under reduced motion below. -->
        <Style Selector="ItemsControl#RestingChips">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#Lift:pointerover ItemsControl#RestingChips">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border#Lift.snap ItemsControl#RestingChips">
            <Setter Property="Transitions">
                <Transitions/>
            </Setter>
        </Style>

        <!-- The dormancy cross-fade's 140ms restore (§5.1). It lives in a style
             rather than on the elements because §8's reduced-motion setting has
             to be able to take it away, and a local Transitions value would
             outrank any selector trying to. -->
        <Style Selector="Border#Lift Border#VividArt, Border#Lift Image#VividArtwork">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- Reduced motion: the state snaps instead of fading (§8). An empty
             transition set, not a zero duration — there is then no animation to
             schedule at all. This is independent of the dimming preference and
             cannot fight it: with dimming off the resting and hovered alphas are
             both 1.0, so there is nothing for either setting to animate. -->
        <Style Selector="Border#Lift.snap Border#VividArt, Border#Lift.snap Image#VividArtwork">
            <Setter Property="Transitions">
                <Transitions/>
            </Setter>
        </Style>

        <!-- Card flip (§5.3). 160ms turn: front squashes in 80ms, back opens
             in 80ms. Transition-based so it reverses automatically. Resting
             values are style setters (not local) so reduced-motion and flipped
             selectors can override them. -->

        <Style Selector="Border#Face">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="scaleX(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08" Easing="CubicEaseIn"/>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.08" Easing="CubicEaseIn"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#Lift.flipped Border#Face">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scaleX(0)"/>
            <!-- A zero-opacity control is still a hit target in Avalonia. The
                 back is declared after the front and so wins on z-order anyway,
                 but relying on that would leave a face-down cover quietly
                 answering presses. -->
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style Selector="Border#Back">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scaleX(0)"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08"
                                      Delay="0:0:0.08" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.08"
                                                   Delay="0:0:0.08" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#Lift.flipped Border#Back">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="scaleX(1)"/>
            <!-- Face-up, the back is not merely invisible: it must not eat a
                 press meant for the cover under it. -->
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <!-- The badge belongs to the front and leaves with it. Opacity only:
             it is a 10px dot, and squashing a dot reads as a rendering fault
             rather than as a turn. -->
        <Style Selector="Border#Badge">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08" Easing="CubicEaseIn"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#Lift.flipped Border#Badge">
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <!-- Reduced motion: the card is turned, it does not turn (§8). -->
        <Style Selector="Border#Lift.snap Border#Face, Border#Lift.snap Border#Back, Border#Lift.snap Border#Badge">
            <Setter Property="Transitions">
                <Transitions/>
            </Setter>
        </Style>

        <!-- A turned card does not also wake up under the pointer: the hover
             lift and the scrim belong to the art, and the art is face-down. -->
        <Style Selector="Border#Lift.flipped:pointerover">
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
        </Style>
        <Style Selector="Border#Lift.flipped:pointerover Border#Scrim">
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <!-- ── The back's own field and controls ───────────────────────────
             Everything here is Volt, Line or the text inks. NOT Flare: Flare
             marks unread updates and the bucket that counts them, and the moment
             a Play button or a flip affordance wears it the badge on the front
             of this very tile stops meaning anything (§2, §5.2). -->

        <Style Selector="Border.back-field">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}"/>
        </Style>

        <Style Selector="Button.tile-act">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.tile-act:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextDim}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <!-- §10.7: the ring is a brush swap on the presenter at a thickness that
             never changes. Thickening a border on focus reflows the row it sits
             in, and on a 148px card that is the whole back face moving. -->
        <Style Selector="Button.tile-act:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>

        <Style Selector="Button.tile-act.primary">
            <Setter Property="Background" Value="{StaticResource Volt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <Style Selector="Button.tile-act.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VoltHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VoltHover}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <Style Selector="Button.tile-act.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VoltPress}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VoltPress}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltInk}"/>
        </Style>
        <!-- On a Volt fill the ring cannot be Volt, so it is VoltInk (§10.7). -->
        <Style Selector="Button.tile-act.primary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource VoltInk}"/>
        </Style>


    </UserControl.Styles>

    <Border Name="Lift" CornerRadius="{StaticResource RadiusTile}" ClipToBounds="False"
            Background="Transparent"
            AutomationProperties.Name="{Binding AutomationName}"
            Classes.snap="{Binding SnapDormancy}"
            Classes.flipped="{Binding IsFlipped}">
        <Panel>

            <!-- Rounded clip for the art stack. This is the card's FRONT, and it
                 turns as one thing: the art, the hover scrim and the unread
                 badge all belong to the cover. -->
            <Border Name="Face"
                    CornerRadius="{StaticResource RadiusTile}" ClipToBounds="True"
                    BorderThickness="1" BorderBrush="{StaticResource LineSoft}">
                <Panel>

                    <!-- The card's own ground, under everything else on the
                         face. §5.4's dormancy ramp is a two-layer cross-fade —
                         the floor variant under the vivid one, whose opacity
                         carries the ramp — and the two are only opaque together
                         if BOTH have decoded. Between the first bitmap arriving
                         and the second, a dimmed tile is a partly transparent
                         tile, and whatever the window is standing on shows
                         through it. Opaque in every theme and both transparency
                         states, so the ramp composites over exactly the ground
                         it was calibrated against. -->
                    <Border Background="{StaticResource TileGround}"/>

                    <!-- Placeholder layers (§7): the title in Bricolage on a
                         Surface field, visible until real art lands and
                         whenever a game has no cover at all. Never a spinner,
                         never a hole. -->

                    <!-- Layer 1: dormancy floor (sat 0.22 / bright 0.60). -->
                    <Border Background="{Binding FloorBrush}"
                            IsVisible="{Binding #Root.Cover.ShowPlaceholder}">
                        <TextBlock Classes="art-title" Text="{Binding Title}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="Bold" FontSize="19" LineHeight="20"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding FloorTitleBrush}"
                                   VerticalAlignment="Bottom" Margin="14"/>
                    </Border>

                    <!-- Layer 2: vivid art; opacity carries the dormancy ramp,
                         hover animates it to 1.0 in 140ms. With dimming turned
                         off the ramp resolves to 1.0 and this layer simply
                         covers the floor layer — the floor variant is still
                         there, still cached, still valid. -->
                    <Border Name="VividArt"
                            Background="{Binding VividBrush}" Opacity="{Binding DisplayAlpha}"
                            IsVisible="{Binding #Root.Cover.ShowPlaceholder}">
                        <TextBlock Classes="art-title" Text="{Binding Title}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="Bold" FontSize="19" LineHeight="20"
                                   TextWrapping="Wrap"
                                   Foreground="White"
                                   VerticalAlignment="Bottom" Margin="14"/>
                    </Border>

                    <!-- Real cover art: the same two layers, the same alpha, the
                         same 140ms transition. The spike's whole point is that
                         swapping the source changes nothing about the fade. -->
                    <Image Source="{Binding #Root.Cover.Floor}" Stretch="UniformToFill"/>
                    <Image Name="VividArtwork"
                           Source="{Binding #Root.Cover.Vivid}" Stretch="UniformToFill"
                           Opacity="{Binding DisplayAlpha}"/>

                    <!-- Gloss sweep, per mock's .art::after. -->
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="70%,100%">
                                <GradientStop Offset="0" Color="#29FFFFFF"/>
                                <GradientStop Offset="0.42" Color="#00FFFFFF"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- The resting store mark, and the only thing on the front
                         of a tile that TASK-70.6 adds. Drawn only when the game
                         is owned on more than one store, so a library with
                         nothing linked gains no pixels at all; one letter per
                         store, because the density slider goes down to 108px
                         and a row of word-chips does not fit there. It fades
                         out as the hover scrim rises, exactly as the
                         placeholder title does, so the same corner never
                         carries two versions of one fact.

                         The words are in the tooltip, in the scrim, on the back
                         face and in the modal, and the automation name says
                         them too, so this mark is decorative-redundant per §8
                         rather than the only place the fact exists.

                         Never Flare and never Volt: a chip is where the game
                         lives, not an alarm and not a selection (§2). -->
                    <ItemsControl Name="RestingChips"
                                  ItemsSource="{Binding StoreInitials}"
                                  IsVisible="{Binding IsMultiStore}"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                  Margin="8" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="store-pip">
                                    <TextBlock Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Hover overlay: ≤ 4 facts — the tile is a decision surface. -->
                    <Border Name="Scrim" VerticalAlignment="Bottom" Padding="10,24,10,10"
                            Background="{StaticResource TileScrim}">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Border.Transitions>
                        <StackPanel Spacing="8">
                            <!-- §5.3: title in Body L, then playtime + idle,
                                 store badge, one primary action. Four facts. -->
                            <TextBlock Classes="body-l"
                                       Text="{Binding Title}"
                                       TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       LineHeight="18"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="data-s"
                                           Text="{Binding StatText}" VerticalAlignment="Center"/>
                                <!-- Single-store tile: one badge beside the stat, as
                                     the overlay has always drawn it. -->
                                <Border Grid.Column="1" Classes="store-chip"
                                        IsVisible="{Binding !IsMultiStore}">
                                    <TextBlock Text="{Binding StoreBadge}"/>
                                </Border>
                            </Grid>
                            <!-- Multi-store chips sit on their own line. Beside the stat
                                 they win the Auto column at the 108 px density floor and
                                 leave playtime with no width, and playtime is the fact the
                                 overlay exists for. One extra line, only on the rare tile
                                 that has earned it; still one "where you own it" fact, so
                                 the four-fact cap (section 5.3) is not breached. -->
                            <ItemsControl ItemsSource="{Binding StoreChips}"
                                          IsVisible="{Binding IsMultiStore}"
                                          ToolTip.Tip="{Binding StoreNames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="store-chip">
                                            <TextBlock Text="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- §5.3's "single primary action, Play, in Volt" has
                                 MOVED TO THE BACK OF THE CARD, and this is the
                                 deviation, recorded rather than silent.

                                 It was an inert button here for the whole of M0.
                                 Making it live would have put a full-width launch
                                 target in a surface that appears on hover, on the
                                 same click that turns the card over — so the
                                 gesture that reveals the actions and the gesture
                                 that fires one would be the same gesture, half a
                                 tile apart. §5.3's own reason for capping the
                                 overlay is that "the tile is a decision surface";
                                 the decision now leads one click to a face that
                                 can name the action honestly per store and per
                                 install state, which an always-"Play" button
                                 could not. The overlay keeps its facts. -->
                        </StackPanel>
                    </Border>

                </Panel>
            </Border>

            <!-- ══ The card's BACK ═══════════════════════════════════════════
                 A few facts worth knowing at a glance, and the actions for this
                 one game.

                 It carries FOUR facts, which is §5.3's cap for the hover overlay
                 applied to the other face of the same object: the pile this game
                 is in, the time on the clock, the day you stopped, and what it is
                 and where you own it. Not a detail view — the third button is
                 how you get to that.

                 `Details` is on it because the flip took the gesture that used
                 to open the modal, and §10 calls that modal the answer to the
                 four-fact cap. A surface the app depends on for everything the
                 tile cannot say must not become unreachable by taking away the
                 only pointer route to it.

                 The bucket name doubles as §8's redundant backing for the unread
                 dot on the front: a game wearing the Flare badge reads "Patched
                 since" here, in words, for anyone who cannot resolve a 10px mark.

                 Every number below is Plex Mono with tabular figures — the
                 `data-s` class carries `FontFeatures="tnum"`. -->
            <Border Name="Back" Classes="back-field" ClipToBounds="True">
                <DockPanel Margin="10,10,10,10" LastChildFill="True">

                    <StackPanel DockPanel.Dock="Bottom" Spacing="4">
                        <!-- Play when it is on disk, Install when it is not, and
                             NOTHING when this app cannot honestly name either —
                             no id for the store, no verified install route for
                             the store, or no answer at all about the install
                             state. §10.3: never an inert button.

                             Volt, because it is the app's one primary-action
                             treatment. Never Flare: that colour means "unread"
                             and nothing else, and it is on the other side of
                             this very card. -->
                        <Button Classes="tile-act primary"
                                Content="{Binding PrimaryActionLabel}"
                                ToolTip.Tip="{Binding PrimaryActionHint}"
                                IsVisible="{Binding HasPrimaryAction}"
                                Command="{Binding PrimaryActionCommand}"
                                CommandParameter="{Binding}"/>

                        <!-- The single-game route into lists. The command bar's
                             button is the bulk route and stays exactly where it
                             is (§6, §12.3) — per-card flipping would make "add
                             twenty games to a list" twenty flips. -->
                        <Button Classes="tile-act"
                                Content="Add to list"
                                ToolTip.Tip="Put this title in a list"
                                Command="{Binding AddToListCommand}"/>

                        <Button Classes="tile-act"
                                Content="Details"
                                ToolTip.Tip="Full details"
                                Command="{Binding OpenDetailsCommand}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding Title}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="Bold" FontSize="13" LineHeight="15"
                                   TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Text}"/>

                        <TextBlock Classes="label" FontSize="10"
                                   Text="{Binding BucketLabel}"
                                   TextTrimming="CharacterEllipsis"/>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Classes="label" FontSize="9"
                                       Text="PLAYED" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="data-s"
                                       Foreground="{StaticResource Text}"
                                       HorizontalAlignment="Right"
                                       Text="{Binding PlaytimeText}"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Classes="label" FontSize="9"
                                       Text="LAST" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="data-s"
                                       HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding LastPlayedText}"/>
                        </Grid>

                        <!-- A year is a number, so it sets in Plex Mono; the stores are
                             names, so they wear the outlined chip the overlay uses.
                        
                             Chips wrap rather than pinning to one line beside the year:
                             at the density floor two word-chips are wider than the card,
                             and a chip clipped mid-glyph reads as a rendering fault. -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Classes="data-s"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasReleaseYear}"
                                       Text="{Binding ReleaseYearText}"/>
                            <ItemsControl Grid.Column="1"
                                          HorizontalAlignment="Right"
                                          ItemsSource="{Binding StoreChips}"
                                          ToolTip.Tip="{Binding StoreNames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="store-chip">
                                            <TextBlock Text="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- Keyboard/pointer selection ring (§8's 2px Volt edge).
                 Drawn INSIDE the tile's own bounds. The mock's
                 `outline-offset:1px` puts it 3px outside, which the grid then
                 clips on the first/last column and the top/bottom row — the
                 ring is the one part of a tile that must never look damaged,
                 since a half-drawn ring reads as a rendering fault rather than
                 as selection. Inverting the offset inward keeps the ring and
                 its 1px separator complete on every tile, and costs 3px of art
                 on the selected tile only. Tile pitch is untouched, so nothing
                 reflows. -->
            <Border BorderBrush="{StaticResource Volt}" BorderThickness="2"
                    CornerRadius="{StaticResource RadiusTile}"
                    IsHitTestVisible="False"
                    IsVisible="{Binding IsSelected}">
                <Border BorderBrush="{StaticResource Ground}" BorderThickness="1"
                        CornerRadius="4"/>
            </Border>

            <!-- Unread-update badge (§5.2): 10px Flare dot, 2px Ground ring,
                 soft glow. Flare appears here and on the rail pip — nowhere else.

                 It belongs to the FRONT and turns with it, but it is declared
                 outside the clip so its glow is not sheared off at the tile's
                 corner; the style below fades it with the front instead. The
                 back restates it in words as the "Patched since" bucket name
                 (§8), so nothing is lost while the card is turned. -->
            <Border Name="Badge"
                    Width="14" Height="14" CornerRadius="7"
                    Background="{StaticResource Flare}"
                    BorderBrush="{StaticResource Ground}" BorderThickness="2"
                    BoxShadow="{DynamicResource BadgeGlow}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    IsVisible="{Binding HasUnread}"/>

        </Panel>
    </Border>

</UserControl>
