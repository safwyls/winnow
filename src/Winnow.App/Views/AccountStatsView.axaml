<UserControl AutomationProperties.Name="Account stats" AutomationProperties.ControlTypeOverride="Group" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Winnow.App.ViewModels"
             xmlns:views="using:Winnow.App.Views"
             x:Class="Winnow.App.Views.AccountStatsView"
             x:DataType="vm:AccountStatsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style Selector="Border.note">
            <Setter Property="Background" Value="{StaticResource Well}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style Selector="Border.note.attention">
            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
        </Style>
        <Style Selector="TextBlock.count">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="{StaticResource DataSize}"/>
            <Setter Property="FontFeatures" Value="tnum"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.amount">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="{StaticResource DataSize}"/>
            <Setter Property="FontFeatures" Value="tnum"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.colhead">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="StatRow" x:DataType="vm:AccountStatRow">
            <Grid ColumnDefinitions="*,16,96,16,132" Margin="0,3">
                <TextBlock Grid.Column="0"
                           Classes="para"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding Label}"/>
                <TextBlock Grid.Column="2"
                           Classes="count"
                           Text="{Binding CountText}"/>
                <TextBlock Grid.Column="4"
                           Classes="amount"
                           Text="{Binding AmountText}"/>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                IsVisible="{Binding ShowHeader, RelativeSource={RelativeSource AncestorType=views:AccountStatsView}}"
                Padding="24,20,24,18"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="7">
                <TextBlock AutomationProperties.HeadingLevel="1" Classes="display-l" Text="{Binding Title}"/>
                <TextBlock Classes="body prose"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           Foreground="{StaticResource TextDim}"
                           Text="{Binding IntroMessage}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,12,24,28"
                        MaxWidth="1040"
                        HorizontalAlignment="Left"
                        Spacing="16">
                <Border Classes="card" IsVisible="{Binding !HasFacts}">
                    <TextBlock Classes="para lead" Text="{Binding EmptyMessage}"/>
                </Border>
                <StackPanel Spacing="16" IsVisible="{Binding HasFacts}">
                    <Border Classes="note" IsVisible="{Binding IsMixedCurrency}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="label" FontSize="10" LetterSpacing="1"
                                       Foreground="{StaticResource TextDim}"
                                       Text="{Binding MixedCurrencyHeading}"/>
                            <TextBlock Classes="para lead" Text="{Binding MixedCurrencyMessage}"/>
                        </StackPanel>
                    </Border>

                    <views:AccountStatsDashboard/>

                    <Expander Header="Detailed figures" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock AutomationProperties.HeadingLevel="2" Classes="display-l" FontSize="18" Text="{Binding SpendHeading}"/>
                            <TextBlock Classes="para" Text="{Binding SpendNote}"/>

                            <Grid ColumnDefinitions="*,16,96,16,132">
                                <TextBlock Grid.Column="2" Classes="label colhead"
                                           FontSize="10" LetterSpacing="1" Text="TRANSACTIONS"/>
                                <TextBlock Grid.Column="4" Classes="label colhead"
                                           FontSize="10" LetterSpacing="1" Text="TOTAL"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding SpendRows}"
                                          ItemTemplate="{StaticResource StatRow}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock AutomationProperties.HeadingLevel="2" Classes="display-l" FontSize="18" Text="{Binding YearHeading}"/>
                            <TextBlock Classes="para" Text="{Binding YearNote}"/>
                            <ItemsControl ItemsSource="{Binding YearRows}"
                                          ItemTemplate="{StaticResource StatRow}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock AutomationProperties.HeadingLevel="2" Classes="display-l" FontSize="18" Text="{Binding KindHeading}"/>
                            <ItemsControl ItemsSource="{Binding KindRows}"
                                          ItemTemplate="{StaticResource StatRow}"/>
                            <Border Classes="note">
                                <TextBlock Classes="para" Text="{Binding GiftsNote}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock AutomationProperties.HeadingLevel="2" Classes="display-l" FontSize="18" Text="{Binding RefundHeading}"/>
                            <ItemsControl ItemsSource="{Binding RefundRows}"
                                          ItemTemplate="{StaticResource StatRow}"/>
                            <TextBlock Classes="para" Text="{Binding RefundNote}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock AutomationProperties.HeadingLevel="2" Classes="display-l" FontSize="18" Text="{Binding BundleHeading}"/>
                            <ItemsControl ItemsSource="{Binding BundleRows}"
                                          ItemTemplate="{StaticResource StatRow}"/>
                            <TextBlock Classes="para" Text="{Binding BundleNote}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock AutomationProperties.HeadingLevel="2" Classes="display-l" FontSize="18" Text="{Binding DiscountHeading}"/>
                            <ItemsControl ItemsSource="{Binding DiscountRows}"
                                          ItemTemplate="{StaticResource StatRow}"/>
                            <Border Classes="note">
                                <TextBlock Classes="para" Text="{Binding DiscountNote}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Classes="card" IsVisible="{Binding ShowBiggest}">
                        <StackPanel Spacing="14">
                            <TextBlock AutomationProperties.HeadingLevel="2" Classes="display-l" FontSize="18" Text="{Binding BiggestHeading}"/>

                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Classes="data"
                                           FontSize="22"
                                           Foreground="{StaticResource Volt}"
                                           IsVisible="{Binding ShowBiggestAmount}"
                                           Text="{Binding BiggestAmountText}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="data"
                                           Foreground="{StaticResource TextDim}"
                                           Text="{Binding BiggestWhenText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Classes="body"
                                       TextWrapping="Wrap"
                                       Text="{Binding BiggestItemsText}"/>

                            <TextBlock Classes="para" Text="{Binding BiggestNote}"/>

                            <Border Classes="note" IsVisible="{Binding ShowBiggestIsBundle}">
                                <TextBlock Classes="para" Text="{Binding BiggestIsBundleNote}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock AutomationProperties.HeadingLevel="2" Classes="display-l" FontSize="18" Text="{Binding WalletHeading}"/>
                            <ItemsControl ItemsSource="{Binding WalletRows}"
                                          ItemTemplate="{StaticResource StatRow}"/>
                            <Border Classes="note">
                                <TextBlock Classes="para" Text="{Binding WalletNote}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock AutomationProperties.HeadingLevel="2" Classes="display-l" FontSize="18" Text="{Binding LicenceHeading}"/>
                            <TextBlock Classes="para" Text="{Binding LicenceNote}"/>
                            <ItemsControl ItemsSource="{Binding LicenceRows}"
                                          ItemTemplate="{StaticResource StatRow}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card" IsVisible="{Binding ShowCurrencies}">
                        <StackPanel Spacing="14">
                            <TextBlock AutomationProperties.HeadingLevel="2" Classes="display-l" FontSize="18" Text="{Binding CurrencyHeading}"/>
                            <TextBlock Classes="para" Text="{Binding CurrencyNote}"/>
                            <ItemsControl ItemsSource="{Binding CurrencyRows}"
                                          ItemTemplate="{StaticResource StatRow}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock AutomationProperties.HeadingLevel="2" Classes="display-l" FontSize="18" Text="{Binding CaptureHeading}"/>
                            <TextBlock Classes="para" Text="{Binding CaptureNote}"/>
                            <ItemsControl ItemsSource="{Binding CaptureRows}"
                                          ItemTemplate="{StaticResource StatRow}"/>
                            <Border Classes="note">
                                <TextBlock Classes="para" Text="{Binding ThirdPartyKeysNote}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                    </Expander>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
