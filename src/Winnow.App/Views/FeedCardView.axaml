<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Winnow.App.ViewModels"
             xmlns:views="using:Winnow.App.Views"
             x:Class="Winnow.App.Views.FeedCardView"
             x:DataType="vm:FeedCardViewModel">
    <UserControl.Styles>
        <Style Selector="Button.feedcard">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.feedcard /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Border#FocusRing">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Button.feedcard:pointerover Border#FocusRing, Button.feedcard:focus-within Border#FocusRing, Button.feedcard.open Border#FocusRing">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- Keep actions measured and keyboard reachable; only their pixels disappear at rest. -->
        <Style Selector="Border#ActionStrip">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Button.feedcard:pointerover Border#ActionStrip, Button.feedcard:focus-within Border#ActionStrip, Button.feedcard.open Border#ActionStrip">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="Button.cardaside">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.cardaside:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.cardaside:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>
        <Style Selector="Panel#Art Border#VividArt, Panel#Art Image#VividArtwork, Panel#Art views|CoverPadding#VividPadding">
            <Setter Property="Transitions"><Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut"/>
            </Transitions></Setter>
        </Style>
        <Style Selector="Panel#Art.snap Border#VividArt, Panel#Art.snap Image#VividArtwork, Panel#Art.snap views|CoverPadding#VividPadding">
            <Setter Property="Transitions"><Transitions/></Setter>
        </Style>
        <Style Selector="Button.feedcard.setaside Panel#Art"><Setter Property="Opacity" Value="0.42"/></Style>
        <Style Selector="Arc#CountdownSweep"><Setter Property="Transitions"><Transitions>
            <DoubleTransition Property="SweepAngle" Duration="0:0:0.033" Easing="LinearEasing"/>
        </Transitions></Setter></Style>
        <Style Selector="Panel#Countdown.snap Arc#CountdownSweep"><Setter Property="Transitions"><Transitions/></Setter></Style>
    </UserControl.Styles>
    <Button Name="Card" Classes="feedcard" Classes.setaside="{Binding IsSetAside}"
            AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.ItemStatus="{Binding StatusAnnouncement}">
        <StackPanel Spacing="8">
            <Panel Name="CoverFrame" Height="270">
                <Border CornerRadius="6" ClipToBounds="True" Background="{StaticResource Surface}">
                    <Panel Name="Art" Classes.snap="{Binding Tile.SnapDormancy}" IsHitTestVisible="False">
                        <Border Background="{Binding Tile.FloorBrush}" IsVisible="{Binding Cover.ShowPlaceholder}">
                            <TextBlock Text="{Binding Tile.Title}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                       FontSize="18" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="12"
                                       Foreground="{Binding Tile.FloorTitleBrush}"/>
                        </Border>
                        <Border Name="VividArt" Background="{Binding Tile.VividBrush}" Opacity="{Binding Tile.DisplayAlpha}"
                                IsVisible="{Binding Cover.ShowPlaceholder}">
                            <TextBlock Text="{Binding Tile.Title}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                       FontSize="18" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="12" Foreground="White"/>
                        </Border>
                        <views:CoverPadding Source="{Binding Cover.Floor}"/>
                        <views:CoverPadding Name="VividPadding" Source="{Binding Cover.Vivid}" Opacity="{Binding Tile.DisplayAlpha}"/>
                        <Image views:CoverPresentation.IsCover="True" Source="{Binding Cover.Floor}"/>
                        <Image views:CoverPresentation.IsCover="True" Name="VividArtwork" Source="{Binding Cover.Vivid}" Opacity="{Binding Tile.DisplayAlpha}"/>
                    </Panel>
                </Border>
                <Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource Flare}"
                        BorderBrush="{StaticResource Ground}" BorderThickness="2" BoxShadow="{DynamicResource BadgeGlow}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" IsVisible="{Binding Tile.HasUnread}"/>
                <Panel IsVisible="{Binding HasSecondaryActions}">
                <Border Name="ActionStrip" Background="{StaticResource Surface}" CornerRadius="0,0,6,6"
                        VerticalAlignment="Bottom" Padding="6" IsVisible="{Binding ShowActions}">
                    <StackPanel Name="FeedbackActions" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button Name="AddToList" Classes="cardaside" ToolTip.Tip="Add to list" AutomationProperties.Name="Add to list"
                                IsVisible="{Binding CanAddToList}" Command="{Binding AddToListCommand}">
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Text}" StrokeThickness="1.6"
                                  Data="M 2,3 L 12,3 M 2,8 L 8,8 M 2,13 L 8,13 M 12,9 L 12,15 M 9,12 L 15,12"/>
                        </Button>
                        <Button Name="NotNow" Classes="cardaside" ToolTip.Tip="Not now" AutomationProperties.Name="Not now"
                                IsVisible="{Binding CanGiveFeedback}" Command="{Binding NotNowCommand}">
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Text}" StrokeThickness="1.6"
                                  Data="M 8,1 A 7,7 0 1 1 7.99,1 Z M 8,4 L 8,8 L 11,10"/>
                        </Button>
                        <Button Name="NotInterested" Classes="cardaside" ToolTip.Tip="Not interested" AutomationProperties.Name="Not interested"
                                IsVisible="{Binding CanGiveFeedback}" Command="{Binding NotInterestedCommand}">
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Text}" StrokeThickness="1.6"
                                  Data="M 8,1 A 7,7 0 1 1 7.99,1 Z M 3,13 L 13,3"/>
                        </Button>
                    </StackPanel>
                </Border>
                </Panel>
                <Border Background="{StaticResource Surface}" CornerRadius="0,0,6,6" VerticalAlignment="Bottom"
                        Padding="10" IsVisible="{Binding IsSetAside}">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="body" Text="{Binding SetAsideNote}" TextWrapping="Wrap"/>
                        <TextBlock Classes="data" Text="{Binding SetAsideDate}" IsVisible="{Binding HasSetAsideDate}"/>
                        <Button Classes="act quiet" Content="Undo" Command="{Binding UndoCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Panel Name="Countdown" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                       Background="{StaticResource Surface}" IsVisible="{Binding IsCountingDown}" Classes.snap="{Binding Tile.SnapDormancy}"
                       ToolTip.Tip="Replaced by the next suggestion. Undo is on the history screen.">
                    <Ellipse Width="14" Height="14" Stroke="{StaticResource LineSoft}" StrokeThickness="2"/>
                    <Arc Name="CountdownSweep" Width="14" Height="14" StartAngle="-90" SweepAngle="{Binding CountdownSweep}"
                         Stroke="{StaticResource Azure}" StrokeThickness="2"/>
                </Panel>
                <Border Name="FocusRing" BorderBrush="{StaticResource Volt}" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False"/>
            </Panel>
            <TextBlock Text="{Binding Tile.Title}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                       FontSize="15" LineHeight="19" Height="19" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}"/>
            <TextBlock Name="Reason" Classes="body" FontFeatures="tnum" TextWrapping="Wrap" MaxLines="2" Height="36"
                       TextTrimming="CharacterEllipsis" LineHeight="18" Foreground="{StaticResource TextDim}"/>
            <TextBlock Classes="body" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Amber}"
                       IsVisible="{Binding HasProblem}" Text="{Binding Problem}"/>
        </StackPanel>
    </Button>
</UserControl>
