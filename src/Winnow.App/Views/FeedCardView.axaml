<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Winnow.App.ViewModels"
             x:Class="Winnow.App.Views.FeedCardView"
             x:DataType="vm:FeedCardViewModel">

    <!-- Feed card: cover, name, and full reason sentence. Card is a Button
         (Tab stop, Enter, detail modal). Cover is 108x162 (TileMinWidth).
         Flare appears once, on the unread dot only (§2). -->

    <UserControl.Styles>

        <!-- The card. Opaque Surface (needed for dormancy cross-fade and
             readability over translucent pane ground). -->
        <Style Selector="Button.feedcard">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}"/>
            <!-- Zero padding; inset is on the content. Focus ring draws
                 at the card's edge. -->
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <!-- Elevation is the Surface → SurfaceRaised step (§4). The one place a
             drop shadow is permitted is a tile on the wall, and a card is not
             one — what lifts under the pointer here is the ART, by waking up. -->
        <Style Selector="Button.feedcard /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusTile}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.feedcard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        </Style>
        <Style Selector="Button.feedcard:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHigh}"/>
        </Style>

        <!-- ══ §8's focus ring: 2px Volt, no reflow ═══════════════════════
             Element-drawn so thickness stays constant (§10.7). -->
        <Style Selector="Button.feedcard:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border#FocusRing">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button.feedcard:focus-visible Border#FocusRing">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- §5.1's dormancy cross-fade. Transition in a style (not on the
             element) so reduced-motion can remove it. -->
        <Style Selector="Panel#Art Border#VividArt, Panel#Art Image#VividArtwork">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- Reduced motion: the state snaps instead of fading (§8). An empty
             transition set, not a zero duration — there is then no animation to
             schedule at all. -->
        <Style Selector="Panel#Art.snap Border#VividArt, Panel#Art.snap Image#VividArtwork">
            <Setter Property="Transitions">
                <Transitions/>
            </Setter>
        </Style>

        <!-- Compact action. The app's one primary treatment (Volt fill) at the
             card's scale; the sizes are local values because nothing overrides
             them and a second class for two numbers would be furniture. -->
        <Style Selector="Button.cardact">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <!-- ══ The two feedback controls ═══════════════════════════════════
             "Not interested" and "Not now". TextDim at rest, full Text on
             card hover/focus-within. Constant border for focus ring. -->
        <Style Selector="Button.cardaside">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.cardaside /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <!-- Card hovered/focused: feedback controls lift to full ink. -->
        <Style Selector="Button.feedcard:pointerover Button.cardaside /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Button.feedcard:focus-within Button.cardaside /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <!-- Its own hover is a raised field rather than a colour: a dismiss
             control is not an alarm, and Flare is the badge's alone (§2). -->
        <Style Selector="Button.cardaside:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHigh}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Button.cardaside:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHigh}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style Selector="Button.cardaside:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Volt}"/>
        </Style>

        <!-- A card the user has answered. Only the art dims (text stays
             full ink). State also stated in words on the receipt line (§8). -->
        <Style Selector="Button.feedcard.setaside Panel#Art">
            <Setter Property="Opacity" Value="0.42"/>
        </Style>

    </UserControl.Styles>

    <Button Name="Card"
            Classes="feedcard"
            Classes.setaside="{Binding IsSetAside}"
            Command="{Binding Tile.OpenDetailsCommand}"
            CommandParameter="{Binding Tile}">
        <!-- No tooltip; hovering is the resting state of reading this
             screen, so a tooltip would cover adjacent cards' sentences. -->
        <Panel>
        <Grid Margin="14" ColumnDefinitions="108,14,*">

            <!-- ══ The art ══════════════════════════════════════════════════
                 Two-layer dormancy cross-fade and unread badge, same as the
                 wall tiles. Reproduced (not shared) because pointer semantics
                 differ; they share the view model. -->
            <Panel Grid.Column="0"
                   Name="Art"
                   Width="108" Height="162"
                   VerticalAlignment="Top"
                   Classes.snap="{Binding Tile.SnapDormancy}">

                <Border CornerRadius="{StaticResource RadiusTile}" ClipToBounds="True"
                        BorderThickness="1" BorderBrush="{StaticResource LineSoft}">
                    <Panel>
                        <!-- Opaque ground under both art layers. -->
                        <Border Background="{StaticResource TileGround}"/>

                        <!-- Placeholder (§7): title on Surface until art loads. -->
                        <Border Background="{Binding Tile.FloorBrush}"
                                IsVisible="{Binding Cover.ShowPlaceholder}">
                            <TextBlock Text="{Binding Tile.Title}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="Bold" FontSize="15" LineHeight="17"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding Tile.FloorTitleBrush}"
                                       VerticalAlignment="Bottom" Margin="10"/>
                        </Border>
                        <Border Name="VividArt"
                                Background="{Binding Tile.VividBrush}"
                                Opacity="{Binding Tile.DisplayAlpha}"
                                IsVisible="{Binding Cover.ShowPlaceholder}">
                            <TextBlock Text="{Binding Tile.Title}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="Bold" FontSize="15" LineHeight="17"
                                       TextWrapping="Wrap"
                                       Foreground="White"
                                       VerticalAlignment="Bottom" Margin="10"/>
                        </Border>

                        <Image Source="{Binding Cover.Floor}" Stretch="UniformToFill"/>
                        <Image Name="VividArtwork"
                               Source="{Binding Cover.Vivid}" Stretch="UniformToFill"
                               Opacity="{Binding Tile.DisplayAlpha}"/>

                        <!-- Gloss sweep, as on the wall. -->
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="70%,100%">
                                    <GradientStop Offset="0" Color="#29FFFFFF"/>
                                    <GradientStop Offset="0.42" Color="#00FFFFFF"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Panel>
                </Border>

                <!-- Unread badge (§5.2), outside clip for glow. Flare's one
                     use: an update landed after last session. -->
                <Border Width="14" Height="14" CornerRadius="7"
                        Background="{StaticResource Flare}"
                        BorderBrush="{StaticResource Ground}" BorderThickness="2"
                        BoxShadow="{DynamicResource BadgeGlow}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,6,0"
                        IsVisible="{Binding Tile.HasUnread}"/>
            </Panel>

            <!-- ══ The name, the sentence, the way in ═══════════════════════ -->
            <DockPanel Grid.Column="2" LastChildFill="True">

                <!-- ══ The action line ═════════════════════════
                     Pinned to the bottom so rows of cards align. Holds Play,
                     the two feedback controls, and the store badge. On act,
                     swaps for a receipt with Undo (same height, no reflow). -->
                <Panel DockPanel.Dock="Bottom" Margin="0,10,0,0">

                    <!-- The unanswered state. -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                          IsVisible="{Binding ShowActions}">

                        <!-- Play/Install, or hidden if no action can be
                             honestly named (§10.3). -->
                        <Button Grid.Column="0"
                                Classes="act primary cardact"
                                Margin="0,0,8,0"
                                Content="{Binding Tile.PrimaryActionLabel}"
                                ToolTip.Tip="{Binding Tile.PrimaryActionHint}"
                                IsVisible="{Binding Tile.HasPrimaryAction}"
                                Command="{Binding Tile.PrimaryActionCommand}"
                                CommandParameter="{Binding Tile}"/>

                        <!-- The durable verdict. Not styled as destructive. -->
                        <Button Grid.Column="1"
                                Classes="cardaside"
                                Content="Not interested"
                                IsVisible="{Binding CanGiveFeedback}"
                                Command="{Binding NotInterestedCommand}"/>

                        <!-- The deferral. Separate control because it is a
                             separate intent (§6b). -->
                        <Button Grid.Column="2"
                                Classes="cardaside"
                                Content="Not now"
                                IsVisible="{Binding CanGiveFeedback}"
                                Command="{Binding NotNowCommand}"/>

                        <!-- The one fact the sentence never states. A name, so it
                             wears the outlined badge the tile's overlay uses
                             rather than a colour. -->
                        <Border Grid.Column="4"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="3" Padding="5,1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Tile.StoreBadge}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="9" LetterSpacing="0.54"
                                       Foreground="{StaticResource TextDim}"/>
                        </Border>
                    </Grid>

                    <!-- The receipt. Date in Plex Mono, prose in body face. -->
                    <Grid ColumnDefinitions="*,Auto"
                          IsVisible="{Binding IsSetAside}">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal" Spacing="5"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="body"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}"
                                       Text="{Binding SetAsideNote}"/>
                            <TextBlock Classes="data"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}"
                                       IsVisible="{Binding HasSetAsideDate}"
                                       Text="{Binding SetAsideDate}"/>
                        </StackPanel>

                        <!-- Quiet, not primary: the way back, not the next
                             action. -->
                        <Button Grid.Column="1"
                                Classes="act quiet cardact"
                                Content="Undo"
                                Command="{Binding UndoCommand}"/>
                    </Grid>
                </Panel>

                <!-- A write that did not land. Controls stay in place for
                     retry; Amber for attention (§2). -->
                <TextBlock DockPanel.Dock="Bottom"
                           Classes="body"
                           FontSize="11"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Amber}"
                           IsVisible="{Binding HasProblem}"
                           Text="{Binding Problem}"/>

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Tile.Title}"
                               FontFamily="{StaticResource DisplayFont}"
                               FontWeight="Bold" FontSize="15" LineHeight="17"
                               TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Text}"/>

                    <!-- THE REASON. Full wrap, no trimming. Inlines built in
                         code-behind so numbers use Plex Mono tnum (§3). -->
                    <TextBlock Name="Reason"
                               Classes="body"
                               FontFeatures="tnum"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Foreground="{StaticResource Text}"/>
                </StackPanel>

            </DockPanel>
        </Grid>

        <!-- Focus ring drawn inside the card bounds (outward offset
             would be clipped by ScrollViewer). 1px Ground separator
             inside the 2px Volt ring. -->
        <Border Name="FocusRing"
                BorderBrush="{StaticResource Volt}" BorderThickness="2"
                CornerRadius="{StaticResource RadiusTile}"
                IsHitTestVisible="False">
            <Border BorderBrush="{StaticResource Ground}" BorderThickness="1"
                    CornerRadius="4"/>
        </Border>
        </Panel>
    </Button>

</UserControl>
