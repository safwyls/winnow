<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Winnow.App.App"
             RequestedThemeVariant="Dark">

    <!-- Application-level by design: the icon must outlive a hidden window. -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/Icons/dragon.ico"
                      ToolTipText="Winnow"
                      IsVisible="False"
                      Clicked="OnTrayClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open Winnow" Click="OnOpenFromTray"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Exit" Click="OnExitFromTray"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Styles>
        <FluentTheme />
        <!-- Shared components: the composites drawn by more than one screen.
             Every reference inside it is DynamicResource, because this include
             is parsed before Application.Resources below is populated — see the
             file's own header. -->
        <StyleInclude Source="avares://Winnow/Themes/controls.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Winnow/Themes/tokens.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
