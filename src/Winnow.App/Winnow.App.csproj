<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- avares:// URIs in tokens.axaml address the assembly as "Winnow" (design doc: binary `winnow`). -->
    <AssemblyName>Winnow</AssemblyName>
    <RootNamespace>Winnow.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- MANDATORY for the embedded-browser sign-in, and Winnow had none before
         M4.6. Avalonia's NativeControlHost throws "Application manifest with
         supported OS list might be required" on the first layout pass without
         one, before any WebView2 code runs. See app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The executable's own icon, written into the apphost's RT_GROUP_ICON.
         Without it the built exe wears the generic .NET icon in Explorer, in
         the Start menu and anywhere the shell reads the file rather than a
         running window.

         It is a real multi-size .ico — 16/24/32/48 as DIBs and 64/128/256 as
         PNGs — generated from Assets/Icons/dragon.svg rather than downscaled
         from one bitmap, because the shell picks the frame that matches the
         surface and a 256 stretched to 16 is mud. Assets/Icons/README.md
         carries the generator and the measurements behind the small sizes. -->
    <ApplicationIcon>Assets\Icons\dragon.ico</ApplicationIcon>

  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Themes\Bundled\*.json" />
    <EmbeddedResource Include="Services\Install-Update.ps1" LogicalName="Winnow.UpdateHelper.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- TASK-152.4: on the R2R-published win-x64 build, real library, with
         the startup pipeline skipped (no sync), two runs, System.GC.
         ConserveMemory=9 dropped private bytes from ~266-283 MB to
         ~242-253 MB and GC committed from ~86-97 MB to ~61-65 MB, against
         ~1-2 MB from level 5. See the Follow-up section of
         docs/spikes/memory-footprint.md. Scoped to a win-x64 publish (the
         RuntimeIdentifier packaging/Publish.ps1 sets): unmeasured for
         linux-x64, and not applied to a plain `dotnet run`/`dotnet build`
         where no RuntimeIdentifier is set. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
  </ItemGroup>

  <ItemGroup>
    <!-- The settings keys the backfill writes its completion markers under, and
         the parse that reads them back. They are internal because nothing
         outside this assembly may write them, and a test that reproduced the
         key format by hand would pass while the product wrote a different one —
         which is exactly how the TASK-54 disclosure bug would have escaped
         again. Same reasoning as Winnow.Covers and Winnow.Recommend. -->
    <InternalsVisibleTo Include="Winnow.Tests" />
    <!-- The design-time preview data (Design/) is internal; the headless UI
         tests attach it to its views so a constructor change cannot silently
         leave the previewer empty again. -->
    <InternalsVisibleTo Include="Winnow.Ui.Tests" />
  </ItemGroup>

  <!-- Git-ignored local credentials, copied next to the executable so
       the backend can load it from the installation directory. Conditional: the
       file is absent in every clean checkout and its absence is normal. -->
  <ItemGroup Condition="Exists('appsettings.local.json')">
    <None Include="appsettings.local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <!-- No Avalonia.Controls.ItemsRepeater. Its UniformGridLayout charges every
         item in a row for a trailing gutter when it computes items-per-line for
         the scroll anchor, but packs rows greedily when it places them, so §4's
         flush-row geometry made the two disagree by one column at every window
         width. The cover wall is Views/CoverWall now — see its remarks and
         docs/spikes/avalonia-dormancy-rendering.md. -->
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The embedded browser. A leaf project so the WebView2 dependency, and
         the Windows-only code that drives it, live in exactly one place; the
         Ingest projects reach it only through Winnow.Core's IInteractiveAuthPrompt
         and never reference Avalonia or WebView2 themselves (§5.1). -->
    <ProjectReference Include="..\Winnow.Auth.WebView\Winnow.Auth.WebView.csproj" />
    <ProjectReference Include="..\Winnow.Core\Winnow.Core.csproj" />
    <ProjectReference Include="..\Winnow.Api.Client\Winnow.Api.Client.csproj" />
    <ProjectReference Include="..\Winnow.Activation\Winnow.Activation.csproj" />
    <ProjectReference Include="..\Winnow.Update\Winnow.Update.csproj" />
    <ProjectReference Include="..\Winnow.Covers.Avalonia\Winnow.Covers.Avalonia.csproj" />
    <ProjectReference Include="..\..\plugins\Winnow.Plugin.SteamGridDb\Winnow.Plugin.SteamGridDb.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Winnow.Backend\Winnow.Backend.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyBackendCompanion" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\Winnow.Backend\Winnow.Backend.csproj" Targets="GetTargetPath" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="BackendCompanionAssembly" />
    </MSBuild>
    <PropertyGroup>
      <BackendCompanionDirectory>@(BackendCompanionAssembly->'%(RootDir)%(Directory)')</BackendCompanionDirectory>
    </PropertyGroup>
    <ItemGroup>
      <BackendCompanionFiles Include="$(BackendCompanionDirectory)**\*" Exclude="$(BackendCompanionDirectory)backend\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BackendCompanionFiles)" DestinationFiles="@(BackendCompanionFiles->'$(TargetDir)backend\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyBundledPlugins" AfterTargets="Build">
    <!-- The SDK builds this managed library reference without the app's RID.
         Query that same target path during self-contained publishing. -->
    <MSBuild Projects="..\..\plugins\Winnow.Plugin.SteamGridDb\Winnow.Plugin.SteamGridDb.csproj" Targets="GetTargetPath" BuildInParallel="false" RemoveProperties="RuntimeIdentifier;SelfContained;PublishReadyToRun">
      <Output TaskParameter="TargetOutputs" ItemName="BundledPluginAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(BundledPluginAssembly)" DestinationFolder="$(OutDir)plugins\steamgriddb" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\plugins\Winnow.Plugin.SteamGridDb\plugin.json" DestinationFolder="$(OutDir)plugins\steamgriddb" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishBundledPlugins" AfterTargets="Publish" DependsOnTargets="CopyBundledPlugins">
    <Copy SourceFiles="@(BundledPluginAssembly)" DestinationFolder="$(PublishDir)plugins\steamgriddb" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\plugins\Winnow.Plugin.SteamGridDb\plugin.json" DestinationFolder="$(PublishDir)plugins\steamgriddb" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Winnow.Diagnostics\Winnow.Diagnostics.csproj" />
    <ProjectReference Include="..\Winnow.Presentation\Winnow.Presentation.csproj" />
  </ItemGroup>
</Project>
