{
  "name": "winnow-electron",
  "productName": "Winnow Afterglow",
  "version": "0.1.0",
  "private": true,
  "description": "An extensible Electron frontend for Winnow",
  "author": "Winnow contributors",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview --skipBuild --",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts examples *.json *.ts README.md",
    "backend:publish": "node scripts/publish-backend.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "package": "npm run build && npm run backend:publish && npm run notices && electron-builder --dir",
    "dist": "npm run build && npm run backend:publish && npm run notices && electron-builder"
  },
  "build": {
    "appId": "app.winnow.afterglow",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".staging/backend",
        "to": "backend"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": ".staging/THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-virtual": "3.14.13",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
