<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hoard.Enrich.Updates</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Polly.Core" Version="8.7.0" />
    <PackageReference Include="Polly.RateLimiting" Version="8.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Data supplies the three tables this module touches: `update_events` (the
      signals it writes), `metadata_cache` (per-app poll state), and the
      ownership/play/external-id tables the eligibility query reads.

      Deliberately NO reference to Hoard.Enrich.Igdb or Hoard.Enrich.Steam:
      §5.1 keeps `Enrich.*` modules peers of one another. This one shares no
      credential, no host and no rate budget with either, and needs neither to
      function — both of its endpoints are keyless.
    -->
    <ProjectReference Include="..\Hoard.Data\Hoard.Data.csproj" />
  </ItemGroup>

</Project>
