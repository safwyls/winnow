<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Winnow.Enrich.SteamWeb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Polly.Core" Version="8.7.0" />
    <PackageReference Include="Polly.RateLimiting" Version="8.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Core supplies the domain vocabulary and the `CandidateOwnership` ingest
      contract this module emits (§5.1); Data supplies the `settings` and
      `metadata_cache` tables it is required to read and write (§4.2 caching,
      §6 data model). This module never writes works/releases — that stays
      Resolve's job — so the dependency is on the connection factory and the
      settings repository only, not on the entity repositories.
    -->
    <ProjectReference Include="..\Winnow.Core\Winnow.Core.csproj" />
    <ProjectReference Include="..\Winnow.Data\Winnow.Data.csproj" />
  </ItemGroup>

</Project>
