<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hoard.Ingest.Gog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Galaxy's client database is SQLite. Microsoft.Data.Sqlite is the same
      provider Hoard.Data uses, pinned to the same version so one SQLitePCLRaw
      native bundle is resolved for the whole app. No Dapper here: the ownership
      query is one hand-written statement whose exact shape is load-bearing
      (docs/spikes/epic-gog-local-files.md section 13), and it reads a store file,
      never Hoard's own database.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hoard.Core\Hoard.Core.csproj" />
  </ItemGroup>

</Project>
