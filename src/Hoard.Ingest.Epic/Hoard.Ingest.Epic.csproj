<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hoard.Ingest.Epic</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      No JSON package: Epic's local files are plain JSON and System.Text.Json is
      in the shared framework. Every reader here walks a JsonDocument by hand
      rather than binding to a POCO, because Epic's shapes are full of traps a
      binder would hide — `OwnershipToken` is the *string* "false", `InstallSize`
      is a number, and `MainGame*` are present-but-empty rather than absent
      (docs/spikes/epic-gog-local-files.md sections 2, 4, 9). The same rule holds
      for the API responses under Web/: there, absence is what carries meaning —
      an artifact missing from the playtime list means "Epic has no figure", and
      a binder would hand back zero (docs/spikes/epic-oauth.md).
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />

    <!--
      Everything below is for the OPT-IN authenticated half under Web/ only. The
      local readers still need nothing but the filesystem, and a machine that
      never configures Epic OAuth never constructs any of it.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Polly.Core" Version="8.7.0" />
    <PackageReference Include="Polly.RateLimiting" Version="8.7.0" />

    <!--
      DPAPI. Windows-only by nature, and the package is referenced
      unconditionally because the target framework is not Windows-specific;
      DpapiEpicSecretProtector guards every call with OperatingSystem.IsWindows()
      and the registration falls back to a protector that REFUSES to store rather
      than one that stores in the clear.
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Core only, deliberately. Core supplies the domain vocabulary, the
      `CandidateOwnership` ingest contract this module emits (§5.1), and the
      ISettingsRepository *interface* the OAuth half reads credentials and its
      encrypted session through. There is no Hoard.Data reference: the settings
      repository arrives as an OPTIONAL dependency resolved from the container,
      so this module never drags the data layer into an ingest project whose §5.1
      job is to read a source and emit candidates. A host without a settings
      table simply has no stored credentials and no persisted session.
    -->
    <ProjectReference Include="..\Hoard.Core\Hoard.Core.csproj" />
  </ItemGroup>

</Project>
