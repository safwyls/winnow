<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Winnow.Monitor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Hosting.Abstractions for the BackgroundService that drives the poll, DI and
      Options for composition, Logging for diagnostics. NOT Winnow.Data, NOT any
      Ingest module (§5.1): this module reads through the repository interfaces in
      Winnow.Core and writes sessions. The composition root hands it implementations.

      In particular there is no ValveKeyValue reference here and there must never
      be one. The executable map wants `installdir` cross-referenced with
      `libraryfolders.vdf`, plus the Epic and GOG install locations — but that
      cross-reference is exactly what SteamLibrarySource/EpicLibrarySource/
      GogLibrarySource already computed and what the resolver already stored in
      `ownerships.install_path`. Re-parsing the VDF here would produce a second
      answer that can disagree with the one the rest of the app displays.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Winnow.Core\Winnow.Core.csproj" />
  </ItemGroup>

</Project>
