<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hoard.Enrich.Steam</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Polly.Core" Version="8.7.0" />
    <PackageReference Include="Polly.RateLimiting" Version="8.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Data supplies the `metadata_cache` table (§6) this module reads and writes.
      Deliberately NO reference to Hoard.Enrich.Igdb: these are peer `Enrich.*`
      modules (§5.1), and this one exists precisely for the case where IGDB is
      unavailable — a dependency pointing at the credentialed module would defeat
      the point. Enrich never writes works/releases, so the dependency is on the
      connection factory only.
    -->
    <ProjectReference Include="..\Hoard.Data\Hoard.Data.csproj" />
  </ItemGroup>

</Project>
