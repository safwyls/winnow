<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hoard.Covers</RootNamespace>
    <!-- Row-wise pixel copy from SkiaSharp into an Avalonia WriteableBitmap. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia.Base only (WriteableBitmap); no Desktop/Themes — this is a library.
         SkiaSharp is pinned to the exact version Avalonia 11.3.20 resolves so the
         native assets do not fork. -->
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

</Project>
